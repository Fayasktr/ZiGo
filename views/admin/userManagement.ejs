<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/admin/head') %>
    <title>ZiGo Admin | User Management</title>
</head>

<body>
    <!-- Sidebar -->
    <%- include('../partials/admin/sidebar', { activeTab: 'users' }) %>

    <main class="admin-main">
        <%- include('../partials/admin/pageHeader', { title: 'User', accentTitle: 'Database', subtitle: 'CRM' }) %>

        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">
            <div class="search-row !mb-0 w-full md:w-auto">
                <div class="search-wrapper">
                    <input type="text" id="userSearch" value="<%= search %>" placeholder="Search customers..." class="search-input">
                    <i class="fas fa-search search-icon"></i>
                </div>
                <div class="flex gap-2">
                    <button id="searchBtn" class="btn-search-panel btn-search-submit">SEARCH</button>
                    <button id="clearSearch" class="btn-search-panel btn-search-clear">CLEAR</button>
                </div>
            </div>
            <div class="text-right hidden md:block">
                <p class="text-3xl font-black text-orange-500"><%= totalCount %></p>
                <p class="text-[10px] opacity-40 font-bold uppercase tracking-widest">Total Customers</p>
            </div>
        </div>

        <div class="bg-white/5 border border-white/5 rounded-[2rem] p-4 sm:p-8">
            <div class="data-table-wrapper">
                <table class="w-full border-collapse">
                    <thead>
                        <tr class="text-left font-bold text-[10px] uppercase tracking-widest opacity-30 border-b border-white/5">
                            <th class="p-4">Customer</th>
                            <th class="p-4">Email</th>
                            <th class="p-4">Join Date</th>
                            <th class="p-4">Status</th>
                            <th class="p-4 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-white/5">
                        <% if (users && users.length > 0) { %>
                            <% users.forEach(user => { %>
                                <tr class="hover:bg-white/[0.02] transition-colors">
                                    <td class="p-4">
                                        <div class="flex items-center gap-4">
                                            <div class="w-10 h-10 rounded-xl bg-orange-500/10 flex items-center justify-center font-black text-orange-500">
                                                <%= user.userName.substring(0, 2).toUpperCase() %>
                                            </div>
                                            <div>
                                                <p class="font-bold text-white/90 text-sm"><%= user.userName %></p>
                                                <p class="text-[10px] opacity-30"><%= user.phoneNumber || 'No Phone' %></p>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="p-4"><span class="text-xs lg:text-sm text-white/60"><%= user.email %></span></td>
                                    <td class="p-4 text-xs lg:text-sm text-white/40"><%= new Date(user.createdAt).toLocaleDateString() %></td>
                                    <td class="p-4">
                                        <span class="px-3 py-1 rounded-full text-[9px] font-black uppercase tracking-widest <%= user.isBlocked ? 'bg-red-500/10 text-red-500' : 'bg-emerald-500/10 text-emerald-500' %>">
                                            <%= user.isBlocked ? 'Blocked' : 'Active' %>
                                        </span>
                                    </td>
                                    <td class="p-4 text-right">
                                        <% if (!user.isBlocked) { %>
                                            <button onclick="toggleUserStatus('<%= user._id %>', true)" class="text-[9px] font-black uppercase tracking-widest bg-red-500/10 text-red-500 hover:bg-red-500 hover:text-white px-4 py-2 rounded-lg transition-all">Block</button>
                                        <% } else { %>
                                            <button onclick="toggleUserStatus('<%= user._id %>', false)" class="text-[9px] font-black uppercase tracking-widest bg-emerald-500/10 text-emerald-500 hover:bg-emerald-500 hover:text-white px-4 py-2 rounded-lg transition-all">Unblock</button>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="p-20 text-center text-white/20 font-bold italic">No customers found.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <%- include('../partials/admin/pagination.ejs') %>
        </div>
    </main>

    <script>
        const userSearch = document.getElementById('userSearch');
        const searchBtn = document.getElementById('searchBtn');
        const clearBtn = document.getElementById('clearSearch');

        function triggerSearch() {
            const query = userSearch.value.trim();
            window.location.href = `/admin/users?page=1&search=${query}`;
        }

        if (searchBtn) searchBtn.addEventListener('click', triggerSearch);
        if (userSearch) userSearch.addEventListener('keypress', (e) => { if (e.key === 'Enter') triggerSearch(); });

        if (clearBtn) clearBtn.addEventListener('click', () => {
            const url = new URL(window.location.href);
            url.searchParams.delete("search");
            url.searchParams.set("page", "1");
            window.location.href = url.toString();
        });

        async function toggleUserStatus(userId, block) {
            const action = block ? 'block' : 'unblock';
            try {
                const response = await fetch(`/admin/users/${userId}/${action}`, { method: 'PATCH' });
                if (response.ok) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: `User ${action}ed successfully`,
                        toast: true,
                        position: 'top-end',
                        showConfirmButton: false,
                        timer: 2000
                    }).then(() => window.location.reload());
                } else {
                    const result = await response.json();
                    Swal.fire('Error', result.message || `Failed to ${action} user`, 'error');
                }
            } catch (error) {
                console.error('Error:', error);
                Swal.fire('Error', 'An error occurred', 'error');
            }
        }
    </script>
    <%- include('../partials/flashAlert') %>
</body>
</html>