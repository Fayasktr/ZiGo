<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ZiGo Admin | Command Center</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="icon" type="image/png" href="/public/public/favicon.png">
    <style>
        :root {
            --primary-orange: #FF5A1F;
            --primary-orange-hover: #E44D18;
            --deep-black: #0F0F0F;
            --dark-navy: #1E293B;
            --off-white: #F9F9F9;
            --gray-light: #E2E8F0;
            --white: #FFFFFF;
            --glass: rgba(255, 255, 255, 0.03);
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }

        body {
            background-color: var(--deep-black);
            color: var(--white);
            overflow-x: hidden;
            display: flex;
            min-height: 100vh;
        }

        /* --- Admin Sidebar --- */
        .admin-sidebar {
            width: 280px;
            background: rgba(255, 255, 255, 0.02);
            backdrop-filter: blur(20px);
            border-right: 1px solid rgba(255, 255, 255, 0.05);
            height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            padding: 2rem;
            display: flex;
            flex-direction: column;
            z-index: 1000;
            overflow-y: auto;
        }

        .admin-sidebar::-webkit-scrollbar {
            width: 4px;
        }

        .admin-sidebar::-webkit-scrollbar-thumb {
            background: rgba(255, 90, 31, 0.2);
            border-radius: 10px;
        }

        .admin-logo {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 3rem;
            text-decoration: none;
        }

        .admin-logo img {
            height: 48px;
        }

        .admin-nav {
            flex: 1;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1rem 1.5rem;
            border-radius: 16px;
            color: rgba(255, 255, 255, 0.5);
            text-decoration: none;
            font-weight: 600;
            transition: var(--transition);
            margin-bottom: 0.5rem;
        }

        .nav-item i {
            font-size: 1.1rem;
        }

        .nav-item:hover,
        .nav-item.active {
            background: rgba(255, 90, 31, 0.1);
            color: var(--primary-orange);
        }

        .nav-item.active {
            box-shadow: 0 4px 15px rgba(255, 90, 31, 0.1);
        }

        .logout-btn {
            margin-top: auto;
            color: #FF4757;
            background: rgba(255, 71, 87, 0.05);
        }

        .logout-btn:hover {
            background: #FF4757;
            color: white;
        }

        select {
            cursor: pointer;
            font-family: 'Inter', sans-serif;
        }

        select option {
            background: #FFFFFF;
            color: #000000;
        }

        /* --- Main Content --- */
        .admin-main {
            flex: 1;
            margin-left: 280px;
            padding: 2.5rem 3.5rem;
        }

        .admin-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 3rem;
        }

        .header-title h1 {
            font-size: 2rem;
            font-weight: 800;
            letter-spacing: -1px;
        }

        /* --- Stats Grid --- */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1.5rem;
            margin-bottom: 3rem;
        }

        .stat-card {
            background: var(--glass);
            border: 1px solid rgba(255, 255, 255, 0.05);
            padding: 1.5rem;
            border-radius: 24px;
            transition: var(--transition);
        }

        .stat-card:hover {
            background: rgba(255, 255, 255, 0.05);
            transform: translateY(-5px);
            border-color: rgba(255, 90, 31, 0.3);
        }

        .stat-icon {
            width: 44px;
            height: 44px;
            background: rgba(255, 90, 31, 0.1);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--primary-orange);
            margin-bottom: 1rem;
        }

        .stat-value {
            font-size: 1.75rem;
            font-weight: 800;
            margin-bottom: 0.25rem;
        }

        .stat-label {
            font-size: 0.8rem;
            font-weight: 600;
            opacity: 0.4;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        /* --- Charts Area --- */
        .charts-section {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 1.5rem;
            margin-bottom: 3rem;
        }

        .chart-container {
            background: var(--glass);
            border: 1px solid rgba(255, 255, 255, 0.05);
            padding: 2rem;
            border-radius: 32px;
        }

        /* --- Recent List --- */
        .recent-orders {
            background: var(--glass);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 32px;
            padding: 2rem;
        }

        .data-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 1.5rem;
        }

        .data-table th {
            text-align: left;
            padding: 1rem;
            font-size: 0.75rem;
            text-transform: uppercase;
            opacity: 0.4;
            letter-spacing: 1px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .data-table td {
            padding: 1.25rem 1rem;
            font-size: 0.9rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.03);
        }

        .status-pill {
            padding: 4px 12px;
            border-radius: 100px;
            font-size: 0.75rem;
            font-weight: 700;
        }

        .status-pending {
            background: rgba(255, 159, 67, 0.1);
            color: #FF9F43;
        }

        .status-delivered {
            background: rgba(46, 213, 115, 0.1);
            color: #2ED573;
        }

        @media (max-width: 1280px) {
            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .charts-section {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>
    <!-- Sidebar -->
    <aside class="admin-sidebar">
        <a href="#" class="admin-logo">
            <img src="/public/public/logo-icon.png" alt="ZiGo">
            <img src="/public/public/logo-name.png" alt="ZiGo" style="height: 24px;">
        </a>

        <nav class="admin-nav">
            <a href="/admin/dashboard" class="nav-item active">
                <i class="fas fa-chart-line"></i> Dashboard
            </a>
            <a href="/admin/products" class="nav-item">
                <i class="fas fa-box"></i> Products
            </a>
            <a href="/admin/orders" class="nav-item">
                <i class="fas fa-shopping-cart"></i> Orders
            </a>
            <a href="/admin/users" class="nav-item">
                <i class="fas fa-users"></i> Users
            </a>
            <a href="/admin/category" class="nav-item">
                <i class="fas fa-tags"></i> Categories
            </a>
            <a href="/admin/coupons" class="nav-item">
                <i class="fas fa-ticket-alt"></i> Coupons
            </a>
            <a href="/admin/banners" class="nav-item">
                <i class="fas fa-image"></i> Banners
            </a>
            <a href="/admin/offers" class="nav-item">
                <i class="fas fa-percent"></i> Offers
            </a>
            <a href="/admin/reports" class="nav-item">
                <i class="fas fa-file-invoice-dollar"></i> Sales Report
            </a>
        </nav>

        <a href="/admin/logout" class="nav-item logout-btn">
            <i class="fas fa-sign-out-alt"></i> Sign Out
        </a>
    </aside>

    <!-- Main Content -->
    <main class="admin-main">
        <header class="admin-header">
            <div class="header-title">
                <p class="text-orange-500 font-bold uppercase tracking-[4px] text-xs mb-1">Overview</p>
                <h1>Command <span class="text-orange-500">Center</span></h1>
            </div>

            <div class="flex items-center gap-6">
                <div class="text-right hidden md:block">
                    <p class="font-bold text-sm">Fayas Admin</p>
                    <p class="text-xs opacity-40">System Architect</p>
                </div>
                <div
                    class="w-12 h-12 rounded-2xl bg-orange-500 flex items-center justify-center text-white font-black text-xl">
                    F
                </div>
            </div>
        </header>

        <!-- Stats Grid -->
        <section class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-wallet"></i></div>
                <p class="stat-value" id="totalRevenue">₹0</p>
                <p class="stat-label">Total Revenue</p>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-shopping-bag"></i></div>
                <p class="stat-value" id="totalOrders">0</p>
                <p class="stat-label">Total Orders</p>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-users"></i></div>
                <p class="stat-value" id="activeUsers">0</p>
                <p class="stat-label">Active Users</p>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-chart-line"></i></div>
                <p class="stat-value" id="avgOrderValue">₹0</p>
                <p class="stat-label">Avg. Order Value</p>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-box"></i></div>
                <p class="stat-value" id="totalProducts">0</p>
                <p class="stat-label">Total Products</p>
            </div>
        </section>

        <!-- Charts Section -->
        <section class="charts-section">
            <div class="chart-container">
                <h3 class="font-bold mb-6 flex justify-between items-center">
                    Revenue Trends
                    <div class="flex items-center gap-3">
                        <div class="flex items-center gap-2 bg-white/5 px-3 py-1 rounded-xl border border-white/5">
                            <input type="date" id="startDate" class="bg-transparent text-[10px] outline-none text-white/60 focus:text-orange-500 transition-all">
                            <span class="text-[10px] opacity-20">to</span>
                            <input type="date" id="endDate" class="bg-transparent text-[10px] outline-none text-white/60 focus:text-orange-500 transition-all">
                            <button onclick="applyCustomFilter()" class="ml-2 text-[10px] font-bold text-orange-500 hover:text-white transition-all"><i class="fas fa-check"></i></button>
                        </div>
                        <div class="flex gap-2">
                            <button onclick="updateDashboard('1d', event)" class="filter-btn text-[10px] px-3 py-1 rounded-lg border border-white/5 hover:bg-white/5 transition-all">1D</button>
                            <button onclick="updateDashboard('7d', event)" class="filter-btn text-[10px] px-3 py-1 rounded-lg border border-white/5 hover:bg-white/5 transition-all active-filter">7D</button>
                            <button onclick="updateDashboard('30d', event)" class="filter-btn text-[10px] px-3 py-1 rounded-lg border border-white/5 hover:bg-white/5 transition-all">30D</button>
                            <button onclick="updateDashboard('1y', event)" class="filter-btn text-[10px] px-3 py-1 rounded-lg border border-white/5 hover:bg-white/5 transition-all">1Y</button>
                        </div>
                    </div>
                </h3>
                <canvas id="revenueChart" height="150"></canvas>
            </div>
            <div class="chart-container">
                <h3 class="font-bold mb-6">Top Selling Categories</h3>
                <canvas id="categoryChart"></canvas>
            </div>
        </section>

        <!-- Top Products Section -->
        <section class="mb-12">
            <h3 class="font-bold mb-6">Top Selling <span class="text-orange-500">Products</span></h3>
            <div class="grid grid-cols-1 md:grid-cols-5 gap-4" id="topProductsContainer">
                <!-- Dynamic Content -->
            </div>
        </section>

        <!-- Recent Orders -->
        <section class="recent-orders">
            <h3 class="font-bold mb-2">Recent Orders</h3>
            <p class="text-xs opacity-40 mb-6">Latest customer transactions from all regions</p>

            <table class="data-table">
                <thead>
                    <tr>
                        <th>Order ID</th>
                        <th>Customer</th>
                        <th>Product</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody id="recentOrdersTable">
                    <!-- Dynamic Content -->
                </tbody>
            </table>
        </section>
    </main>

    <script>
        let revenueChartInstance = null;
        let categoryChartInstance = null;

        function fetchDashboardData(filter = '7d', startDate = '', endDate = '') {
            let url = `/admin/api/dashboardData?filter=${filter}`;
            if (startDate) url += `&startDate=${startDate}`;
            if (endDate) url += `&endDate=${endDate}`;

            fetch(url)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        updateMetrics(data.summary || {});
                        updateRevenueChart(data.revenueTrend || { labels: [], data: [] });
                        updateCategoryChart(data.categoryDistribution || { labels: [], data: [] });
                        updateRecentOrders(data.recentOrders || []);
                        updateTopProducts(data.topProducts || []);
                    }
                })
                .catch(error => console.error('Dashboard Fetch Error:', error));
        }

        function updateMetrics(summary = {}) {
            document.getElementById('totalRevenue').innerText = `₹${(summary.totalRevenue || 0).toLocaleString()}`;
            document.getElementById('totalOrders').innerText = (summary.totalOrders || 0).toLocaleString();
            document.getElementById('activeUsers').innerText = (summary.activeUsers || 0).toLocaleString();
            document.getElementById('avgOrderValue').innerText = `₹${(summary.avgOrderValue || 0).toLocaleString()}`;
            document.getElementById('totalProducts').innerText = (summary.totalProducts || 0).toLocaleString();
        }

        function updateRevenueChart(trend) {
            const ctx = document.getElementById('revenueChart').getContext('2d');
            
            if (revenueChartInstance) {
                revenueChartInstance.destroy();
            }

            revenueChartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: trend.labels,
                    datasets: [{
                        label: 'Revenue',
                        data: trend.data,
                        borderColor: '#FF5A1F',
                        backgroundColor: 'rgba(255, 90, 31, 0.1)',
                        borderWidth: 4,
                        tension: 0.4,
                        fill: true,
                        pointRadius: 4,
                        pointBackgroundColor: '#FF5A1F',
                        pointBorderColor: '#0F0F0F',
                        pointBorderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { grid: { display: false }, ticks: { color: 'rgba(255,255,255,0.4)', font: { size: 10 } } },
                        y: { 
                            grid: { color: 'rgba(255,255,255,0.05)' }, 
                            ticks: { 
                                color: 'rgba(255,255,255,0.4)', 
                                font: { size: 10 },
                                callback: (value) => '₹' + value.toLocaleString()
                            } 
                        }
                    }
                }
            });
        }

        function updateCategoryChart(distribution) {
            const ctx = document.getElementById('categoryChart').getContext('2d');
            
            if (categoryChartInstance) {
                categoryChartInstance.destroy();
            }

            categoryChartInstance = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: distribution.labels,
                    datasets: [{
                        data: distribution.data,
                        backgroundColor: ['#FF5A1F', '#3B82F6', '#10B981', '#F59E0B', '#6366F1'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    plugins: { 
                        legend: { 
                            position: 'bottom', 
                            labels: { 
                                color: 'rgba(255,255,255,0.6)', 
                                boxWidth: 12, 
                                padding: 20,
                                font: { size: 11 }
                            } 
                        } 
                    },
                    cutout: '70%'
                }
            });
        }

        function updateRecentOrders(orders) {
            const tbody = document.getElementById('recentOrdersTable');
            tbody.innerHTML = orders.map(order => `
                <tr>
                    <td class="font-bold">#${order.orderId}</td>
                    <td>
                        <p class="font-bold">${order.shippingAddress?.fullName || order.customerName}</p>
                        <p class="text-[10px] opacity-40">${order.customerEmail}</p>
                        <p class="text-[10px] opacity-40">${order.shippingAddress?.phone || ''}</p>
                    </td>
                    <td>${order.productName}</td>
                    <td class="font-black">₹${order.totalAmount.toLocaleString()}</td>
                    <td><span class="status-pill status-${order.status.toLowerCase()}">${order.status}</span></td>
                    <td><a href="/admin/orderDetails/${order.orderId}" class="text-xs font-bold text-orange-500">Manage</a></td>
                </tr>
            `).join('');
        }

        function updateTopProducts(products) {
            const container = document.getElementById('topProductsContainer');
            container.innerHTML = products.map(product => `
                <div class="bg-white/5 border border-white/5 p-4 rounded-3xl hover:border-orange-500/30 transition-all group">
                    <p class="text-[10px] uppercase tracking-wider opacity-40 mb-2">Top Performer</p>
                    <h4 class="font-bold text-sm mb-1 truncate">${product.name}</h4>
                    <p class="text-xs text-orange-500 font-bold mb-4">${product.salesCount} Sales</p>
                    <div class="pt-3 border-t border-white/5 flex justify-between items-center">
                        <span class="text-[10px] opacity-40">Total Revenue</span>
                        <span class="text-xs font-black">₹${product.revenue.toLocaleString()}</span>
                    </div>
                </div>
            `).join('');
        }

        function updateDashboard(filter, event) {
            // Clear custom dates when predefined filters are used
            document.getElementById('startDate').value = '';
            document.getElementById('endDate').value = '';

            // Update filter button UI
            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.classList.remove('active-filter', 'bg-white/10', 'text-orange-500');
            });
            if (event && event.target) {
                event.target.classList.add('active-filter', 'bg-white/10', 'text-orange-500');
            }
            
            fetchDashboardData(filter);
        }

        function applyCustomFilter() {
            const startDate = document.getElementById('startDate').value;
            const endDate = document.getElementById('endDate').value;

            if (!startDate) {
                alert('Please select a starting date');
                return;
            }

            // Remove active classes from predefined buttons
            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.classList.remove('active-filter', 'bg-white/10', 'text-orange-500');
            });

            fetchDashboardData('custom', startDate, endDate);
        }

        // Styles for active filter
        const style = document.createElement('style');
        style.innerHTML = '.active-filter { border-color: rgba(255, 90, 31, 0.5) !important; background: rgba(255, 90, 31, 0.1) !important; color: #FF5A1F !important; }';
        document.head.appendChild(style);

        // Initial Load
        document.addEventListener('DOMContentLoaded', () => {
            fetchDashboardData('7d');
        });
    </script>
    <%- include('../partials/flashAlert') %>
</body>

</html>