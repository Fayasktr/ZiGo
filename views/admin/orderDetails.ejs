<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/admin/head') %>
    <title>ZiGo Admin | Edit Order #<%= order.orderNumber %></title>
</head>

<body>
    <!-- Sidebar -->
    <%- include('../partials/admin/sidebar', { activeTab: 'orders' }) %>

    <main class="admin-main">
        <header class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-10">
            <div>
                <a href="/admin/orders" class="inline-flex items-center gap-2 text-[10px] font-black uppercase tracking-widest text-white/20 hover:text-orange-500 transition-all mb-3">
                    <i class="fas fa-arrow-left"></i> Back to Fleet
                </a>
                <p class="text-orange-500 font-bold uppercase tracking-[4px] text-[10px] sm:text-xs mb-1">Logistics</p>
                <h1 class="text-xl sm:text-2xl md:text-3xl font-extrabold tracking-tight text-white/90">
                    Edit Order <span class="text-orange-500">#<%= order.orderNumber %></span>
                </h1>
            </div>
            
            <div class="bg-white/5 border border-white/5 px-6 py-3 rounded-2xl flex flex-col items-end">
                <p class="text-[9px] opacity-20 font-black uppercase tracking-widest mb-1">Global Status</p>
                <% 
                   const st = order.orderStatus.toLowerCase();
                   const stCls = st === 'delivered' ? 'text-emerald-500' : (st === 'cancelled' ? 'text-red-500' : 'text-orange-500');
                %>
                <span class="text-xs font-black uppercase tracking-widest <%= stCls %>">
                    <%= order.orderStatus %>
                </span>
            </div>
        </header>

        <div class="grid grid-cols-1 xl:grid-cols-3 gap-8">
            <div class="xl:col-span-2 space-y-8">
                <!-- Order Items -->
                <div class="bg-white/5 border border-white/5 rounded-[2.5rem] p-6 sm:p-8">
                    <h2 class="text-xl font-black mb-8 flex items-center gap-3 italic">
                        <i class="fas fa-box-open text-orange-500"></i> Manifest
                    </h2>
                    
                    <div class="space-y-6">
                        <% order.items.forEach(item => { %>
                            <div class="group relative bg-white/[0.02] border border-white/5 rounded-3xl p-6 hover:border-orange-500/20 transition-all">
                                <div class="flex flex-col sm:flex-row gap-6">
                                    <div class="w-24 h-24 bg-black rounded-2xl flex items-center justify-center p-3 border border-white/5">
                                        <img src="<%= item.image || '/public/landing/no-image.png' %>" alt="" class="max-w-full max-h-full object-contain">
                                    </div>
                                    
                                    <div class="flex-1">
                                        <div class="flex justify-between items-start mb-2">
                                            <h3 class="font-bold text-white/90 underline decoration-orange-500/30 decoration-2 underline-offset-4"><%= item.productName %></h3>
                                            <p class="font-black text-lg text-orange-500">₹<%= (item.finalPrice || item.price).toLocaleString() %></p>
                                        </div>
                                        
                                        <div class="flex flex-wrap gap-2 mb-4">
                                            <% if (item.variantAttributes) { 
                                                const attrs = (item.variantAttributes instanceof Map) ? Object.fromEntries(item.variantAttributes) : item.variantAttributes;
                                                Object.entries(attrs).forEach(([key, value]) => { %>
                                                    <span class="bg-white/5 px-2 py-1 rounded-lg text-[9px] font-black uppercase tracking-widest text-white/30 border border-white/5">
                                                        <%= key %>: <span class="text-white/60"><%= value %></span>
                                                    </span>
                                            <% }) } %>
                                        </div>

                                        <div class="flex flex-wrap items-center gap-4">
                                            <% 
                                               const its = item.itemStatus.toLowerCase();
                                               const itsCls = its === 'delivered' ? 'bg-emerald-500/10 text-emerald-500' : (its === 'cancelled' ? 'bg-red-500/10 text-red-500' : 'bg-blue-500/10 text-blue-500');
                                            %>
                                            <span class="px-3 py-1 rounded-full text-[9px] font-black uppercase tracking-widest <%= itsCls %> border border-white/5">
                                                <%= item.itemStatus %>
                                            </span>
                                            <span class="text-[10px] font-bold opacity-20">QTY: <%= item.quantity %></span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Handle Return Requests -->
                                <% if (item.returnStatus === 'requested') { %>
                                    <div class="mt-6 pt-6 border-t border-white/5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                                        <div class="bg-orange-500/5 p-4 rounded-2xl border border-orange-500/10 flex-1">
                                            <p class="text-[9px] font-black text-orange-500 uppercase tracking-widest mb-1">Return Requested (<%= item.pendingReturnQuantity %> Units)</p>
                                            <p class="text-[11px] italic text-white/40">"<%= item.returnReason %>"</p>
                                        </div>
                                        <div class="flex gap-2">
                                            <button onclick="handleReturn('<%= order._id %>', '<%= item._id %>', 'approved')" class="px-6 py-3 bg-emerald-500 hover:bg-emerald-600 text-white rounded-xl font-bold text-[10px] uppercase tracking-widest transition-all">APPROVE</button>
                                            <button onclick="handleReturn('<%= order._id %>', '<%= item._id %>', 'rejected')" class="px-6 py-3 bg-red-500/10 hover:bg-red-500 text-red-500 hover:text-white rounded-xl font-bold text-[10px] uppercase tracking-widest transition-all">REJECT</button>
                                        </div>
                                    </div>
                                <% } %>
                            </div>
                        <% }) %>
                    </div>
                </div>

                <!-- Shipping -->
                <div class="bg-white/5 border border-white/5 rounded-[2.5rem] p-6 sm:p-8">
                    <h2 class="text-xl font-black mb-8 flex items-center gap-3 italic">
                        <i class="fas fa-truck-loading text-orange-500"></i> Consignee
                    </h2>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                        <div class="flex flex-col gap-1">
                            <span class="text-[9px] font-black uppercase tracking-widest opacity-20">Full Name</span>
                            <span class="font-bold text-white/80"><%= order.shippingAddress.fullName %></span>
                        </div>
                        <div class="flex flex-col gap-1">
                            <span class="text-[9px] font-black uppercase tracking-widest opacity-20">Identifier</span>
                            <span class="font-bold text-white/80"><%= order.userId ? order.userId.email : 'Guest Session' %></span>
                        </div>
                        <div class="flex flex-col gap-1 sm:col-span-2">
                            <span class="text-[9px] font-black uppercase tracking-widest opacity-20">Destination Path</span>
                            <span class="font-medium text-white/60 leading-relaxed">
                                <%= `${order.shippingAddress.addressLine}, ${order.shippingAddress.city}, ${order.shippingAddress.state} - ${order.shippingAddress.pincode}` %>
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Sidebar Panel -->
            <div class="space-y-8">
                <!-- Status Management -->
                <div class="bg-white/5 border border-white/5 rounded-[2.5rem] p-8 shadow-2xl">
                    <h2 class="text-lg font-black mb-6 uppercase tracking-widest text-white/30">Lifecycle</h2>
                    <div class="space-y-6">
                        <div>
                            <label class="text-[9px] font-black uppercase tracking-widest opacity-20 mb-3 block">Update System State</label>
                            <select id="orderStatus" class="w-full bg-white/5 border border-white/10 p-4 rounded-xl text-xs font-bold text-white outline-none focus:border-orange-500 transition-all cursor-pointer">
                                <% 
                                   const allowed = {
                                       "pending": ["pending", "processing", "shipped", "delivered", "cancelled"],
                                       "processing": ["processing", "shipped", "delivered", "cancelled"],
                                       "shipped": ["shipped", "delivered", "cancelled"],
                                       "cancelled": ["cancelled"],
                                       "delivered": ["delivered", "returned"],
                                       "returned": ["returned"]
                                   };
                                   const currentStatus = order.orderStatus.toLowerCase();
                                   const opts = allowed[currentStatus] || [currentStatus];
                                   opts.forEach(st => {
                                %>
                                    <option value="<%= st %>" <%= currentStatus === st ? 'selected' : '' %>><%= st.toUpperCase() %></option>
                                <% }) %>
                            </select>
                        </div>
                        <button onclick="updateOrder()" class="w-full bg-orange-500 hover:bg-orange-600 text-white py-4 rounded-2xl font-black text-[10px] uppercase tracking-[4px] transition-all shadow-xl shadow-orange-500/10">
                            Push Update
                        </button>
                    </div>
                </div>

                <!-- Financial Summary -->
                <div class="bg-white/5 border border-white/5 rounded-[2.5rem] p-8">
                    <h2 class="text-lg font-black mb-8 uppercase tracking-widest text-white/30">Finance</h2>
                    <div class="space-y-4">
                        <div class="flex justify-between text-xs font-bold text-white/40">
                            <span>Gross Value</span>
                            <span>₹<%= (order.pricing.total + (order.pricing.discound || 0)).toLocaleString() %></span>
                        </div>
                        <div class="flex justify-between text-xs font-bold text-white/40">
                            <span>Taxation (GST)</span>
                            <span>₹<%= order.pricing.tax.toLocaleString() %></span>
                        </div>
                        <% if (order.pricing.discound > 0) { %>
                            <div class="flex justify-between text-xs font-bold text-red-500/60">
                                <span>Promo Credit</span>
                                <span>- ₹<%= order.pricing.discound.toLocaleString() %></span>
                            </div>
                        <% } %>
                        <div class="pt-4 border-t border-white/5 flex justify-between items-end">
                            <span class="text-[10px] font-black uppercase tracking-[2px] opacity-20">Net Total</span>
                            <span class="text-2xl font-black text-orange-500">₹<%= order.pricing.total.toLocaleString() %></span>
                        </div>
                    </div>

                    <div class="mt-10 space-y-3">
                        <div class="bg-white/5 p-4 rounded-2xl border border-white/5">
                            <p class="text-[8px] font-black uppercase tracking-widest opacity-20 mb-2">Payment Gateway</p>
                            <div class="flex items-center gap-3">
                                <i class="fas fa-credit-card text-orange-500/50"></i>
                                <span class="text-xs font-black"><%= order.paymentMethod %></span>
                            </div>
                        </div>
                        <div class="bg-white/5 p-4 rounded-2xl border border-white/5">
                            <p class="text-[8px] font-black uppercase tracking-widest opacity-20 mb-2">Accounting State</p>
                            <% 
                               const paySt = order.paymentStatus.toLowerCase();
                               const payCls = paySt === 'paid' ? 'text-emerald-500' : 'text-red-500';
                            %>
                            <div class="flex items-center gap-3">
                                <i class="fas fa-shield-check <%= payCls %> opacity-50"></i>
                                <span class="text-xs font-black <%= payCls %> uppercase tracking-widest"><%= order.paymentStatus %></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script>
        async function updateOrder() {
            const status = document.getElementById('orderStatus').value;
            try {
                const response = await fetch(`/admin/orderDetails/<%= order._id %>/update`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ status })
                });
                const result = await response.json();
                if (result.success) {
                    Swal.fire({ icon: 'success', title: 'System Updated', toast: true, position: 'top-end', showConfirmButton: false, timer: 2000 }).then(() => window.location.reload());
                } else {
                    Swal.fire('Error', result.message, 'error');
                }
            } catch (error) { Swal.fire('Error', 'Connection failed', 'error'); }
        }

        async function handleReturn(orderId, itemId, action) {
            const { isConfirmed } = await Swal.fire({
                title: `${action.toUpperCase()} Protocol?`,
                icon: 'warning',
                background: '#121212',
                color: '#fff',
                showCancelButton: true,
                confirmButtonColor: action === 'approved' ? '#3395FF' : '#FF4757',
                confirmButtonText: `Proceed with ${action}`
            });
            if (!isConfirmed) return;

            try {
                const res = await fetch(`/admin/orders/${orderId}/item/${itemId}/return`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ action })
                });
                const result = await res.json();
                if (result.success) {
                    Swal.fire({ icon: 'success', title: `Return ${action}`, toast: true, position: 'top-end', timer: 2000, showConfirmButton: false }).then(() => window.location.reload());
                } else { Swal.fire('Error', result.message, 'error'); }
            } catch (err) { Swal.fire('Error', 'Network interrupt', 'error'); }
        }
    </script>
    <%- include('../partials/flashAlert') %>
</body>
</html>