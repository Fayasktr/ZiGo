<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/admin/head') %>
    <title>ZiGo Admin | Reset Password</title>
    <style>
        .reset-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(25px);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 2.5rem;
            padding: 2.5rem;
            width: 100%;
            max-width: 450px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        }

        @media (min-width: 640px) {
            .reset-card {
                padding: 3.5rem;
            }
        }

        .glow {
            position: absolute;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(255, 90, 31, 0.08) 0%, transparent 70%);
            z-index: -1;
            filter: blur(40px);
        }

        .form-input {
            width: 100%;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 1.25rem;
            padding: 1.25rem 1.5rem 1.25rem 3.5rem;
            color: white;
            font-weight: 500;
            transition: all 0.3s ease;
            outline: none;
        }

        .form-input:focus {
            background: rgba(255, 255, 255, 0.05);
            border-color: #FF5A1F;
        }

        .input-group i {
            transition: all 0.3s ease;
        }

        .form-input:focus + i {
            color: #FF5A1F;
        }

        .strength-meter {
            height: 3px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 2px;
            overflow: hidden;
            margin-top: -0.5rem;
        }

        .strength-bar {
            height: 100%;
            width: 0%;
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        }
    </style>
</head>

<body class="bg-[#0F0F0F] min-h-screen flex items-center justify-center p-6 relative overflow-hidden">
    <div class="glow -top-48 -left-48"></div>
    <div class="glow -bottom-48 -right-48"></div>

    <div class="reset-card animate-in fade-in slide-in-from-bottom-5 duration-700">
        <div class="w-16 h-16 bg-orange-500/10 text-orange-500 rounded-2xl flex items-center justify-center text-xl mx-auto mb-8 shadow-inner">
            <i class="fas fa-key"></i>
        </div>

        <div class="text-center mb-10">
            <h1 class="text-3xl font-black tracking-tight text-white/90">
                New <span class="text-orange-500 italic">Security</span>
            </h1>
            <p class="text-[10px] font-black uppercase tracking-[3px] text-white/20 mt-3">Reset Personnel Credentials</p>
        </div>

        <form action="/admin/reset-password" method="POST" class="space-y-6">
            <div class="space-y-4">
                <div class="input-group relative">
                    <input type="password" name="newPassword" id="password" class="form-input" placeholder="New Password" required>
                    <i class="fas fa-lock absolute left-6 top-1/2 -translate-y-1/2 text-white/20"></i>
                </div>
                <div class="strength-meter">
                    <div id="strengthBar" class="strength-bar"></div>
                </div>
            </div>

            <div class="input-group relative">
                <input type="password" name="confirmPassword" class="form-input" placeholder="Confirm Password" required>
                <i class="fas fa-check-circle absolute left-6 top-1/2 -translate-y-1/2 text-white/20"></i>
            </div>

            <button type="submit" class="w-full bg-orange-500 hover:bg-orange-600 text-white py-5 rounded-2xl font-black text-xs uppercase tracking-[4px] transition-all shadow-xl shadow-orange-500/20 active:scale-[0.98] mt-4">
                Update Security <i class="fas fa-save ml-2 text-[10px]"></i>
            </button>
        </form>

        <div class="mt-8 pt-8 border-t border-white/5 text-center">
            <p class="text-[9px] font-bold text-white/20 uppercase tracking-[3px] flex items-center justify-center gap-2">
                <i class="fas fa-info-circle text-orange-500/50"></i> Entropy: Min 8 Chars
            </p>
        </div>
    </div>

    <script>
        const password = document.getElementById('password');
        const strengthBar = document.getElementById('strengthBar');

        password.addEventListener('input', () => {
            const val = password.value;
            let strength = 0;
            if (val.length > 5) strength += 20;
            if (val.length >= 8) strength += 20;
            if (/[A-Z]/.test(val)) strength += 20;
            if (/[0-9]/.test(val)) strength += 20;
            if (/[^A-Za-z0-9]/.test(val)) strength += 20;

            strengthBar.style.width = strength + '%';

            if (strength < 40) strengthBar.style.backgroundColor = '#FF4757';
            else if (strength < 80) strengthBar.style.backgroundColor = '#FFC107';
            else strengthBar.style.backgroundColor = '#2ED573';
        });
    </script>
    <%- include('../partials/flashAlert') %>
</body>
</html>