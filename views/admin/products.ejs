<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/admin/head') %>
    <title>ZiGo Admin | Product Management</title>
</head>

<body>
    <!-- Sidebar -->
    <%- include('../partials/admin/sidebar', { activeTab: 'products' }) %>

    <!-- Main Content -->
    <main class="admin-main">
        <%- include('../partials/admin/pageHeader', { title: 'Product', accentTitle: 'Management', subtitle: 'CATALOG' }) %>

        <div class="products-card">
            <div class="flex flex-col xl:flex-row justify-between items-start xl:items-center gap-6 mb-8">
                <div class="search-row !mb-0 w-full xl:w-auto">
                    <div class="search-wrapper">
                        <input type="text" id="productSearch" value="<%= search %>" placeholder="Search products..." class="search-input">
                        <i class="fas fa-search search-icon"></i>
                    </div>
                    <div class="flex gap-2">
                        <button id="searchBtn" class="btn-search-panel btn-search-submit">SEARCH</button>
                        <button id="clearSearch" class="btn-search-panel btn-search-clear">CLEAR</button>
                    </div>
                </div>
                <a href="/admin/addProducts" class="w-full xl:w-auto bg-gradient-to-r from-orange-500 to-orange-600 hover:scale-[1.02] active:scale-[0.98] text-white px-8 py-4 rounded-2xl font-black transition-all flex items-center justify-center gap-3 shadow-xl shadow-orange-500/20">
                    <i class="fas fa-plus"></i> ADD NEW PRODUCT
                </a>
            </div>

            <div class="data-table-wrapper">
                <table class="w-full border-collapse">
                    <thead>
                        <tr class="text-left border-b border-white/5">
                            <th class="p-4 text-[10px] font-bold uppercase tracking-widest opacity-40">Product</th>
                            <th class="p-4 text-[10px] font-bold uppercase tracking-widest opacity-40">Category</th>
                            <th class="p-4 text-[10px] font-bold uppercase tracking-widest opacity-40">Base Price</th>
                            <th class="p-4 text-[10px] font-bold uppercase tracking-widest opacity-40">Stock</th>
                            <th class="p-4 text-[10px] font-bold uppercase tracking-widest opacity-40">Status</th>
                            <th class="p-4 text-[10px] font-bold uppercase tracking-widest opacity-40 text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-white/5">
                        <% if (products && products.length > 0) { %>
                            <% products.forEach(product => { %>
                                <tr class="hover:bg-white/[0.02] transition-colors">
                                    <td class="p-4">
                                        <div class="flex items-center gap-4">
                                            <div class="w-12 h-12 rounded-xl bg-white/5 flex items-center justify-center p-2">
                                                <img src="<%= (product.variants && product.variants[0] && product.variants[0].images) ? product.variants[0].images[0] : '/public/landing/no-image.png' %>" alt="" class="max-w-full max-h-full object-contain">
                                            </div>
                                            <div>
                                                <p class="font-bold text-sm lg:text-base text-white/90"><%= product.productName %></p>
                                                <p class="text-[10px] lg:text-xs opacity-30 font-bold uppercase tracking-widest">ID: <%= product._id.toString().slice(-6).toUpperCase() %></p>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="p-4"><span class="text-sm lg:text-base text-white/60"><%= product.category ? product.category.categoryName : 'Uncategorized' %></span></td>
                                    <td class="p-4 font-black text-sm lg:text-base">₹<%= (product.variants && product.variants[0]) ? product.variants[0].price : '0' %></td>
                                    <td class="p-4">
                                        <% let totalStock = 0; if (product.variants && Array.isArray(product.variants)) {
                                            totalStock = product.variants.reduce((sum, variant) => sum + (variant.stock || 0), 0);
                                        } %>
                                        <span class="text-xs font-bold <%= totalStock < 5 ? 'text-red-500' : 'text-white/60' %>">
                                            <%= totalStock %> Units
                                        </span>
                                    </td>
                                    <td class="p-4">
                                        <div class="flex items-center gap-3">
                                            <label class="relative inline-flex items-center cursor-pointer">
                                                <input type="checkbox" <%= product.isListed ? 'checked' : '' %> class="sr-only peer" onchange="toggleProductStatus('<%= product._id %>', this)">
                                                <div class="w-10 h-5 bg-white/10 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-orange-500"></div>
                                            </label>
                                            <span class="text-[9px] font-black uppercase tracking-widest <%= product.isListed ? 'text-orange-500' : 'text-white/20' %>">
                                                <%= product.isListed ? 'Listed' : 'Hidden' %>
                                            </span>
                                        </div>
                                    </td>
                                    <td class="p-4 text-right">
                                        <a href="/admin/products/edit/<%= product._id %>" class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-white/5 hover:bg-orange-500 hover:text-white transition-all">
                                            <i class="fas fa-edit text-xs"></i>
                                        </a>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="p-20 text-center text-white/20 font-bold italic">No products matched your search.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <%- include("../partials/admin/pagination.ejs") %>
        </div>
    </main>

    <script>
        const productSearch = document.getElementById('productSearch');
        const searchBtn = document.getElementById('searchBtn');
        const clearBtn = document.getElementById('clearSearch');

        function triggerSearch() {
            const query = productSearch.value.trim();
            window.location.href = `/admin/products?page=1&search=${query}`;
        }

        if (searchBtn) searchBtn.addEventListener('click', triggerSearch);
        if (productSearch) productSearch.addEventListener('keypress', (e) => { if (e.key === 'Enter') triggerSearch(); });

        if (clearBtn) clearBtn.addEventListener('click', () => {
            const url = new URL(window.location.href);
            url.searchParams.delete("search");
            url.searchParams.set("page", "1");
            window.location.href = url.toString();
        });

        async function toggleProductStatus(productId, checkbox) {
            const isListed = checkbox.checked;
            const actionLabel = isListed ? 'listed' : 'unlisted';
            
            try {
                const response = await fetch(`/admin/products/status/${productId}`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ isListed })
                });

                const result = await response.json();

                if (response.ok && result.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: `Product successfully ${actionLabel}`,
                        toast: true,
                        position: 'top-end',
                        showConfirmButton: false,
                        timer: 3000
                    });
                    // Dynamically update the status text next to the toggle
                    const statusText = checkbox.parentElement.nextElementSibling;
                    if (statusText) {
                        statusText.innerText = isListed ? 'Listed' : 'Hidden';
                        statusText.className = `text-[9px] font-black uppercase tracking-widest ${isListed ? 'text-orange-500' : 'text-white/20'}`;
                    }
                } else {
                    checkbox.checked = !isListed;
                    Swal.fire('Error', result.message || 'Failed to update status', 'error');
                }
            } catch (error) {
                console.error('Error:', error);
                checkbox.checked = !isListed;
                Swal.fire('Error', 'An internal error occurred', 'error');
            }
        }
    </script>
    <%- include('../partials/flashAlert') %>
</body>

</html>