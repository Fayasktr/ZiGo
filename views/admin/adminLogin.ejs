<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/admin/head') %>
    <title>ZiGo Admin | Login</title>
    <style>
        .login-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(25px);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 2.5rem;
            padding: 2.5rem;
            width: 100%;
            max-width: 450px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        }

        @media (min-width: 640px) {
            .login-card {
                padding: 3.5rem;
            }
        }

        .glow {
            position: absolute;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(255, 90, 31, 0.08) 0%, transparent 70%);
            z-index: -1;
            filter: blur(40px);
        }

        .form-input {
            width: 100%;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 1.25rem;
            padding: 1.25rem 1.5rem 1.25rem 3.5rem;
            color: white;
            font-weight: 500;
            transition: all 0.3s ease;
            outline: none;
        }

        .form-input:focus {
            background: rgba(255, 255, 255, 0.05);
            border-color: #FF5A1F;
        }

        .input-group i {
            transition: all 0.3s ease;
        }

        .form-input:focus + i {
            color: #FF5A1F;
        }
    </style>
</head>

<body class="bg-[#0F0F0F] min-h-screen flex items-center justify-center p-6 relative overflow-hidden">
    <div class="glow -top-48 -left-48"></div>
    <div class="glow -bottom-48 -right-48"></div>

    <div class="login-card animate-in fade-in slide-in-from-bottom-5 duration-700">
        <div class="text-center mb-10">
            <img src="/public/public/logo-icon.png" alt="ZiGo" class="h-16 mx-auto mb-6">
            <h1 class="text-3xl font-black tracking-tight text-white/90">
                Admin <span class="text-orange-500 italic">Access</span>
            </h1>
            <p class="text-[10px] font-black uppercase tracking-[3px] text-white/20 mt-3">Personnel Registry Only</p>
        </div>

        <form action="/admin" method="POST" class="space-y-5">
            <div class="input-group relative">
                <input type="text" name="adminMail" class="form-input" placeholder="Admin Identifier" required>
                <i class="fas fa-fingerprint absolute left-6 top-1/2 -translate-y-1/2 text-white/20"></i>
            </div>

            <div class="input-group relative">
                <input type="password" name="password" class="form-input" placeholder="Secure Password" required>
                <i class="fas fa-shield-alt absolute left-6 top-1/2 -translate-y-1/2 text-white/20"></i>
            </div>

            <button type="submit" class="w-full bg-orange-500 hover:bg-orange-600 text-white py-5 rounded-2xl font-black text-xs uppercase tracking-[4px] transition-all shadow-xl shadow-orange-500/20 active:scale-[0.98] mt-4">
                Verify Identity <i class="fas fa-chevron-right ml-2"></i>
            </button>
        </form>

        <div class="mt-10 pt-8 border-t border-white/5 text-center">
            <p class="text-[9px] font-bold text-white/10 uppercase tracking-[4px]">Secured by ZiGo Sentinel</p>
        </div>
    </div>

    <%- include('../partials/flashAlert') %>
</body>
</html>