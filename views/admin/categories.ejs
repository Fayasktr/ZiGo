<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/admin/head') %>
    <title>ZiGo Admin | Category Management</title>
</head>

<body>
    <!-- Sidebar -->
    <%- include('../partials/admin/sidebar', { activeTab: 'categories' }) %>

    <main class="admin-main">
        <%- include('../partials/admin/pageHeader', { title: 'Category', accentTitle: 'Management', subtitle: 'TAXONOMY' }) %>

        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-10">
            <div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto">
                <div class="relative flex-1 sm:w-80">
                    <input type="text" id="categorySearch" value="<%= search %>" placeholder="Search categories..." class="w-full bg-white/5 border border-white/10 px-12 py-3 rounded-xl outline-none text-sm focus:border-orange-500 transition-all">
                    <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-orange-500/50"></i>
                </div>
                <div class="flex gap-2">
                    <button id="searchBtn" class="bg-orange-500 hover:bg-orange-600 text-white px-5 py-3 rounded-xl font-bold transition-all text-xs uppercase tracking-widest flex items-center justify-center min-w-[100px]">Search</button>
                    <button id="clearSearch" class="bg-white/5 hover:bg-white/10 text-white/50 px-5 py-3 rounded-xl font-bold transition-all text-xs uppercase tracking-widest flex items-center justify-center min-w-[100px]">Clear</button>
                </div>
            </div>
            <a href="/admin/category/add" class="w-full md:w-auto bg-gradient-to-r from-orange-500 to-orange-600 hover:scale-[1.02] active:scale-[0.98] text-white px-8 py-4 rounded-2xl font-black transition-all flex items-center justify-center gap-3 shadow-xl shadow-orange-500/20">
                <i class="fas fa-plus"></i> NEW CATEGORY
            </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
            <% if (category && category.length > 0) { %>
                <% category.forEach(cat => { %>
                    <div class="bg-white/5 border border-white/5 rounded-[2rem] p-8 hover:border-orange-500/30 transition-all group flex flex-col">
                        <div class="flex justify-between items-start mb-6">
                            <div class="w-14 h-14 bg-orange-500/10 rounded-2xl flex items-center justify-center text-orange-500 text-2xl group-hover:scale-110 transition-transform">
                                <i class="<%= cat.iconClass || 'fas fa-folder' %>"></i>
                            </div>
                            <span class="px-3 py-1 rounded-full text-[9px] font-black uppercase tracking-widest <%= cat.isListed ? 'bg-emerald-500/10 text-emerald-500' : 'bg-red-500/10 text-red-500' %>">
                                <%= cat.isListed ? 'ACTIVE' : 'BLOCKED' %>
                            </span>
                        </div>
                        
                        <h3 class="text-xl font-black mb-1 group-hover:text-orange-500 transition-colors"><%= cat.categoryName %></h3>
                        
                        <div class="flex flex-wrap gap-2 mt-4 pb-6 border-b border-white/5">
                            <% if (cat.variantAttributes && cat.variantAttributes.length > 0) { %>
                                <% cat.variantAttributes.forEach(attr => { %>
                                    <span class="bg-white/5 border border-white/5 text-[10px] text-white/40 font-bold px-3 py-1 rounded-lg">
                                        <%= attr %>
                                    </span>
                                <% }) %>
                            <% } else { %>
                                <span class="text-[10px] text-white/20 italic">No variants defined</span>
                            <% } %>
                        </div>

                        <div class="flex gap-2 mt-6">
                            <a href="/admin/category/edit/<%= cat._id %>" class="flex-1 bg-white/5 text-white/60 hover:bg-white/10 py-3 rounded-xl font-bold text-xs uppercase tracking-widest text-center transition-all">Edit</a>
                            <% if (cat.isListed) { %>
                                <button onclick="toggleCategoryStatus('<%= cat._id %>', true)" class="flex-1 bg-red-500/10 text-red-500 hover:bg-red-500 hover:text-white py-3 rounded-xl font-bold text-xs uppercase tracking-widest transition-all">Block</button>
                            <% } else { %>
                                <button onclick="toggleCategoryStatus('<%= cat._id %>', false)" class="flex-1 bg-emerald-500/10 text-emerald-500 hover:bg-emerald-500 hover:text-white py-3 rounded-xl font-bold text-xs uppercase tracking-widest transition-all">Unblock</button>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="col-span-full py-32 flex flex-col items-center justify-center opacity-20 italic">
                    <i class="fas fa-folder-open text-6xl mb-6"></i>
                    <p class="text-xl font-black">No categories found in database.</p>
                </div>
            <% } %>
        </div>

        <%- include("../partials/admin/pagination.ejs") %>
    </main>

    <script>
        const categorySearch = document.getElementById('categorySearch');
        const searchBtn = document.getElementById('searchBtn');
        const clearBtn = document.getElementById('clearSearch');

        function triggerSearch() {
            const query = categorySearch.value.trim();
            window.location.href = `/admin/category?page=1&search=${query}`;
        }

        if (searchBtn) searchBtn.addEventListener('click', triggerSearch);
        if (categorySearch) categorySearch.addEventListener('keypress', (e) => { if (e.key === 'Enter') triggerSearch(); });

        if (clearBtn) clearBtn.addEventListener('click', () => {
            const url = new URL(window.location.href);
            url.searchParams.delete("search");
            url.searchParams.set("page", "1");
            window.location.href = url.toString();
        });

        async function toggleCategoryStatus(catId, block) {
            try {
                const action = block ? "Block" : 'Unblock';
                const response = await fetch(`/admin/category/${catId}/${action}`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' }
                });

                const result = await response.json();
                if (response.ok && result.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: `Category successfully ${action.toLowerCase()}ed`,
                        toast: true,
                        position: 'top-end',
                        showConfirmButton: false,
                        timer: 2000
                    }).then(() => window.location.reload());
                } else {
                    Swal.fire('Error', result.message || 'Action failed', 'error');
                }
            } catch (error) {
                console.error('Error:', error);
                Swal.fire('Error', 'An error occurred', 'error');
            }
        }
    </script>
    <%- include('../partials/flashAlert') %>
</body>
</html>