<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ZiGo Admin | Marketing & Coupons</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="icon" type="image/png" href="/public/public/favicon.png">
    <style>
        :root {
            --primary-orange: #FF5A1F;
            --primary-orange-hover: #E44D18;
            --deep-black: #0F0F0F;
            --white: #FFFFFF;
            --glass: rgba(255, 255, 255, 0.03);
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }

        body {
            background-color: var(--deep-black);
            color: var(--white);
            display: flex;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* --- Admin Sidebar --- */
        .admin-sidebar {
            width: 280px;
            background: rgba(255, 255, 255, 0.02);
            backdrop-filter: blur(20px);
            border-right: 1px solid rgba(255, 255, 255, 0.05);
            height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            padding: 2rem;
            display: flex;
            flex-direction: column;
            z-index: 1000;
            overflow-y: auto;
        }

        .admin-sidebar::-webkit-scrollbar {
            width: 4px;
        }

        .admin-sidebar::-webkit-scrollbar-thumb {
            background: rgba(255, 90, 31, 0.2);
            border-radius: 10px;
        }

        .admin-logo {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 3rem;
            text-decoration: none;
        }

        .admin-logo img {
            height: 48px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1rem 1.5rem;
            border-radius: 16px;
            color: rgba(255, 255, 255, 0.5);
            text-decoration: none;
            font-weight: 600;
            transition: var(--transition);
            margin-bottom: 0.5rem;
        }

        .nav-item:hover,
        .nav-item.active {
            background: rgba(255, 90, 31, 0.1);
            color: var(--primary-orange);
        }

        .nav-item.active {
            box-shadow: 0 4px 15px rgba(255, 90, 31, 0.1);
        }

        .logout-btn {
            margin-top: auto;
            color: #FF4757;
            background: rgba(255, 71, 87, 0.05);
        }

        .logout-btn:hover {
            background: #FF4757;
            color: white;
        }

        /* --- Main Content --- */
        .admin-main {
            flex: 1;
            margin-left: 280px;
            padding: 2.5rem 3.5rem;
        }

        .admin-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 3rem;
        }

        .page-header-info h1 {
            font-size: 2rem;
            font-weight: 800;
            letter-spacing: -1px;
        }

        .btn-add {
            background: var(--primary-orange);
            color: white;
            padding: 1rem 2rem;
            border-radius: 16px;
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 10px;
            transition: var(--transition);
        }

        .btn-add:hover {
            background: var(--primary-orange-hover);
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(255, 90, 31, 0.2);
        }

        /* --- Coupons Grid --- */
        .grid-coupons {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
            gap: 1.5rem;
        }

        .coupon-card {
            background: var(--glass);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 28px;
            padding: 2.5rem 2rem;
            border-left: 4px solid var(--primary-orange);
            position: relative;
            overflow: hidden;
            transition: var(--transition);
        }

        .coupon-card:hover {
            background: rgba(255, 255, 255, 0.05);
            transform: translateY(-5px);
            border-color: rgba(255, 90, 31, 0.3);
        }

        .coupon-card:after {
            content: '';
            position: absolute;
            right: -15px;
            top: 50%;
            width: 30px;
            height: 30px;
            background: var(--deep-black);
            border-radius: 50%;
            transform: translateY(-50%);
        }

        .type-badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 8px;
            font-size: 0.65rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 1.25rem;
        }

        .type-percentage {
            background: rgba(46, 213, 115, 0.1);
            color: #2ED573;
        }

        .type-fixed {
            background: rgba(51, 149, 255, 0.1);
            color: #3395FF;
        }

        .coupon-code {
            font-size: 1.75rem;
            font-weight: 900;
            color: var(--primary-orange);
            letter-spacing: 2px;
            margin-bottom: 0.5rem;
        }

        .coupon-desc {
            font-size: 0.85rem;
            opacity: 0.5;
            margin-bottom: 2rem;
            line-height: 1.5;
        }

        .coupon-meta {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
            padding-top: 1.5rem;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }

        .meta-box h5 {
            font-size: 0.6rem;
            text-transform: uppercase;
            opacity: 0.3;
            letter-spacing: 1px;
            margin-bottom: 4px;
        }

        .meta-box p {
            font-size: 0.85rem;
            font-weight: 700;
        }

        .empty-state {
            text-align: center;
            padding: 5rem 2rem;
            background: var(--glass);
            border-radius: 32px;
            border: 1px dashed rgba(255, 255, 255, 0.1);
        }
    </style>
</head>

<body>
    <!-- Sidebar -->
    <aside class="admin-sidebar">
        <a href="/admin/dashbord" class="admin-logo">
            <img src="/public/public/logo-icon.png" alt="ZiGo">
            <img src="/public/public/logo-name.png" alt="ZiGo" style="height: 24px;">
        </a>

        <nav class="admin-nav">
            <a href="/admin/dashbord" class="nav-item">
                <i class="fas fa-chart-line"></i> Dashboard
            </a>
            <a href="/admin/products" class="nav-item">
                <i class="fas fa-box"></i> Products
            </a>
            <a href="/admin/orders" class="nav-item">
                <i class="fas fa-shopping-cart"></i> Orders
            </a>
            <a href="/admin/users" class="nav-item">
                <i class="fas fa-users"></i> Users
            </a>
            <a href="/admin/category" class="nav-item">
                <i class="fas fa-tags"></i> Categories
            </a>
            <a href="/admin/coupons" class="nav-item active">
                <i class="fas fa-ticket-alt"></i> Coupons
            </a>
            <a href="/admin/banners" class="nav-item">
                <i class="fas fa-image"></i> Banners
            </a>
            <a href="/admin/offers" class="nav-item">
                <i class="fas fa-percent"></i> Offers
            </a>
            <a href="/admin/reports" class="nav-item">
                <i class="fas fa-file-invoice-dollar"></i> Sales Report
            </a>
        </nav>

        <a href="/admin/logout" class="nav-item logout-btn">
            <i class="fas fa-sign-out-alt"></i> Sign Out
        </a>
    </aside>

    <!-- Main Content -->
    <main class="admin-main">
        <header class="admin-header">
            <div class="page-header-info">
                <p class="text-orange-500 font-bold uppercase tracking-[4px] text-xs mb-1">Incentives</p>
                <h1>Marketing <span class="text-orange-500">Suite</span></h1>
            </div>

            <div class="flex items-center gap-6">
                <!-- User Profile (same as dashboard) -->
                <div class="text-right hidden md:block">
                    <p class="font-bold text-sm">Fayas Admin</p>
                    <p class="text-xs opacity-40">System Architect</p>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-orange-500 flex items-center justify-center text-white font-black text-xl">
                    F
                </div>
                
                <a href="/admin/coupons/add" class="btn-add ml-4">
                    <i class="fas fa-plus"></i> Launch Campaign
                </a>
            </div>
        </header>

        <section class="marketing-section">
            <h3 class="flex items-center gap-3 text-xl font-bold mb-8 italic opacity-60">
                <i class="fas fa-ticket-alt text-orange-500"></i> Active Redemption Channels
            </h3>

            <% if (locals.coupons && coupons.length > 0) { %>
                <div class="grid-coupons">
                    <% coupons.forEach(coupon => { %>
                        <div class="coupon-card" style="border-left-color: <%= coupon.type === 'percentage' ? '#2ED573' : '#3395FF' %>;">
                            <span class="type-badge <%= coupon.type === 'percentage' ? 'type-percentage' : 'type-fixed' %>">
                                <%= coupon.type === 'percentage' ? 'Percentage Off' : 'Flat Discount' %>
                            </span>
                            
                            <p class="coupon-code" style="color: <%= coupon.type === 'percentage' ? '#2ED573' : '#3395FF' %>;">
                                <%= coupon.code %>
                            </p>
                            <p class="coupon-desc text-white">
                                <%= coupon.description %>
                            </p>
                            
                            <div class="coupon-meta">
                                <div class="meta-box">
                                    <h5>Redemptions</h5>
                                    <p>
                                        <%= coupon.usedCount || 0 %> / <%= coupon.usageLimit || '∞' %>
                                    </p>
                                </div>
                                <div class="meta-box text-right">
                                    <h5>Availability</h5>
                                    <p class="<%= (new Date(coupon.expiryDate) < new Date()) ? 'text-red-500' : '' %>">
                                        <%= coupon.expiryDate ? new Date(coupon.expiryDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : 'Lifetime' %>
                                    </p>
                                </div>
                            </div>

                            <div class="mt-6 flex gap-2 justify-end">
                                <a href="/admin/coupons/edit/<%= coupon._id %>" class="bg-white/5 hover:bg-white/10 p-2 px-4 rounded-xl transition">
                                    <i class="fas fa-edit text-xs"></i>
                                </a>
                                <button onclick="deleteCoupon('<%= coupon._id %>')" class="bg-red-500/10 hover:bg-red-500/20 text-red-500 p-2 px-4 rounded-xl transition">
                                    <i class="fas fa-trash text-xs"></i>
                                </button>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <div class="w-16 h-16 bg-white/5 rounded-full flex items-center justify-center mx-auto mb-4 text-orange-500">
                        <i class="fas fa-ticket-alt text-2xl"></i>
                    </div>
                    <h4 class="font-bold text-lg mb-2">No Active Coupons</h4>
                    <p class="text-sm opacity-40 mb-6">Launch a new marketing campaign to see your performance metrics here.</p>
                    <a href="/admin/coupons/add" class="text-orange-500 font-bold border-b border-orange-500 pb-1">Create Your First Coupon</a>
                </div>
            <% } %>
        </section>
    </main>

    <%- include('../partials/flashAlert') %>

    <script>
        async function deleteCoupon(id) {
            const confirmed = await Swal.fire({
                title: 'Deactivate Coupon?',
                text: "This campaign will be immediately revoked from customer availability.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#FF5A1F',
                cancelButtonColor: '#334155',
                confirmButtonText: 'Yes, revoke it'
            });

            if (confirmed.isConfirmed) {
                try {
                    const response = await fetch(`/admin/coupons/delete/${id}`, { method: 'DELETE' });
                    const res = await response.json();
                    if (res.success) {
                        location.reload();
                    } else {
                        throw new Error(res.message);
                    }
                } catch (error) {
                    Swal.fire('Failed!', error.message, 'error');
                }
            }
        }
    </script>
</body>

</html>
