<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/admin/head') %>
    <title>ZiGo Admin | Marketing & Coupons</title>
</head>

<body>
    <!-- Sidebar -->
    <%- include('../partials/admin/sidebar', { activeTab: 'coupons' }) %>

    <!-- Main Content -->
    <main class="admin-main">
        <%- include('../partials/admin/pageHeader', { title: 'Marketing', accentTitle: 'Suite', subtitle: 'INCENTIVES' }) %>

        <div class="flex flex-col xl:flex-row justify-between items-start xl:items-center gap-6 mb-10">
            <div class="flex flex-col sm:flex-row gap-3 w-full xl:w-auto">
                <div class="relative flex-1 sm:w-80">
                    <input type="text" id="couponSearch" value="<%= locals.search || '' %>" placeholder="Search campaigns..." class="w-full bg-white/5 border border-white/10 px-12 py-3 rounded-xl outline-none text-sm focus:border-orange-500 transition-all">
                    <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-orange-500/50"></i>
                </div>
                <div class="flex gap-2">
                    <button onclick="triggerSearch()" class="bg-orange-500 hover:bg-orange-600 text-white px-5 py-3 rounded-xl font-bold transition-all text-xs uppercase tracking-widest flex items-center justify-center min-w-[100px]">Search</button>
                    <button onclick="clearSearch()" class="bg-white/5 hover:bg-white/10 text-white/50 px-5 py-3 rounded-xl font-bold transition-all text-xs uppercase tracking-widest flex items-center justify-center min-w-[100px]">Clear</button>
                </div>
            </div>
            <a href="/admin/coupon/addEditPage" class="w-full xl:w-auto bg-gradient-to-r from-orange-500 to-orange-600 hover:scale-[1.02] active:scale-[0.98] text-white px-8 py-4 rounded-2xl font-black transition-all flex items-center justify-center gap-3 shadow-xl shadow-orange-500/20">
                <i class="fas fa-plus"></i> LAUNCH CAMPAIGN
            </a>
        </div>

        <div class="mb-10">
            <h3 class="flex items-center gap-3 text-lg font-black italic opacity-40 uppercase tracking-widest">
                <i class="fas fa-ticket-alt text-orange-500"></i> Active Redemption Channels
            </h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
            <% if (locals.coupons && coupons.length > 0) { %>
                <% coupons.forEach(coupon => { 
                    const isExpired = coupon.expiresAt ? (new Date(coupon.expiresAt) < new Date()) : false;
                    const isInactive = !coupon.isActive;
                    const color = coupon.discountType === 'percentage' ? '#2ED573' : '#3395FF';
                %>
                    <div class="bg-white/5 border border-white/5 rounded-[2.5rem] p-8 flex flex-col relative overflow-hidden group hover:border-orange-500/20 transition-all <%= (isExpired || isInactive) ? 'opacity-50' : '' %>" style="border-left: 4px solid <%= color %>">
                        <!-- Perforation dots for ticket look -->
                        <div class="absolute -right-3 top-1/2 -translate-y-1/2 w-6 h-6 bg-black rounded-full"></div>
                        <div class="absolute -left-3 top-1/2 -translate-y-1/2 w-6 h-6 bg-black rounded-full"></div>

                        <div class="flex justify-between items-start mb-6">
                            <span class="px-3 py-1 rounded-lg text-[9px] font-black uppercase tracking-widest" style="background: <%= color %>10; color: <%= color %>">
                                <%= coupon.discountType === 'percentage' ? 'Percentage Off' : 'Flat Discount' %>
                            </span>
                            <% if (isInactive || isExpired) { %>
                                <span class="text-[9px] font-black bg-red-500 text-white px-2 py-1 rounded-md uppercase tracking-wider shadow-lg shadow-red-500/20">
                                    <%= isInactive ? 'INACTIVE' : 'EXPIRED' %>
                                </span>
                            <% } %>
                        </div>

                        <div class="mb-6">
                            <p class="text-3xl font-black tracking-tighter mb-1 uppercase" style="color: <%= color %>">
                                <%= coupon.code %>
                            </p>
                            <p class="text-4xl font-extrabold text-white/90">
                                <% if (coupon.discountType === 'percentage') { %>
                                    <%= coupon.discountValue %><span class="text-xl opacity-30">%</span>
                                <% } else { %>
                                    <span class="text-xl opacity-30">₹</span><%= coupon.discountValue %>
                                <% } %>
                                <span class="text-[10px] font-black uppercase tracking-[4px] opacity-20 ml-2">SAVINGS</span>
                            </p>
                        </div>

                        <p class="text-sm text-white/40 mb-8 line-clamp-2 italic font-medium leading-relaxed">
                            "<%= coupon.description %>"
                        </p>

                        <div class="grid grid-cols-2 gap-4 pt-6 border-t border-white/5 mb-8">
                            <div class="flex flex-col gap-1">
                                <span class="text-[9px] font-black uppercase tracking-widest opacity-20">Redemptions</span>
                                <span class="text-sm font-bold text-white/80"><%= coupon.usedCount || 0 %> / <%= coupon.usageLimit || '∞' %></span>
                            </div>
                            <div class="flex flex-col gap-1 text-right">
                                <span class="text-[9px] font-black uppercase tracking-widest opacity-20">Ends On</span>
                                <span class="text-sm font-bold <%= isExpired ? 'text-red-500/80' : 'text-white/80' %>">
                                    <%= coupon.expiresAt ? new Date(coupon.expiresAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short' }) : 'Lifetime' %>
                                </span>
                            </div>
                        </div>

                        <div class="flex gap-2 mt-auto">
                            <a href="/admin/coupon/addEditPage?couponId=<%= coupon._id %>" class="flex-1 bg-white/5 hover:bg-white/10 py-3 rounded-xl transition-all text-center">
                                <i class="fas fa-edit text-xs"></i>
                            </a>
                            <button onclick="deleteCoupon('<%= coupon._id %>', '<%= coupon.code %>')" class="flex-1 bg-red-500/10 hover:bg-red-500 text-red-500 hover:text-white py-3 rounded-xl transition-all">
                                <i class="fas fa-trash text-xs"></i>
                            </button>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="col-span-full py-32 flex flex-col items-center justify-center opacity-20 italic">
                    <i class="fas fa-ticket-alt text-6xl mb-6"></i>
                    <p class="text-xl font-black uppercase tracking-widest">No active campaigns</p>
                </div>
            <% } %>
        </div>

        <div class="mt-12">
            <%- include('../partials/admin/pagination.ejs') %>
        </div>
    </main>

    <%- include('../partials/flashAlert') %>

    <script>
        function triggerSearch() {
            const query = document.getElementById('couponSearch').value.trim();
            window.location.href = `/admin/coupons?page=1&search=${query}`;
        }

        function clearSearch() {
            const url = new URL(window.location.href);
            url.searchParams.delete("search");
            url.searchParams.set("page", "1");
            window.location.href = url.toString();
        }

        document.getElementById('couponSearch').addEventListener('keypress', (e) => {
            if (e.key === 'Enter') triggerSearch();
        });

        async function deleteCoupon(id, code) {
            const confirmed = await Swal.fire({
                title: `Remove ${code}?`,
                text: "This coupon campaign will be permanently destroyed.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#FF5A1F',
                cancelButtonColor: 'rgba(255,255,255,0.05)',
                confirmButtonText: 'Yes, delete it',
                background: '#121212',
                color: '#FFFFFF'
            });

            if (confirmed.isConfirmed) {
                try {
                    const response = await fetch(`/admin/coupon/delete/${id}`, { method: 'DELETE' });
                    const res = await response.json();
                    
                    if (res.success) {
                        Swal.fire({
                            toast: true,
                            position: 'top-end',
                            icon: 'success',
                            title: 'Coupon successfully removed',
                            showConfirmButton: false,
                            timer: 2000,
                            background: '#121212',
                            color: '#FFFFFF'
                        });
                        setTimeout(() => location.reload(), 2000);
                    } else {
                        throw new Error(res.message);
                    }
                } catch (error) {
                    Swal.fire({ icon: 'error', title: 'Action Failed', text: error.message });
                }
            }
        }
    </script>
</body>
</html>
