<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/admin/head') %>
    <title>ZiGo Admin | Offers Management</title>
</head>

<body>
    <!-- Sidebar -->
    <%- include('../partials/admin/sidebar', { activeTab: 'offers' }) %>

    <main class="admin-main">
        <%- include('../partials/admin/pageHeader', { title: 'Offers', accentTitle: 'Management', subtitle: 'INCENTIVES' }) %>

        <div class="flex flex-col sm:flex-row justify-between items-start xl:items-center gap-6 mb-8">
            <div class="search-row !mb-0 w-full xl:w-auto">
                <div class="search-wrapper">
                    <input type="text" id="offerSearch" value="<%= locals.search || '' %>" placeholder="Search campaigns..." class="search-input">
                    <i class="fas fa-search search-icon"></i>
                </div>
                <div class="flex gap-2">
                    <button onclick="triggerSearch()" class="btn-search-panel btn-search-submit">SEARCH</button>
                    <button onclick="clearSearch()" class="btn-search-panel btn-search-clear">CLEAR</button>
                </div>
            </div>
            <a href="/admin/offer/addEditPage" class="w-full xl:w-auto bg-gradient-to-r from-orange-500 to-orange-600 hover:scale-[1.02] active:scale-[0.98] text-white px-8 py-4 rounded-2xl font-black transition-all flex items-center justify-center gap-3 shadow-xl shadow-orange-500/20">
                <i class="fas fa-plus"></i> CREATE NEW OFFER
            </a>
        </div>

        <div class="flex flex-wrap gap-2 p-1 bg-white/5 rounded-2xl w-fit mb-10 border border-white/5">
            <button onclick="switchTab('category')" class="px-6 py-3 rounded-xl text-xs font-black uppercase tracking-widest transition-all <%= (locals.offerType === 'category' || !locals.offerType) ? 'bg-orange-500 text-white shadow-lg shadow-orange-500/20' : 'text-white/20 hover:text-white/40' %>">
                Category Offers
            </button>
            <button onclick="switchTab('product')" class="px-6 py-3 rounded-xl text-xs font-black uppercase tracking-widest transition-all <%= locals.offerType === 'product' ? 'bg-orange-500 text-white shadow-lg shadow-orange-500/20' : 'text-white/20 hover:text-white/40' %>">
                Product Offers
            </button>
        </div>

        <div class="bg-white/5 border border-white/5 rounded-[2.5rem] p-4 sm:p-8">
            <div class="data-table-wrapper">
                <table class="w-full border-separate border-spacing-y-3">
                    <thead>
                        <tr class="text-left font-bold text-[10px] uppercase tracking-widest opacity-30">
                            <th class="px-6 pb-4">Offer Name</th>
                            <th class="px-6 pb-4"><%= (locals.offerType === 'product') ? 'Product' : 'Category' %></th>
                            <th class="px-6 pb-4">Discount</th>
                            <th class="px-6 pb-4">Status</th>
                            <th class="px-6 pb-4 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if(locals.offers && offers.length > 0) { %>
                            <% offers.forEach(offer => { %>
                                <tr class="group hover:scale-[1.01] transition-all duration-300">
                                    <td class="px-6 py-5 bg-white/[0.02] rounded-l-2xl border-y border-l border-white/5 group-hover:border-orange-500/20 group-hover:bg-white/[0.04]">
                                        <p class="font-bold text-white/90"><%= offer.name %></p>
                                    </td>
                                    <td class="px-6 py-5 bg-white/[0.02] border-y border-white/5 group-hover:border-orange-500/20 group-hover:bg-white/[0.04]">
                                        <span class="text-xs lg:text-sm text-white/40 font-medium">
                                            <%= (locals.offerType === 'product') ? (offer.productId ? offer.productId.productName : 'Unknown Product') : (offer.categoryId ? offer.categoryId.categoryName : 'Unknown Category') %>
                                        </span>
                                    </td>
                                    <td class="px-6 py-5 bg-white/[0.02] border-y border-white/5 group-hover:border-orange-500/20 group-hover:bg-white/[0.04]">
                                        <span class="px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-500 text-[10px] font-black uppercase tracking-widest border border-emerald-500/20">
                                            <%= offer.discountValue %><%= (offer.discountType === 'percentage') ? '%' : ' OFF' %>
                                        </span>
                                    </td>
                                    <td class="px-6 py-5 bg-white/[0.02] border-y border-white/5 group-hover:border-orange-500/20 group-hover:bg-white/[0.04]">
                                        <% 
                                            const now = new Date();
                                            const isExpired = new Date(offer.expireAt) < now;
                                            const activeClass = (offer.isActive && !isExpired) ? 'bg-orange-500/10 text-orange-500 border-orange-500/20' : 'bg-red-500/10 text-red-500 border-red-500/20';
                                        %>
                                        <span class="px-3 py-1 rounded-full text-[9px] font-black uppercase tracking-widest border <%= activeClass %>">
                                            <%= (offer.isActive && !isExpired) ? 'Active' : (isExpired ? 'Expired' : 'Inactive') %>
                                        </span>
                                    </td>
                                    <td class="px-6 py-5 bg-white/[0.02] rounded-r-2xl border-y border-r border-white/5 group-hover:border-orange-500/20 group-hover:bg-white/[0.04] text-right">
                                        <div class="flex gap-2 justify-end">
                                            <a href="/admin/offer/addEditPage?offerId=<%= offer._id %>" class="w-9 h-9 flex items-center justify-center rounded-xl bg-white/5 hover:bg-orange-500 hover:text-white transition-all">
                                                <i class="fas fa-edit text-xs"></i>
                                            </a>
                                            <button onclick="deleteOffer('<%= offer._id %>', '<%= offer.name %>')" class="w-9 h-9 flex items-center justify-center rounded-xl bg-white/5 hover:bg-red-500 hover:text-white transition-all">
                                                <i class="fas fa-trash text-xs"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="py-20 text-center text-white/20 font-bold italic">No offers found in this segment.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <div class="mt-8">
                <%- include('../partials/admin/pagination.ejs') %>
            </div>
        </div>
    </main>

    <script>
        function triggerSearch() {
            const query = document.getElementById('offerSearch').value.trim();
            const url = new URL(window.location.href);
            url.searchParams.set("search", query);
            url.searchParams.set("page", "1");
            window.location.href = url.toString();
        }

        function clearSearch() {
            const url = new URL(window.location.href);
            url.searchParams.delete("search");
            url.searchParams.set("page", "1");
            window.location.href = url.toString();
        }

        document.getElementById('offerSearch').addEventListener('keypress', (e) => {
            if (e.key === 'Enter') triggerSearch();
        });

        function switchTab(type) {
            const url = new URL(window.location.href);
            url.searchParams.set("type", type);
            url.searchParams.set("page", "1");
            window.location.href = url.toString();
        }

        async function deleteOffer(id, name) {
            const confirmed = await Swal.fire({
                title: `Remove ${name}?`,
                text: "This offer details will be permanently wiped.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#FF5A1F',
                cancelButtonColor: 'rgba(255,255,255,0.05)',
                confirmButtonText: 'Yes, delete it',
                background: '#121212',
                color: '#FFFFFF'
            });

            if (confirmed.isConfirmed) {
                try {
                    const response = await fetch(`/admin/offer/delete/${id}`, { method: 'DELETE' });
                    const res = await response.json();
                    if (res.success) {
                        Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: 'Offer removed', showConfirmButton: false, timer: 1500, background: '#121212', color: '#FFFFFF' });
                        setTimeout(() => location.reload(), 1500);
                    } else { throw new Error(res.message); }
                } catch (error) {
                    Swal.fire({ icon: 'error', title: 'Error', text: error.message });
                }
            }
        }
    </script>
</body>
</html>
