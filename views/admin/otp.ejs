<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/admin/head') %>
    <title>ZiGo Admin | OTP Verification</title>
    <style>
        .otp-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(25px);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 2.5rem;
            padding: 2.5rem;
            width: 100%;
            max-width: 450px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            text-align: center;
        }

        @media (min-width: 640px) {
            .otp-card {
                padding: 3.5rem;
            }
        }

        .glow {
            position: absolute;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(255, 90, 31, 0.08) 0%, transparent 70%);
            z-index: -1;
            filter: blur(40px);
        }

        .otp-field {
            width: 50px;
            height: 60px;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 1rem;
            font-size: 1.5rem;
            font-weight: 800;
            color: white;
            text-align: center;
            transition: all 0.3s ease;
            outline: none;
        }

        @media (min-width: 400px) {
            .otp-field {
                width: 60px;
                height: 70px;
            }
        }

        .otp-field:focus {
            background: rgba(255, 255, 255, 0.05);
            border-color: #FF5A1F;
        }
    </style>
</head>

<body class="bg-[#0F0F0F] min-h-screen flex items-center justify-center p-6 relative overflow-hidden">
    <div class="glow -top-48 -left-48"></div>
    <div class="glow -bottom-48 -right-48"></div>

    <div class="otp-card animate-in fade-in slide-in-from-bottom-5 duration-700">
        <div class="w-16 h-16 bg-orange-500/10 text-orange-500 rounded-2xl flex items-center justify-center text-xl mx-auto mb-8 shadow-inner">
            <i class="fas fa-shield-alt"></i>
        </div>

        <h1 class="text-3xl font-black tracking-tight text-white/90">
            Two-Step <span class="text-orange-500 italic">Verify</span>
        </h1>
        <p class="text-[10px] font-black uppercase tracking-[3px] text-white/20 mt-3 mb-8">Personnel Registry Authentication</p>

        <p class="text-white/40 text-xs leading-relaxed mb-8">
            Digital signature sent to authorized console <br>
            <span class="text-white/60 font-mono">admin@zigo.com</span>
        </p>

        <form action="/admin/otp-verify" method="POST" class="space-y-8">
            <div class="flex justify-center gap-3 sm:gap-4">
                <input type="text" name="otp1" maxlength="1" class="otp-field" autofocus>
                <input type="text" name="otp2" maxlength="1" class="otp-field">
                <input type="text" name="otp3" maxlength="1" class="otp-field">
                <input type="text" name="otp4" maxlength="1" class="otp-field">
            </div>

            <button type="submit" class="w-full bg-orange-500 hover:bg-orange-600 text-white py-5 rounded-2xl font-black text-xs uppercase tracking-[4px] transition-all shadow-xl shadow-orange-500/20 active:scale-[0.98]">
                Authenticate <i class="fas fa-chevron-right ml-2 text-[10px]"></i>
            </button>
        </form>

        <div class="mt-8 space-y-6">
            <p class="text-[10px] font-bold text-white/20 uppercase tracking-widest">
                No signal? <a href="/admin/resend-otp" class="text-orange-500 hover:underline">Re-broadcast</a>
            </p>
            
            <div class="pt-6 border-t border-white/5">
                <a href="/admin/login" class="text-[9px] font-black uppercase tracking-[3px] text-white/10 hover:text-white transition-colors">
                    <i class="fas fa-arrow-left mr-2"></i> Abort Mission
                </a>
            </div>
        </div>
    </div>

    <script>
        const inputs = document.querySelectorAll('.otp-field');
        inputs.forEach((input, index) => {
            input.addEventListener('input', (e) => {
                if (e.target.value.length === 1 && index < inputs.length - 1) {
                    inputs[index + 1].focus();
                }
            });

            input.addEventListener('keydown', (e) => {
                if (e.key === 'Backspace' && e.target.value.length === 0 && index > 0) {
                    inputs[index - 1].focus();
                }
            });
        });
    </script>
    <%- include('../partials/flashAlert') %>
</body>
</html>