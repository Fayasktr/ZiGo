<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/admin/head') %>
    <title>ZiGo Admin | Order Fulfillment</title>
</head>

<body>
    <!-- Sidebar -->
    <%- include('../partials/admin/sidebar', { activeTab: 'orders' }) %>

    <main class="admin-main">
        <%- include('../partials/admin/pageHeader', { title: 'Order', accentTitle: 'Fulfillment', subtitle: 'LOGISTICS' }) %>

        <div class="mb-8">
            <form action="/admin/orders" method="GET" class="flex flex-col md:flex-row items-center gap-4">
                <div class="relative w-full max-w-md">
                    <input type="text" name="search" placeholder="Search Order #..." value="<%= typeof search !== 'undefined' ? search : '' %>"
                        class="w-full bg-white/5 border border-white/10 px-12 py-4 rounded-2xl outline-none text-sm focus:border-orange-500 transition-all font-medium">
                    <i class="fas fa-search absolute left-5 top-1/2 -translate-y-1/2 text-orange-500"></i>
                </div>
                <% if (typeof status !== 'undefined') { %>
                    <input type="hidden" name="status" value="<%= status %>">
                <% } %>
                <button type="submit" class="w-full md:w-auto bg-orange-500 hover:bg-orange-600 px-8 py-4 rounded-2xl font-bold transition-all shadow-lg shadow-orange-500/20">
                    FIND ORDER
                </button>
            </form>
        </div>

        <div class="bg-white/5 border border-white/5 rounded-[2rem] p-4 sm:p-8">
            <% 
               const statuses = ['all','pending', 'processing', 'shipped', 'delivered', 'cancelled'];
               const currentStatus = (typeof status !== 'undefined' && status) ? status.toLowerCase() : 'all';
            %>
            <div class="flex flex-wrap gap-2 md:gap-8 border-b border-white/5 mb-8 overflow-x-auto no-scrollbar">
                <% statuses.forEach(s => { %>
                    <a href="/admin/orders?status=<%= s %>" class="pb-4 text-[10px] sm:text-xs font-black uppercase tracking-widest transition-all whitespace-nowrap <%= currentStatus === s ? 'text-orange-500 border-b-2 border-orange-500' : 'text-white/20 hover:text-white/60' %>">
                        <%= s %>
                    </a>
                <% }) %>
                <a href="/admin/orders?status=returns" class="pb-4 text-[10px] sm:text-xs font-black uppercase tracking-widest transition-all whitespace-nowrap <%= currentStatus === 'returns' ? 'text-orange-500 border-b-2 border-orange-500' : 'text-white/20 hover:text-white/60' %>">
                    Return Requests
                    <% if (typeof returnRequested !== 'undefined' && returnRequested.length > 0) { %>
                        <span class="ml-2 bg-red-500 text-white px-2 py-0.5 rounded-md text-[9px] shadow-lg shadow-red-500/20 animate-pulse"><%= returnRequested.length %></span>
                    <% } %>
                </a>
            </div>

            <div class="data-table-wrapper">
                <table class="w-full border-collapse">
                    <thead>
                        <tr class="text-left">
                            <th class="p-4 text-[10px] font-bold uppercase tracking-widest opacity-30">ID</th>
                            <th class="p-4 text-[10px] font-bold uppercase tracking-widest opacity-30">Customer</th>
                            <th class="p-4 text-[10px] font-bold uppercase tracking-widest opacity-30">Total</th>
                            <th class="p-4 text-[10px] font-bold uppercase tracking-widest opacity-30">Date</th>
                            <th class="p-4 text-[10px] font-bold uppercase tracking-widest opacity-30">Status</th>
                            <th class="p-4 text-[10px] font-bold uppercase tracking-widest opacity-30 text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-white/5">
                        <% 
                           let displayOrders = (typeof orders !== 'undefined' ? orders : []);
                           if (currentStatus === 'returns' && typeof returnRequested !== 'undefined') {
                               displayOrders = returnRequested;
                           }
                        %>
                        <% if (displayOrders.length > 0) { %>
                            <% displayOrders.forEach(order => { %>
                                <tr class="hover:bg-white/[0.02] transition-colors">
                                    <td class="p-4"><span class="font-bold text-white/90">#<%= order.orderNumber %></span></td>
                                    <td class="p-4">
                                        <div class="flex flex-col">
                                            <span class="font-bold text-sm text-white/80"><%= order.userId ? order.shippingAddress.fullName : 'Guest' %></span>
                                            <span class="text-[10px] opacity-40"><%= order.userId ? order.userId.email : 'N/A' %></span>
                                        </div>
                                    </td>
                                    <td class="p-4"><span class="font-black text-sm">₹<%= order.pricing.total.toLocaleString() %></span></td>
                                    <td class="p-4 text-xs text-white/50"><%= new Date(order.createdAt).toLocaleDateString() %></td>
                                    <td class="p-4">
                                        <% 
                                           const stClasses = {
                                               processing: 'bg-orange-500/10 text-orange-500',
                                               shipped: 'bg-blue-500/10 text-blue-500',
                                               delivered: 'bg-emerald-500/10 text-emerald-500',
                                               cancelled: 'bg-red-500/10 text-red-500',
                                               returned: 'bg-purple-500/10 text-purple-500',
                                               pending: 'bg-white/5 text-white/40'
                                           };
                                           const cls = stClasses[order.orderStatus.toLowerCase()] || stClasses.pending;
                                        %>
                                        <span class="px-3 py-1 rounded-full text-[9px] font-black uppercase tracking-widest <%= cls %>">
                                            <%= order.orderStatus %>
                                        </span>
                                    </td>
                                    <td class="p-4 text-right">
                                        <a href="/admin/orderDetails/<%= order._id %>" class="text-[10px] font-black uppercase tracking-widest text-orange-500 hover:text-white transition-all underline underline-offset-4"> Manage</a>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="p-20 text-center text-white/20 font-bold italic">No records found for this filter.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <%- include('../partials/admin/pagination.ejs') %>
        </div>
    </main>
    <%- include('../partials/flashAlert') %>
</body>
</html>
