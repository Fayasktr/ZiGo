<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/admin/head') %>
    <title>ZiGo Admin | <%= locals.offer ? 'Edit Offer' : 'Create New Offer' %></title>
</head>

<body>
    <!-- Sidebar -->
    <%- include('../partials/admin/sidebar', { activeTab: 'offers' }) %>

    <main class="admin-main">
        <%- include('../partials/admin/pageHeader', { title: (locals.offer ? 'Update' : 'Launch New'), accentTitle: 'Offer', subtitle: 'CAMPAIGN SETUP' }) %>

        <div class="max-w-3xl mx-auto">
            <form id="offerForm" action="<%= locals.offer ? `/admin/offer/edit/${offer._id}?_method=PUT` : '/admin/offer/add' %>" class="bg-white/5 border border-white/5 rounded-[2.5rem] p-6 lg:p-12 space-y-8 shadow-2xl relative overflow-hidden">
                <!-- Back Button -->
                <a href="/admin/offers" class="absolute top-6 left-6 text-white/20 hover:text-orange-500 transition-all">
                    <i class="fas fa-arrow-left"></i>
                </a>

                <div class="form-group">
                    <label class="block text-[10px] font-black uppercase tracking-widest opacity-20 mb-3">Campaign Name</label>
                    <input type="text" name="name" id="offerName" class="w-full bg-white/5 border border-white/10 p-4 rounded-2xl text-sm font-bold text-white outline-none focus:border-orange-500 transition-all" placeholder="e.g. Diwali Super Sale" value="<%= locals.offer ? offer.name : '' %>">
                    <p id="error-name" class="text-red-500 text-[10px] font-bold mt-2 hidden uppercase tracking-widest">Name Required</p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
                    <div class="form-group">
                        <label class="block text-[10px] font-black uppercase tracking-widest opacity-20 mb-3">Offer Type</label>
                        <select name="type" id="offerType" class="w-full bg-white/5 border border-white/10 p-4 rounded-2xl text-sm font-bold text-white outline-none focus:border-orange-500 transition-all [color-scheme:dark]" onchange="toggleTarget(this.value)">
                            <option value="category" <%= (locals.offer && offer.type === 'category') ? 'selected' : '' %>>Category Based</option>
                            <option value="product" <%= (locals.offer && offer.type === 'product') ? 'selected' : '' %>>Product Based</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="block text-[10px] font-black uppercase tracking-widest opacity-20 mb-3">Discount (%)</label>
                        <div class="relative">
                            <input type="number" name="discountValue" id="discountValue" class="w-full bg-white/5 border border-white/10 p-4 pr-12 rounded-2xl text-sm font-bold text-white outline-none focus:border-orange-500 transition-all" placeholder="10" value="<%= locals.offer ? offer.discountValue : '' %>">
                            <span class="absolute right-5 top-1/2 -translate-y-1/2 text-orange-500 font-black">%</span>
                        </div>
                        <p id="error-discount" class="text-red-500 text-[10px] font-bold mt-2 hidden uppercase tracking-widest">1-99 Range Required</p>
                    </div>
                </div>

                <div class="form-group" id="categoryTarget" style="display: <%= (locals.offer && offer.type === 'product') ? 'none' : 'block' %>">
                    <label class="block text-[10px] font-black uppercase tracking-widest opacity-20 mb-3">Target Category</label>
                    <select name="categoryId" id="categoryId" class="w-full bg-white/5 border border-white/10 p-4 rounded-2xl text-sm font-bold text-white outline-none focus:border-orange-500 transition-all [color-scheme:dark]">
                        <option value="">-- Choose Category --</option>
                        <% if(locals.categories) { %>
                            <% categories.forEach(cat => { %>
                                <option value="<%= cat._id %>" <%= (locals.offer && String(offer.categoryId) === String(cat._id)) ? 'selected' : '' %>><%= cat.categoryName %></option>
                            <% }) %>
                        <% } %>
                    </select>
                    <p id="error-category" class="text-red-500 text-[10px] font-bold mt-2 hidden uppercase tracking-widest">Select category</p>
                </div>

                <div class="form-group" id="productTarget" style="display: <%= (locals.offer && offer.type === 'product') ? 'block' : 'none' %>">
                    <label class="block text-[10px] font-black uppercase tracking-widest opacity-20 mb-3">Target Product</label>
                    <select name="productId" id="productId" class="w-full bg-white/5 border border-white/10 p-4 rounded-2xl text-sm font-bold text-white outline-none focus:border-orange-500 transition-all [color-scheme:dark]">
                        <option value="">-- Choose Product --</option>
                        <% if(locals.products) { %>
                            <% products.forEach(prod => { %>
                                <option value="<%= prod._id %>" <%= (locals.offer && String(offer.productId) === String(prod._id)) ? 'selected' : '' %>><%= prod.productName %></option>
                            <% }) %>
                        <% } %>
                    </select>
                    <p id="error-product" class="text-red-500 text-[10px] font-bold mt-2 hidden uppercase tracking-widest">Select product</p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
                    <div class="form-group">
                        <label class="block text-[10px] font-black uppercase tracking-widest opacity-20 mb-3">Expiry Date</label>
                        <input type="date" name="expireAt" id="expireAt" class="w-full bg-white/5 border border-white/10 p-4 rounded-2xl text-sm font-bold text-white outline-none focus:border-orange-500 transition-all [color-scheme:dark]" value="<%= locals.offer ? new Date(offer.expireAt).toISOString().split('T')[0] : '' %>">
                        <p id="error-expiry" class="text-red-500 text-[10px] font-bold mt-2 hidden uppercase tracking-widest">Date Required</p>
                    </div>
                    
                    <div class="form-group">
                        <label class="block text-[10px] font-black uppercase tracking-widest opacity-20 mb-3">Campaign Status</label>
                        <input type="hidden" name="isActive" id="isActiveInput" value="<%= (!locals.offer || offer.isActive) ? 'true' : 'false' %>">
                        <button type="button" onclick="toggleStatus()" id="statusToggleBtn" class="w-full p-4 rounded-2xl font-black text-[10px] uppercase tracking-[2px] border transition-all flex items-center justify-center gap-3 <%= (!locals.offer || offer.isActive) ? 'bg-emerald-500/10 text-emerald-500 border-emerald-500/20' : 'bg-red-500/10 text-red-500 border-red-500/20' %>">
                            <i class="fas <%= (!locals.offer || offer.isActive) ? 'fa-check-circle' : 'fa-times-circle' %>"></i>
                            <span id="statusText"><%= (!locals.offer || offer.isActive) ? 'Strategy Active' : 'Strategy Paused' %></span>
                        </button>
                    </div>
                </div>

                <button type="submit" class="w-full bg-gradient-to-r from-orange-500 to-orange-600 hover:scale-[1.01] active:scale-[0.99] text-white py-5 rounded-2xl font-black text-sm uppercase tracking-[4px] transition-all shadow-xl shadow-orange-500/20">
                    <%= locals.offer ? 'Push Update' : 'Finalize & Launch' %>
                </button>
            </form>
        </div>
    </main>

    <script>
        function toggleTarget(type) {
            const catGroup = document.getElementById('categoryTarget');
            const prodGroup = document.getElementById('productTarget');
            const catSelect = document.getElementById('categoryId');
            const prodSelect = document.getElementById('productId');

            if (type === 'category') {
                catGroup.style.display = 'block';
                prodGroup.style.display = 'none';
                catSelect.disabled = false;
                prodSelect.disabled = true;
            } else {
                catGroup.style.display = 'none';
                prodGroup.style.display = 'block';
                catSelect.disabled = true;
                prodSelect.disabled = false;
            }
        }

        function toggleStatus() {
            const input = document.getElementById('isActiveInput');
            const btn = document.getElementById('statusToggleBtn');
            const icon = btn.querySelector('i');
            const text = document.getElementById('statusText');
            
            const newState = input.value === 'false';
            input.value = newState;

            if (newState) {
                btn.className = 'w-full p-4 rounded-2xl font-black text-[10px] uppercase tracking-[2px] border transition-all flex items-center justify-center gap-3 bg-emerald-500/10 text-emerald-500 border-emerald-500/20';
                icon.className = 'fas fa-check-circle';
                text.innerText = 'Strategy Active';
            } else {
                btn.className = 'w-full p-4 rounded-2xl font-black text-[10px] uppercase tracking-[2px] border transition-all flex items-center justify-center gap-3 bg-red-500/10 text-red-500 border-red-500/20';
                icon.className = 'fas fa-times-circle';
                text.innerText = 'Strategy Paused';
            }
        }

        document.getElementById('offerForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            let hasError = false;
            const name = document.getElementById('offerName').value.trim();
            const type = document.getElementById('offerType').value;
            const discount = parseFloat(document.getElementById('discountValue').value);
            const expiry = document.getElementById('expireAt').value;
            
            document.querySelectorAll('[id^="error-"]').forEach(el => el.classList.add('hidden'));

            if (!name) { document.getElementById('error-name').classList.remove('hidden'); hasError = true; }
            if (isNaN(discount) || discount <= 0 || discount >= 100) { document.getElementById('error-discount').classList.remove('hidden'); hasError = true; }
            if (!expiry) { document.getElementById('error-expiry').classList.remove('hidden'); hasError = true; }
            
            if (type === 'category') {
                if (!document.getElementById('categoryId').value) { document.getElementById('error-category').classList.remove('hidden'); hasError = true; }
            } else {
                if (!document.getElementById('productId').value) { document.getElementById('error-product').classList.remove('hidden'); hasError = true; }
            }

            if (hasError) return;

            try {
                const formData = new FormData(this);
                const data = Object.fromEntries(formData.entries());
                data.isActive = document.getElementById('isActiveInput').value === 'true';
                const method = this.action.includes('_method=PUT') ? 'PUT' : 'POST';

                const response = await fetch(this.action, {
                    method: method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await response.json();
                if (result.success) {
                    Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: 'Strategy Synced', showConfirmButton: false, timer: 1500, background: '#121212', color: '#fff' });
                    setTimeout(() => window.location.href = '/admin/offers', 1500);
                } else { throw new Error(result.message); }
            } catch (error) {
                Swal.fire({ icon: 'error', title: 'Sync Error', text: error.message, background: '#121212', color: '#fff' });
            }
        });
    </script>
</body>
</html>
