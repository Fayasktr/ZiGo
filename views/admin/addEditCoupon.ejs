<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/admin/head') %>
    <title>ZiGo Admin | <%= locals.coupon ? 'Edit Coupon' : 'Add New Coupon' %></title>
</head>

<body>
    <!-- Sidebar -->
    <%- include('../partials/admin/sidebar', { activeTab: 'coupons' }) %>

    <main class="admin-main">
        <%- include('../partials/admin/pageHeader', { title: (locals.coupon ? 'Edit' : 'Create'), accentTitle: 'Campaign', subtitle: 'CAMPAIGN CENTER' }) %>

        <form class="bg-white/5 border border-white/5 rounded-[2.5rem] p-6 lg:p-12 max-w-4xl mx-auto space-y-8" id="couponForm" action="<%= locals.coupon ? '/admin/editCoupon/' + coupon._id + '?_method=PUT' : '/admin/coupon/add' %>" method="POST">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <!-- Left Column -->
                <div class="space-y-6">
                    <div class="form-group">
                        <label class="block text-[10px] font-black uppercase tracking-widest opacity-20 mb-3">Coupon Code</label>
                        <input type="text" name="code" id="couponCode" class="w-full bg-white/5 border border-white/10 p-4 rounded-2xl text-sm font-black text-white outline-none focus:border-orange-500 transition-all uppercase tracking-[2px]" placeholder="e.g. SUMMER20" value="<%= locals.coupon ? coupon.code : '' %>">
                        <p id="error-code" class="text-red-500 text-[10px] font-bold mt-2 hidden uppercase tracking-widest">Code Required</p>
                    </div>

                    <div class="form-group">
                        <label class="block text-[10px] font-black uppercase tracking-widest opacity-20 mb-3">Discount Structure</label>
                        <div class="flex flex-col sm:flex-row gap-3">
                            <input type="hidden" name="discountType" id="discountType" value="<%= (locals.coupon && coupon.discountType) ? coupon.discountType : 'percentage' %>">
                            <button type="button" class="discount-type-btn flex-1 px-6 py-4 rounded-2xl text-[10px] font-black uppercase tracking-widest transition-all border <%= (!locals.coupon || coupon.discountType === 'percentage') ? 'bg-orange-500/10 text-orange-500 border-orange-500/20' : 'bg-white/5 text-white/20 border-white/5' %>" onclick="setType(this, 'percentage')">Percentage (%)</button>
                            <button type="button" class="discount-type-btn flex-1 px-6 py-4 rounded-2xl text-[10px] font-black uppercase tracking-widest transition-all border <%= (locals.coupon && coupon.discountType === 'fixed') ? 'bg-orange-500/10 text-orange-500 border-orange-500/20' : 'bg-white/5 text-white/20 border-white/5' %>" onclick="setType(this, 'fixed')">Flat Amount (₹)</button>
                        </div>
                    </div>

                    <div id="percentageGroup" style="<%= (!locals.coupon || coupon.discountType === 'percentage') ? '' : 'display: none;' %>">
                        <label class="block text-[10px] font-black uppercase tracking-widest opacity-20 mb-3">Discount Percentage (%)</label>
                        <input type="number" id="percentageInput" name="<%= (!locals.coupon || coupon.discountType === 'percentage') ? 'discountValue' : '' %>" class="w-full bg-white/5 border border-white/10 p-4 rounded-2xl text-sm font-bold text-white outline-none focus:border-orange-500 transition-all" placeholder="1 to 100" min="1" max="100" value="<%= (locals.coupon && coupon.discountType === 'percentage') ? coupon.discountValue : '' %>">
                        <p id="error-percentage" class="text-red-500 text-[10px] font-bold mt-2 hidden uppercase tracking-widest">Invalid Percentage</p>
                    </div>

                    <div id="fixedGroup" style="<%= (locals.coupon && coupon.discountType === 'fixed') ? '' : 'display: none;' %>">
                        <label class="block text-[10px] font-black uppercase tracking-widest opacity-20 mb-3">Reward Amount (₹)</label>
                        <input type="number" id="fixedInput" name="<%= (locals.coupon && coupon.discountType === 'fixed') ? 'discountValue' : '' %>" class="w-full bg-white/5 border border-white/10 p-4 rounded-2xl text-sm font-bold text-white outline-none focus:border-orange-500 transition-all" placeholder="e.g. 500" value="<%= (locals.coupon && coupon.discountType === 'fixed') ? coupon.discountValue : '' %>">
                        <p id="error-fixed" class="text-red-500 text-[10px] font-bold mt-2 hidden uppercase tracking-widest">Invalid Amount</p>
                    </div>

                    <div id="maxDiscountGroup" style="<%= (locals.coupon && coupon.discountType === 'fixed') ? 'display: none;' : '' %>">
                        <label class="block text-[10px] font-black uppercase tracking-widest opacity-20 mb-3">Max Discount Amount (₹)</label>
                        <input type="number" name="maxDiscount" class="w-full bg-white/5 border border-white/10 p-4 rounded-2xl text-sm font-bold text-white outline-none focus:border-orange-500 transition-all" placeholder="Cap the savings" value="<%= locals.coupon ? coupon.maxDiscount : '' %>">
                    </div>
                </div>

                <!-- Right Column -->
                <div class="space-y-6">
                    <div class="form-group">
                        <label class="block text-[10px] font-black uppercase tracking-widest opacity-20 mb-3">Expiration Timeline</label>
                        <input type="date" name="expiresAt" id="expiresAt" class="w-full bg-white/5 border border-white/10 p-4 rounded-2xl text-sm font-bold text-white outline-none focus:border-orange-500 transition-all [color-scheme:dark]" value="<%= (locals.coupon && coupon.expiresAt) ? new Date(coupon.expiresAt).toISOString().split('T')[0] : '' %>">
                        <p id="error-expiresAt" class="text-red-500 text-[10px] font-bold mt-2 hidden uppercase tracking-widest">Date Required</p>
                    </div>

                    <div class="form-group">
                        <label class="block text-[10px] font-black uppercase tracking-widest opacity-20 mb-3">Global usage limit</label>
                        <input type="number" name="usageLimit" class="w-full bg-white/5 border border-white/10 p-4 rounded-2xl text-sm font-bold text-white outline-none focus:border-orange-500 transition-all" placeholder="default: 100" value="<%= locals.coupon ? coupon.usageLimit : '' %>">
                    </div>

                    <div class="form-group">
                        <label class="block text-[10px] font-black uppercase tracking-widest opacity-20 mb-3">Minimum Transaction (₹)</label>
                        <input type="number" name="minOrderAmount" class="w-full bg-white/5 border border-white/10 p-4 rounded-2xl text-sm font-bold text-white outline-none focus:border-orange-500 transition-all" placeholder="default: 1500" value="<%= locals.coupon ? coupon.minOrderAmount : '' %>">
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="block text-[10px] font-black uppercase tracking-widest opacity-20 mb-3">Strategic Description</label>
                <textarea name="description" id="description" class="w-full bg-white/5 border border-white/10 p-5 rounded-2xl text-sm font-bold text-white outline-none focus:border-orange-500 transition-all h-24 resize-none" placeholder="Analytics label..."><%= locals.coupon ? coupon.description : '' %></textarea>
                <p id="error-description" class="text-red-500 text-[10px] font-bold mt-2 hidden uppercase tracking-widest">Description Required</p>
            </div>

            <div class="flex items-center gap-4 bg-white/10 p-6 rounded-3xl border border-white/5">
                <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" name="isActive" <%= (!locals.coupon || coupon.isActive) ? 'checked' : '' %> class="sr-only peer">
                    <div class="w-11 h-6 bg-white/10 rounded-full peer peer-checked:bg-orange-500 after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:after:translate-x-full"></div>
                </label>
                <div>
                    <p class="text-sm font-black text-white/90">Campaign Active Status</p>
                    <p class="text-[9px] font-black uppercase tracking-widest text-white/20 italic">Enable for immediate use</p>
                </div>
            </div>

            <button type="submit" class="w-full bg-gradient-to-r from-orange-500 to-orange-600 hover:scale-[1.01] active:scale-[0.99] text-white py-5 rounded-2xl font-black text-sm uppercase tracking-[4px] transition-all shadow-xl shadow-orange-500/20">
                <%= locals.coupon ? 'Push Update' : 'Initialize & Launch' %>
            </button>
        </form>
    </main>

    <script>
        function setType(el, type) {
            document.querySelectorAll('.discount-type-btn').forEach(btn => {
                btn.classList.remove('bg-orange-500/10', 'text-orange-500', 'border-orange-500/20');
                btn.classList.add('bg-white/5', 'text-white/20', 'border-white/5');
            });
            el.classList.add('bg-orange-500/10', 'text-orange-500', 'border-orange-500/20');
            el.classList.remove('bg-white/5', 'text-white/20', 'border-white/5');
            document.getElementById('discountType').value = type;
            
            const percGroup = document.getElementById('percentageGroup');
            const fixedGroup = document.getElementById('fixedGroup');
            const maxGroup = document.getElementById('maxDiscountGroup');
            const percInput = document.getElementById('percentageInput');
            const fixedInput = document.getElementById('fixedInput');
            
            if(type === 'percentage'){
                percGroup.style.display = 'block';
                fixedGroup.style.display = 'none';
                maxGroup.style.display = 'block';
                percInput.name = 'discountValue';
                fixedInput.name = '';
            } else {
                percGroup.style.display = 'none';
                fixedGroup.style.display = 'block';
                maxGroup.style.display = 'none';
                percInput.name = '';
                fixedInput.name = 'discountValue';
            }
        }

        document.getElementById('couponForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            let hasError = false;
            const typeValue = document.getElementById('discountType').value;
            const codeValue = document.getElementById('couponCode').value.trim();
            const expiresValue = document.getElementById('expiresAt').value;
            const descValue = document.getElementById('description').value.trim();
            
            document.querySelectorAll('[id^="error-"]').forEach(el => el.classList.add('hidden'));

            if (!codeValue) { document.getElementById('error-code').classList.remove('hidden'); hasError = true; }
            if (typeValue === 'percentage') {
                const val = parseFloat(document.getElementById('percentageInput').value);
                if (isNaN(val) || val <= 0 || val > 100) { document.getElementById('error-percentage').classList.remove('hidden'); hasError = true; }
            } else {
                const val = parseFloat(document.getElementById('fixedInput').value);
                if (isNaN(val) || val <= 0) { document.getElementById('error-fixed').classList.remove('hidden'); hasError = true; }
            }
            if (!expiresValue) { document.getElementById('error-expiresAt').classList.remove('hidden'); hasError = true; }
            if (!descValue) { document.getElementById('error-description').classList.remove('hidden'); hasError = true; }

            if (hasError) return;

            try {
                const formData = new FormData(this);
                const data = Object.fromEntries(formData.entries());
                data.isActive = this.querySelector('input[name="isActive"]').checked;
                const method = this.action.includes('_method=PUT') ? 'PUT' : 'POST';

                const response = await fetch(this.action, {
                    method: method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await response.json();
                if (result.success) {
                    Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: 'Campaign Synced', showConfirmButton: false, timer: 1500, background: '#121212', color: '#fff' });
                    setTimeout(() => window.location.href = '/admin/coupons', 1500);
                } else { throw new Error(result.message); }
            } catch (error) {
                Swal.fire({ icon: 'error', title: 'Strategy Error', text: error.message, background: '#121212', color: '#fff' });
            }
        });
    </script>
</body>
</html>
