<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/admin/head') %>
    <title>ZiGo Admin | Sales Overview</title>
</head>

<body>
    <!-- Sidebar -->
    <%- include('../partials/admin/sidebar', { activeTab: 'reports' }) %>

    <main class="admin-main">
        <%- include('../partials/admin/pageHeader', { title: 'Sales', accentTitle: 'Overview', subtitle: 'ANALYTICS' }) %>

        <div class="flex flex-col xl:flex-row justify-between items-start xl:items-center gap-6 mb-10">
            <div class="flex flex-wrap gap-2 sm:gap-3 items-center">
                <button class="filter-btn px-4 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all active bg-orange-500 text-white" data-period="today">Today</button>
                <button class="filter-btn px-4 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all text-white/20 hover:text-white/40" data-period="week">Week</button>
                <button class="filter-btn px-4 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all text-white/20 hover:text-white/40" data-period="month">Month</button>
                <button class="filter-btn px-4 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all text-white/20 hover:text-white/40" data-period="year">Year</button>
                
                <div class="flex items-center gap-2 bg-white/5 border border-white/5 rounded-xl px-3 py-2 ml-auto xl:ml-0">
                    <input type="date" id="startDate" class="bg-transparent text-[10px] text-white/60 outline-none border-none [color-scheme:dark]">
                    <span class="text-white/10 text-[10px]">to</span>
                    <input type="date" id="endDate" class="bg-transparent text-[10px] text-white/60 outline-none border-none [color-scheme:dark]">
                    <button onclick="applyCustomRange()" class="ml-2 text-orange-500 hover:text-white transition-colors">
                        <i class="fas fa-arrow-right text-xs"></i>
                    </button>
                </div>
            </div>

            <div class="flex gap-3 w-full xl:w-auto">
                <button onclick="exportReport('pdf')" class="flex-1 xl:flex-none flex items-center justify-center gap-2 bg-white/5 border border-white/5 hover:bg-white/10 px-6 py-4 rounded-2xl text-[10px] font-black uppercase tracking-widest transition-all">
                    <i class="fas fa-file-pdf text-red-500"></i> PDF
                </button>
                <button onclick="exportReport('excel')" class="flex-1 xl:flex-none flex items-center justify-center gap-2 bg-white/5 border border-white/5 hover:bg-white/10 px-6 py-4 rounded-2xl text-[10px] font-black uppercase tracking-widest transition-all">
                    <i class="fas fa-file-excel text-emerald-500"></i> EXCEL
                </button>
            </div>
        </div>

        <!-- Metrics Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
            <div class="bg-white/5 border border-white/5 rounded-[2rem] p-8 group hover:border-orange-500/20 transition-all">
                <p class="text-[9px] font-black uppercase tracking-widest opacity-20 mb-2">Total Revenue</p>
                <p class="text-2xl font-black text-white/90 mb-4" id="totalRevenue">₹0</p>
                <div class="h-1 w-full bg-white/5 rounded-full overflow-hidden">
                    <div class="h-full bg-orange-500 w-[75%] rounded-full shadow-[0_0_10px_rgba(255,90,31,0.5)]"></div>
                </div>
            </div>
            <div class="bg-white/5 border border-white/5 rounded-[2rem] p-8 group hover:border-blue-500/20 transition-all">
                <p class="text-[9px] font-black uppercase tracking-widest opacity-20 mb-2">Total Orders</p>
                <p class="text-2xl font-black text-white/90 mb-4" id="totalOrders">0</p>
                <div class="h-1 w-full bg-white/5 rounded-full overflow-hidden">
                    <div class="h-full bg-blue-500 w-[60%] rounded-full shadow-[0_0_10px_rgba(59,130,246,0.5)]"></div>
                </div>
            </div>
            <div class="bg-white/5 border border-white/5 rounded-[2rem] p-8 group hover:border-emerald-500/20 transition-all">
                <p class="text-[9px] font-black uppercase tracking-widest opacity-20 mb-2">Avg. Order Value</p>
                <p class="text-2xl font-black text-white/90 mb-4" id="avgOrderValue">₹0</p>
                <div class="h-1 w-full bg-white/5 rounded-full overflow-hidden">
                    <div class="h-full bg-emerald-500 w-[85%] rounded-full shadow-[0_0_10px_rgba(34,197,94,0.5)]"></div>
                </div>
            </div>
            <div class="bg-white/5 border border-white/5 rounded-[2rem] p-8 group hover:border-purple-500/20 transition-all">
                <p class="text-[9px] font-black uppercase tracking-widest opacity-20 mb-2">Items Sold</p>
                <p class="text-2xl font-black text-white/90 mb-4" id="totalItemsSold">0</p>
                <div class="h-1 w-full bg-white/5 rounded-full overflow-hidden">
                    <div class="h-full bg-purple-500 w-[45%] rounded-full shadow-[0_0_10px_rgba(168,85,247,0.5)]"></div>
                </div>
            </div>
        </div>

        <!-- Charts Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-12">
            <div class="lg:col-span-2 bg-white/5 border border-white/5 rounded-[2.5rem] p-8">
                <h2 class="text-xl font-black mb-1">Sales Stream</h2>
                <p class="text-[10px] font-bold opacity-20 uppercase tracking-widest mb-10">Performance for current range</p>
                <div class="h-[300px]">
                    <canvas id="salesChart"></canvas>
                </div>
            </div>
            <div class="bg-white/5 border border-white/5 rounded-[2.5rem] p-8 flex flex-col">
                <h2 class="text-xl font-black mb-10">Market Share</h2>
                <div class="h-48 relative mb-10">
                    <canvas id="categoryChart"></canvas>
                </div>
                <div class="mt-auto space-y-3" id="categoryBreakdown">
                    <!-- Dynamic Categories -->
                </div>
            </div>
        </div>

        <!-- Top Selling Products -->
        <div class="bg-white/5 border border-white/5 rounded-[2.5rem] p-4 sm:p-8">
            <h2 class="text-xl font-black mb-1">Top Selling Products</h2>
            <p class="text-[10px] font-bold opacity-20 uppercase tracking-widest mb-8">Performance leaders by volume and value</p>
            
            <div class="data-table-wrapper">
                <table class="w-full border-collapse">
                    <thead>
                        <tr class="text-left font-bold text-[10px] uppercase tracking-widest opacity-30 border-b border-white/5">
                            <th class="p-4">Product Name</th>
                            <th class="p-4">Category</th>
                            <th class="p-4">Units Sold</th>
                            <th class="p-4">Revenue</th>
                            <th class="p-4">Current Stock</th>
                        </tr>
                    </thead>
                    <tbody id="topSellingTableBody" class="divide-y divide-white/5 text-sm font-medium text-white/80">
                        <!-- Dynamic Rows -->
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <script>
        let salesChart, categoryChart;
        let currentPeriod = 'today';
        let currentStartDate = null;
        let currentEndDate = null;

        document.addEventListener('DOMContentLoaded', () => {
            initCharts();
            fetchReportData('today');

            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    document.querySelectorAll('.filter-btn').forEach(b => {
                        b.classList.remove('active', 'bg-orange-500', 'text-white');
                        b.classList.add('text-white/20', 'hover:text-white/40');
                    });
                    btn.classList.add('active', 'bg-orange-500', 'text-white');
                    btn.classList.remove('text-white/20', 'hover:text-white/40');
                    const period = btn.getAttribute('data-period');
                    if(period) fetchReportData(period);
                });
            });
        });

        function initCharts() {
            const salesCtx = document.getElementById('salesChart').getContext('2d');
            salesChart = new Chart(salesCtx, {
                type: 'line',
                data: {
                    labels: [],
                    datasets: [{
                        label: 'Revenue',
                        data: [],
                        borderColor: '#FF5A1F',
                        borderWidth: 4,
                        pointBackgroundColor: '#FF5A1F',
                        pointBorderColor: '#000',
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        tension: 0.4,
                        fill: true,
                        backgroundColor: (context) => {
                            const ctx = context.chart.ctx;
                            const gradient = ctx.createLinearGradient(0, 0, 0, 400);
                            gradient.addColorStop(0, 'rgba(255, 90, 31, 0.2)');
                            gradient.addColorStop(1, 'rgba(255, 90, 31, 0)');
                            return gradient;
                        }
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { 
                            beginAtZero: true, 
                            grid: { color: 'rgba(255,255,255,0.02)' }, 
                            ticks: { 
                                color: 'rgba(255,255,255,0.2)',
                                font: { size: 10, weight: 'bold' },
                                callback: val => '₹' + (val >= 1000 ? (val/1000)+'k' : val)
                            } 
                        },
                        x: { 
                            grid: { display: false }, 
                            ticks: { 
                                color: 'rgba(255,255,255,0.2)',
                                font: { size: 10, weight: 'bold' }
                            } 
                        }
                    }
                }
            });

            const categoryCtx = document.getElementById('categoryChart').getContext('2d');
            categoryChart = new Chart(categoryCtx, {
                type: 'doughnut',
                data: {
                    labels: [],
                    datasets: [{
                        data: [],
                        backgroundColor: ['#FF5A1F', '#3B82F6', '#10B981', '#A855F7', '#EC4899', '#F59E0B'],
                        borderWidth: 0,
                        hoverOffset: 15
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '80%',
                    plugins: { legend: { display: false } }
                }
            });
        }

        async function fetchReportData(period, start = null, end = null) {
            try {
                currentPeriod = period;
                currentStartDate = start;
                currentEndDate = end;

                const query = new URLSearchParams({ period });
                if (start) query.append('startDate', start);
                if (end) query.append('endDate', end);

                const response = await fetch(`/admin/api/reportData?${query.toString()}`);
                const result = await response.json();

                if (result.success) updateDashboard(result.data);
            } catch (error) { console.error('Fetch Error:', error); }
        }

        function applyCustomRange() {
            const start = document.getElementById('startDate').value;
            const end = document.getElementById('endDate').value;
            if (!start || !end) {
                Swal.fire({ icon: 'warning', title: 'Missing Dates', text: 'Select both start and end dates' });
                return;
            }
            fetchReportData('custom', start, end);
        }

        function updateDashboard(data) {
            const { metrics, salesOverTime, topProducts, categoryWiseSales } = data;

            document.getElementById('totalRevenue').innerText = `₹${Math.round(metrics.totalRevenue).toLocaleString()}`;
            document.getElementById('totalOrders').innerText = metrics.totalOrders;
            document.getElementById('avgOrderValue').innerText = `₹${Math.round(metrics.avgOrderValue).toLocaleString()}`;
            document.getElementById('totalItemsSold').innerText = metrics.totalItemsSold;

            salesChart.data.labels = salesOverTime.map(d => d.date);
            salesChart.data.datasets[0].data = salesOverTime.map(d => d.revenue);
            salesChart.update();

            categoryChart.data.labels = categoryWiseSales.map(c => c.category || 'Other');
            categoryChart.data.datasets[0].data = categoryWiseSales.map(c => c.revenue);
            categoryChart.update();

            const breakdownHtml = categoryWiseSales.map((c, i) => `
                <div class="flex justify-between items-center bg-white/[0.02] p-4 rounded-2xl border border-white/5">
                    <div class="flex items-center gap-3">
                        <div class="w-1.5 h-1.5 rounded-full" style="background: ${categoryChart.data.datasets[0].backgroundColor[i % 6]}"></div>
                        <span class="text-[10px] font-black uppercase tracking-widest text-white/60">${c.category || 'Other'}</span>
                    </div>
                    <span class="text-xs font-black text-white/90">₹${Math.round(c.revenue).toLocaleString()}</span>
                </div>
            `).join('');
            document.getElementById('categoryBreakdown').innerHTML = breakdownHtml;

            const tableBody = document.getElementById('topSellingTableBody');
            tableBody.innerHTML = topProducts.map(p => `
                <tr class="group hover:bg-white/[0.01] transition-colors">
                    <td class="p-4">
                        <div class="flex items-center gap-4">
                            <div class="w-10 h-10 rounded-xl bg-black flex items-center justify-center p-1.5 border border-white/5">
                                <img src="${p.image || '/public/landing/no-image.png'}" alt="" class="max-w-full max-h-full object-contain">
                            </div>
                            <span class="font-bold text-white/90">${p.productName}</span>
                        </div>
                    </td>
                    <td class="p-4 text-[10px] font-black uppercase tracking-widest text-white/30">${p.category || 'Uncategorized'}</td>
                    <td class="p-4 font-black">${p.unitsSold}</td>
                    <td class="p-4 text-orange-500 font-extrabold text-sm">₹${Math.round(p.revenue).toLocaleString()}</td>
                    <td class="p-4">
                        <div class="flex items-center gap-3">
                            <span class="font-black text-xs">${p.stock}</span>
                            <span class="px-2 py-0.5 ${p.stock > 0 ? 'text-emerald-500 bg-emerald-500/10' : 'text-red-500 bg-red-500/10'} text-[8px] font-black rounded-md uppercase tracking-widest">
                                ${p.stock > 0 ? 'AVAILABLE' : 'OUT'}
                            </span>
                        </div>
                    </td>
                </tr>
            `).join('');
        }

        function exportReport(format) {
            const query = new URLSearchParams({ period: currentPeriod });
            if (currentStartDate) query.append('startDate', currentStartDate);
            if (currentEndDate) query.append('endDate', currentEndDate);
            
            Swal.fire({
                title: `Export ${format.toUpperCase()}?`,
                text: "Generating detailed analytical report...",
                background: '#121212',
                color: '#fff',
                confirmButtonColor: '#FF5A1F',
                showCancelButton: true,
                confirmButtonText: 'Start Download'
            }).then(result => {
                if(result.isConfirmed) window.location.href = `/export/${format}?${query.toString()}`;
            });
        }
    </script>
    <%- include('../partials/flashAlert') %>
</body>
</html>
