<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/admin/head') %>
    <title>ZiGo Admin | <%= banner ? 'Edit' : 'Add' %> Banner</title>
</head>

<body>
    <!-- Sidebar -->
    <%- include('../partials/admin/sidebar', { activeTab: 'banners' }) %>

    <main class="admin-main">
        <%- include('../partials/admin/pageHeader', { title: (banner ? 'Edit' : 'Add New'), accentTitle: 'Banner', subtitle: 'VISUAL ASSETS' }) %>

        <form id="bannerForm" class="bg-white/5 border border-white/5 rounded-[2.5rem] p-6 lg:p-12 space-y-10 max-w-5xl mx-auto shadow-2xl relative overflow-hidden" onsubmit="handleFormSubmit(event)">
            <input type="hidden" name="id" value="<%= banner ? banner._id : '' %>">
            
            <div class="grid grid-cols-1 lg:grid-cols-5 gap-10">
                <!-- Left Column (Visuals) -->
                <div class="lg:col-span-2 space-y-6">
                    <label class="block text-[10px] font-black uppercase tracking-widest opacity-20 mb-3">Banner Visual</label>
                    <div class="group relative bg-black/40 border-2 border-dashed border-white/10 rounded-3xl overflow-hidden cursor-pointer hover:border-orange-500/50 transition-all aspect-[4/3] flex flex-col items-center justify-center p-4" onclick="document.getElementById('file-input').click()">
                        <img id="preview-img" src="<%= banner ? banner.image : '/public/public/placeholder-banner.png' %>" alt="Preview" class="max-w-full max-h-full object-contain rounded-xl <%= banner ? '' : 'opacity-20' %> transition-all duration-500 group-hover:scale-105">
                        
                        <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity flex flex-col items-center justify-center gap-3 backdrop-blur-sm">
                            <i class="fas fa-camera text-2xl text-orange-500"></i>
                            <span class="text-[10px] font-black uppercase tracking-[2px] text-white">Click to <%= banner ? 'Replace' : 'Upload' %></span>
                        </div>
                        <input type="file" id="file-input" name="image" class="hidden" accept="image/*" onchange="previewFile()">
                    </div>
                    <p id="error-image" class="text-red-500 text-[10px] font-bold mt-2 hidden uppercase tracking-widest">Image Required</p>
                    
                    <div class="bg-white/5 p-4 rounded-2xl border border-white/5">
                        <p class="text-[9px] font-black uppercase tracking-widest text-white/20 mb-2 italic">Architecture Recommendation</p>
                        <p class="text-[10px] text-white/40 leading-relaxed font-bold">HERO: 1920x600px <br> PROMO: 1200x400px</p>
                    </div>
                </div>

                <!-- Right Column (Configuration) -->
                <div class="lg:col-span-3 space-y-8">
                    <div class="form-group">
                        <label class="block text-[10px] font-black uppercase tracking-widest opacity-20 mb-3">Main Title</label>
                        <input type="text" id="bannerName" name="name" class="w-full bg-white/5 border border-white/10 p-4 rounded-2xl text-sm font-bold text-white outline-none focus:border-orange-500 transition-all" placeholder="e.g. Neo 1 Launch" value="<%= banner ? banner.name : '' %>">
                        <p id="error-name" class="text-red-500 text-[10px] font-bold mt-2 hidden uppercase tracking-widest">Title Required</p>
                    </div>

                    <div class="form-group">
                        <label class="block text-[10px] font-black uppercase tracking-widest opacity-20 mb-3">Target Slot / Position</label>
                        <select name="slot" class="w-full bg-white/5 border border-white/10 p-4 rounded-2xl text-sm font-bold text-white outline-none focus:border-orange-500 transition-all [color-scheme:dark]">
                            <option value="Hero Slider #1" <%= banner && banner.slot === 'Hero Slider #1' ? 'selected' : '' %>>Hero Slider #1 (Main Landing)</option>
                            <option value="Hero Slider #2" <%= banner && banner.slot === 'Hero Slider #2' ? 'selected' : '' %>>Hero Slider #2 (Main Landing)</option>
                            <option value="Mid-Page Promo" <%= banner && banner.slot === 'Mid-Page Promo' ? 'selected' : '' %>>Mid-Page Promo (Large)</option>
                            <option value="Side-Widget" <%= banner && banner.slot === 'Side-Widget' ? 'selected' : '' %>>Side-Widget Promo (Small)</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="block text-[10px] font-black uppercase tracking-widest opacity-20 mb-3">Creative Description</label>
                        <textarea name="description" class="w-full bg-white/5 border border-white/10 p-5 rounded-2xl text-sm font-bold text-white outline-none focus:border-orange-500 transition-all h-24 resize-none" placeholder="Describe the promotion..."><%= banner ? banner.description : '' %></textarea>
                    </div>

                    <div class="flex items-center gap-4 bg-white/10 p-6 rounded-3xl border border-white/5">
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" name="isActive" class="sr-only peer" <%= !banner || banner.isActive ? 'checked' : '' %>>
                            <div class="w-11 h-6 bg-white/10 rounded-full peer peer-checked:bg-orange-500 after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:after:translate-x-full"></div>
                        </label>
                        <div>
                            <p class="text-sm font-black text-white/90">Banner is Active</p>
                            <p class="text-[9px] font-black uppercase tracking-widest text-white/20 italic">Publicly visible on chosen slot</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="pt-10 border-t border-white/5 flex justify-end gap-4">
                <a href="/admin/banners" class="px-8 py-5 rounded-2xl font-black text-[10px] uppercase tracking-widest text-white/20 hover:text-white transition-colors">Discard</a>
                <button type="submit" class="bg-gradient-to-r from-orange-500 to-orange-600 hover:scale-[1.01] active:scale-[0.99] text-white px-12 py-5 rounded-2xl font-black text-[10px] uppercase tracking-[4px] transition-all shadow-xl shadow-orange-500/20">
                    <%= banner ? 'Push Update' : 'Initialize Asset' %>
                </button>
            </div>
        </form>
    </main>

    <script>
        function previewFile() {
            const preview = document.getElementById('preview-img');
            const file = document.getElementById('file-input').files[0];
            const reader = new FileReader();

            reader.onloadend = function () {
                preview.src = reader.result;
                preview.classList.remove('opacity-20');
            }

            if (file) {
                reader.readAsDataURL(file);
            }
        }

        async function handleFormSubmit(event) {
            event.preventDefault();
            const form = event.target;
            const isEdit = "<%= !!banner %>" === "true";
            const bannerId = "<%= banner ? banner._id : '' %>";

            let hasError = false;
            const nameValue = document.getElementById('bannerName').value.trim();
            const fileInput = document.getElementById('file-input');
            
            document.getElementById('error-name').classList.add('hidden');
            document.getElementById('error-image').classList.add('hidden');

            if (!nameValue) { document.getElementById('error-name').classList.remove('hidden'); hasError = true; }
            if (!isEdit && !fileInput.files[0]) { document.getElementById('error-image').classList.remove('hidden'); hasError = true; }

            if (hasError) return;

            const formData = new FormData(form);
            formData.set('isActive', form.isActive.checked);

            try {
                const url = isEdit ? `/admin/editBanner/${bannerId}` : '/admin/addBanner';
                const method = isEdit ? 'PUT' : 'POST';

                Swal.fire({ title: 'Processing Asset...', allowOutsideClick: false, didOpen: () => Swal.showLoading(), background: '#121212', color: '#fff' });

                const response = await fetch(url, { method: method, body: formData });
                const result = await response.json();

                if (result.success) {
                    Swal.fire({ icon: 'success', title: 'Asset Deployed', background: '#121212', color: '#fff', timer: 1500, showConfirmButton: false });
                    setTimeout(() => window.location.href = '/admin/banners', 1500);
                } else { throw new Error(result.message); }
            } catch (error) {
                Swal.fire({ icon: 'error', title: 'Upload Failed', text: error.message, background: '#121212', color: '#fff' });
            }
        }
    </script>
</body>
</html>
