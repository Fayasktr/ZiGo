<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/admin/head') %>
    <title>ZiGo Admin | <%= locals.isEdit ? 'Edit' : 'Add New' %> Category</title>
</head>

<body>
    <!-- Sidebar -->
    <%- include('../partials/admin/sidebar', { activeTab: 'categories' }) %>

    <main class="admin-main">
        <%- include('../partials/admin/pageHeader', { title: (locals.isEdit ? 'Update' : 'Add New'), accentTitle: 'Category', subtitle: 'TAXONOMY' }) %>

        <%- include('../partials/flashAlert') %>

        <form class="bg-white/5 border border-white/5 rounded-[2.5rem] p-6 lg:p-12 max-w-4xl mx-auto" id="categoryForm">
            <div class="form-group mb-8">
                <label class="block text-[10px] font-black uppercase tracking-widest opacity-20 mb-3">Category Name</label>
                <input type="text" name="categoryName" id="categoryName" class="w-full bg-white/5 border border-white/10 p-4 rounded-2xl text-sm font-bold text-white outline-none focus:border-orange-500 transition-all" placeholder="e.g. Smart Watches" value="<%= locals.isEdit ? category.categoryName : '' %>">
                <div id="categoryNameError" class="text-red-500 text-[11px] font-bold mt-2"></div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
                <div class="form-group">
                    <label class="block text-[10px] font-black uppercase tracking-widest opacity-20 mb-3">FontAwesome Icon Class</label>
                    <div class="flex gap-4">
                        <input type="text" name="iconClass" class="flex-1 bg-white/5 border border-white/10 p-4 rounded-2xl text-sm font-bold text-white outline-none focus:border-orange-500 transition-all" placeholder="e.g. fas fa-clock" id="iconInput" value="<%= locals.isEdit ? category.iconClass : '' %>">
                        <div class="w-14 h-14 bg-white/5 border border-white/10 rounded-2xl flex items-center justify-center text-xl text-orange-500" id="iconPreview">
                            <i class="<%= locals.isEdit ? category.iconClass : 'fas fa-tag' %>"></i>
                        </div>
                    </div>
                    <div id="iconClassError" class="text-red-500 text-[11px] font-bold mt-2"></div>
                </div>

                <div class="form-group">
                    <label class="block text-[10px] font-black uppercase tracking-widest opacity-20 mb-3">Visibility Status</label>
                    <div class="flex items-center gap-4 bg-white/5 p-4 rounded-2xl border border-white/5 h-[58px]">
                        <label class="relative inline-flex items-center cursor-pointer group">
                            <input type="checkbox" name="isListed" <%=(locals.isEdit && !category.isListed) ? '' : 'checked' %> class="sr-only peer">
                            <div class="w-11 h-6 bg-white/10 rounded-full peer peer-checked:bg-orange-500 after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:after:translate-x-full"></div>
                        </label>
                        <p class="font-black text-[10px] uppercase tracking-widest text-white/40" id="statusText">
                            <%= (locals.isEdit && !category.isListed) ? 'Blocked' : 'Active & Listed' %>
                        </p>
                    </div>
                </div>
            </div>

            <div class="form-group mb-8">
                <div class="flex justify-between items-center mb-4">
                    <label class="block text-[10px] font-black uppercase tracking-widest opacity-20">Variant Attributes</label>
                    <span class="text-[9px] font-bold text-white/20 uppercase tracking-widest">Press Enter to Stack</span>
                </div>

                <div class="relative flex items-center mb-6">
                    <input type="text" id="newAttributeInput" class="w-full bg-white/5 border border-white/10 p-5 pl-14 pr-[120px] rounded-2xl text-sm font-bold text-white outline-none focus:border-orange-500 transition-all shadow-inner" placeholder="Type attribute (e.g. RAM, Color)..." onkeydown="if(event.key === 'Enter'){ event.preventDefault(); addVariantAttributeInline(); }">
                    <div class="absolute left-5 text-white/20"><i class="fas fa-magic"></i></div>
                    <button type="button" onclick="addVariantAttributeInline()" class="absolute right-2 top-1/2 -translate-y-1/2 bg-orange-500 hover:bg-orange-600 text-white px-5 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all">Add</button>
                </div>

                <div id="variantAttributesContainer" class="flex flex-wrap gap-3 p-6 bg-white/[0.02] border border-white/5 rounded-3xl min-h-[100px]">
                    <% let attrs = (locals.isEdit ? category.variantAttributes : []) || []; %>
                    <% if (attrs.length > 0) { %>
                        <% attrs.forEach(attr => { %>
                            <div class="variant-tag flex items-center gap-3 bg-orange-500/10 text-orange-500 px-4 py-2 rounded-xl border border-orange-500/20 group animate-in fade-in zoom-in duration-300">
                                <span class="font-black text-xs uppercase tracking-widest"><%= attr %></span>
                                <button type="button" onclick="removeVariantAttribute(this)" class="text-white/20 hover:text-red-500 transition-colors">
                                    <i class="fas fa-times text-[10px]"></i>
                                </button>
                                <input type="hidden" name="variantAttributes[]" value="<%= attr %>">
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div id="noAttributesText" class="w-full flex flex-col items-center justify-center py-4 opacity-10">
                            <i class="fas fa-layer-group text-3xl mb-3"></i>
                            <p class="text-[10px] font-black uppercase tracking-widest">No keys defined</p>
                        </div>
                    <% } %>
                </div>
            </div>

            <div class="form-group mb-10">
                <label class="block text-[10px] font-black uppercase tracking-widest opacity-20 mb-3">Registry Description</label>
                <textarea name="description" id="categoryDescription" class="w-full bg-white/5 border border-white/10 p-5 rounded-2xl text-sm font-bold text-white outline-none focus:border-orange-500 transition-all min-h-[150px] resize-none" placeholder="Brief overview of this category..."><%= locals.isEdit ? category.description : '' %></textarea>
                <div id="categoryDescriptionError" class="text-red-500 text-[11px] font-bold mt-2"></div>
            </div>

            <button type="button" onclick="handleCategorySubmit('<%= locals.isEdit ? category._id : '' %>')" class="w-full bg-gradient-to-r from-orange-500 to-orange-600 hover:scale-[1.01] active:scale-[0.99] text-white py-5 rounded-2xl font-black text-sm uppercase tracking-[4px] transition-all shadow-xl shadow-orange-500/20">
                <%= locals.isEdit ? 'Save Changes' : 'Initialize Category' %>
            </button>
        </form>
    </main>

    <script>
        const iconInput = document.getElementById('iconInput');
        const iconPreview = document.getElementById('iconPreview');
        const statusCheckbox = document.querySelector('input[name="isListed"]');
        const statusText = document.getElementById('statusText');

        iconInput.addEventListener('input', (e) => {
            const val = e.target.value || 'fas fa-tag';
            iconPreview.innerHTML = `<i class="${val}"></i>`;
        });

        statusCheckbox.addEventListener('change', (e) => {
            statusText.innerText = e.target.checked ? 'Active & Listed' : 'Blocked';
        });

        function addVariantAttributeInline() {
            const input = document.getElementById('newAttributeInput');
            const val = input.value.trim();
            if (!val) return;

            const noText = document.getElementById('noAttributesText');
            if (noText) noText.remove();

            const container = document.getElementById('variantAttributesContainer');
            const existing = Array.from(container.querySelectorAll('input')).map(i => i.value.toLowerCase());
            if (existing.includes(val.toLowerCase())) {
                input.classList.add('border-red-500');
                setTimeout(() => input.classList.remove('border-red-500'), 500);
                return;
            }

            const tag = document.createElement('div');
            tag.className = "variant-tag flex items-center gap-3 bg-orange-500/10 text-orange-500 px-4 py-2 rounded-xl border border-orange-500/20 group animate-in fade-in zoom-in duration-300";
            tag.innerHTML = `
                <span class="font-black text-xs uppercase tracking-widest">${val}</span>
                <button type="button" onclick="removeVariantAttribute(this)" class="text-white/20 hover:text-red-500 transition-colors">
                    <i class="fas fa-times text-[10px]"></i>
                </button>
                <input type="hidden" name="variantAttributes[]" value="${val}">
            `;
            container.appendChild(tag);
            input.value = '';
            input.focus();
        }

        function removeVariantAttribute(btn) {
            btn.parentElement.remove();
            const container = document.getElementById('variantAttributesContainer');
            if (container.children.length === 0) {
                container.innerHTML = `
                    <div id="noAttributesText" class="w-full flex flex-col items-center justify-center py-4 opacity-10">
                        <i class="fas fa-layer-group text-3xl mb-3"></i>
                        <p class="text-[10px] font-black uppercase tracking-widest">No keys defined</p>
                    </div>
                `;
            }
        }

        const initialData = <%- locals.isEdit ? JSON.stringify({
            categoryName: category.categoryName,
            iconClass: category.iconClass,
            isListed: category.isListed,
            variantAttributes: category.variantAttributes || [],
            description: category.description
        }) : 'null' %>;

        async function handleCategorySubmit(categoryId) {
            const form = document.querySelector('form');
            const formData = new FormData(form);
            const data = {
                categoryName: document.getElementById('categoryName').value,
                iconClass: document.getElementById('iconInput').value,
                isListed: form.isListed.checked ? "on" : "off",
                variantAttributes: Array.from(form.querySelectorAll('input[name="variantAttributes[]"]')).map(i => i.value),
                description: document.getElementById('categoryDescription').value
            };

            // Validation
            let valid = true;
            if (data.categoryName.length < 3) {
                document.getElementById('categoryNameError').innerText = "Name too short (min 3 chars)";
                valid = false;
            }
            if (!valid) return;

            try {
                const url = categoryId ? `/admin/category/edit/${categoryId}` : "/admin/category/add";
                const method = categoryId ? "PUT" : "POST";
                const res = await fetch(url, {
                    method,
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(data)
                });
                const result = await res.json();
                if (res.ok) {
                    Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: 'Category Saved', showConfirmButton: false, timer: 1500, background: '#121212', color: '#fff' });
                    setTimeout(() => window.location.href = "/admin/category", 1500);
                } else { throw new Error(result.message); }
            } catch (err) { Swal.fire('Error', err.message, 'error'); }
        }
    </script>
</body>
</html>