<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Sales Report</title>
    <style>
        @page {
            margin: 20mm;
            size: A4;
        }
        body {
            font-family: 'Inter', sans-serif, Arial;
            color: #333;
            line-height: 1.6;
            margin: 0;
            padding: 0;
        }
        .header {
            text-align: center;
            margin-bottom: 40px;
            border-bottom: 2px solid #FF5A1F;
            padding-bottom: 20px;
        }
        .header h1 {
            color: #FF5A1F;
            margin: 0;
            font-size: 28px;
            text-transform: uppercase;
            letter-spacing: 2px;
        }
        .header p {
            margin: 5px 0 0;
            color: #666;
            font-size: 14px;
        }
        .report-info {
            display: flex;
            justify-content: space-between;
            margin-bottom: 30px;
            font-size: 12px;
            color: #555;
        }
        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
            margin-bottom: 40px;
        }
        .metric-card {
            background: #f8f9fa;
            border: 1px solid #eee;
            border-radius: 8px;
            padding: 15px;
            text-align: center;
        }
        .metric-card h3 {
            margin: 0;
            font-size: 10px;
            color: #888;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .metric-card p {
            margin: 5px 0 0;
            font-size: 18px;
            font-weight: bold;
            color: #333;
        }
        .section-title {
            font-size: 16px;
            font-weight: bold;
            color: #333;
            margin-bottom: 15px;
            border-left: 4px solid #FF5A1F;
            padding-left: 10px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 30px;
        }
        th {
            background: #f8f9fa;
            color: #333;
            font-size: 11px;
            font-weight: bold;
            text-align: left;
            padding: 12px 15px;
            border-bottom: 2px solid #ddd;
            text-transform: uppercase;
        }
        td {
            padding: 12px 15px;
            border-bottom: 1px solid #eee;
            font-size: 11px;
            color: #444;
        }
        .text-right { text-align: right; }
        .footer {
            margin-top: 50px;
            text-align: center;
            font-size: 10px;
            color: #999;
            border-top: 1px solid #eee;
            padding-top: 20px;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>ZiGo Sales Report</h1>
        <p>Expertly Crafted Commerce Intelligence</p>
    </div>

    <div class="report-info">
        <div>
            <strong>Report Period:</strong> <%= period.toUpperCase() %><br>
            <% if (startDate && endDate) { %>
                <strong>Range:</strong> <%= new Date(startDate).toLocaleDateString() %> - <%= new Date(endDate).toLocaleDateString() %>
            <% } %>
        </div>
        <div class="text-right">
            <strong>Generated On:</strong> <%= new Date().toLocaleString() %>
        </div>
    </div>

    <div class="metrics-grid">
        <div class="metric-card">
            <h3>Total Revenue</h3>
            <p>₹<%= Math.round(metrics.totalRevenue).toLocaleString() %></p>
        </div>
        <div class="metric-card">
            <h3>Total Orders</h3>
            <p><%= metrics.totalOrders %></p>
        </div>
        <div class="metric-card">
            <h3>Avg Order Value</h3>
            <p>₹<%= Math.round(metrics.avgOrderValue).toLocaleString() %></p>
        </div>
        <div class="metric-card">
            <h3>Items Sold</h3>
            <p><%= metrics.totalItemsSold %></p>
        </div>
    </div>

    <div class="section-title">Top Selling Products</div>
    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>Product Name</th>
                <th>Category</th>
                <th class="text-right">Units Sold</th>
                <th class="text-right">Revenue</th>
            </tr>
        </thead>
        <tbody>
            <% topProducts.forEach((p, index) => { %>
                <tr>
                    <td><%= index + 1 %></td>
                    <td><strong><%= p.productName %></strong></td>
                    <td><%= p.category || 'N/A' %></td>
                    <td class="text-right"><%= p.unitsSold %></td>
                    <td class="text-right">₹<%= Math.round(p.revenue).toLocaleString() %></td>
                </tr>
            <% }) %>
        </tbody>
    </table>

    <div class="section-title">Category Distribution</div>
    <table>
        <thead>
            <tr>
                <th>Category Name</th>
                <th class="text-right">Items Sold</th>
                <th class="text-right">Revenue Share</th>
            </tr>
        </thead>
        <tbody>
            <% categoryWiseSales.forEach(c => { %>
                <tr>
                    <td><strong><%= c.category || 'Uncategorized' %></strong></td>
                    <td class="text-right"><%= c.itemsSold %></td>
                    <td class="text-right">₹<%= Math.round(c.revenue).toLocaleString() %></td>
                </tr>
            <% }) %>
        </tbody>
    </table>

    <div class="footer">
        &copy; <%= new Date().getFullYear() %> ZiGo E-commerce Platform. This is a computer-generated document.
    </div>
</body>
</html>
