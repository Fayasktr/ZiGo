<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/admin/head') %>
    <title>ZiGo Admin | Banner Management</title>
</head>

<body>
    <!-- Sidebar -->
    <%- include('../partials/admin/sidebar', { activeTab: 'banners' }) %>

    <main class="admin-main">
        <%- include('../partials/admin/pageHeader', { title: 'Banner', accentTitle: 'Management', subtitle: 'VISUALS' }) %>

        <div class="flex justify-end mb-8">
            <a href="/admin/banners/addEditPage" class="w-full sm:w-auto bg-orange-500 hover:bg-orange-600 text-white px-8 py-4 rounded-2xl font-black transition-all flex items-center justify-center gap-3 shadow-xl shadow-orange-500/20">
                <i class="fas fa-upload"></i> UPLOAD NEW BANNER
            </a>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 2xl:grid-cols-3 gap-6">
            <% if (locals.banners && banners.length > 0) { %>
                <% banners.forEach((banner, index) => { %>
                    <div class="bg-white/5 border border-white/5 rounded-[2.5rem] p-6 hover:border-orange-500/30 transition-all group flex flex-col h-full">
                        <div class="w-full aspect-[21/9] sm:aspect-video bg-black rounded-2xl overflow-hidden border border-white/10 group-hover:border-orange-500/20 transition-all mb-6">
                            <img src="<%= banner.image %>" alt="<%= banner.name %>" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110">
                        </div>
                        
                        <div class="flex-1 flex flex-col">
                            <div class="flex justify-between items-start mb-4">
                                <div class="flex-1 mr-4">
                                    <span class="bg-orange-500/10 text-orange-500 text-[10px] lg:text-xs font-black uppercase tracking-widest px-3 py-1 rounded-lg mb-2 inline-block">Slot: <%= banner.slot || 'N/A' %></span>
                                    <h3 class="text-lg lg:text-xl font-black text-white/90 group-hover:text-orange-500 transition-colors line-clamp-1"><%= banner.name %></h3>
                                </div>
                                <div class="flex flex-col items-end gap-1">
                                    <label class="relative inline-flex items-center cursor-pointer">
                                        <input type="checkbox" <%= banner.isActive ? 'checked' : '' %> class="sr-only peer" onchange="changeStatus('<%= banner._id %>', this)">
                                        <div class="w-10 h-5 bg-white/10 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-orange-500"></div>
                                    </label>
                                    <span class="text-[9px] lg:text-[11px] font-black uppercase tracking-widest <%= banner.isActive ? 'text-orange-500' : 'text-white/20' %>">
                                        <%= banner.isActive ? 'Active' : 'Inactive' %>
                                    </span>
                                </div>
                            </div>
                            
                            <div class="flex items-center gap-3 mt-auto pt-6 border-t border-white/5">
                                <a href="/admin/banners/addEditPage?id=<%= banner._id %>" class="flex-1 px-4 py-3 bg-white/5 hover:bg-white/10 rounded-xl transition-all text-center text-[10px] lg:text-xs font-bold uppercase tracking-widest">
                                    <i class="fas fa-edit mr-2"></i> Edit
                                </a>
                                <button onclick="confirmDelete('<%= banner._id %>', '<%= banner.name %>')" class="flex-1 px-4 py-3 bg-red-500/10 hover:bg-red-500 text-red-500 hover:text-white rounded-xl transition-all text-center text-[10px] lg:text-xs font-bold uppercase tracking-widest">
                                    <i class="fas fa-trash mr-2"></i> Delete
                                </button>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="col-span-full py-24 text-center bg-white/5 border border-white/5 border-dashed rounded-[3rem] opacity-30">
                    <i class="fas fa-image text-5xl mb-6"></i>
                    <h4 class="text-xl font-black mb-2">No Banners Found</h4>
                    <p class="text-sm font-medium mb-8 max-w-xs mx-auto">Upload eye-catching promotional banners to boost your conversion rates.</p>
                    <a href="/admin/banners/addEditPage" class="inline-block text-orange-500 font-black border-b-2 border-orange-500 pb-1">Begin Upload</a>
                </div>
            <% } %>
        </div>
    </main>

    <script>
        async function confirmDelete(id, name) {
            const result = await Swal.fire({
                title: `Remove ${name}?`,
                text: "This banner will be permanently deleted from the store.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#FF5A1F',
                cancelButtonColor: 'rgba(255,255,255,0.05)',
                confirmButtonText: 'Yes, delete it',
                background: '#121212',
                color: '#FFFFFF'
            });

            if (result.isConfirmed) {
                try {
                    const response = await fetch(`/admin/deleteBanner`, {
                        method: 'DELETE',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ id })
                    });
                    const data = await response.json();
                    
                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Deleted!',
                            text: 'Banner removed successfully.',
                            background: '#121212',
                            color: '#FFFFFF',
                            showConfirmButton: false,
                            timer: 1500
                        });
                        setTimeout(() => location.reload(), 1500);
                    } else {
                        throw new Error(data.message);
                    }
                } catch (error) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Oops...',
                        text: error.message || 'Something went wrong!',
                        background: '#121212',
                        color: '#FFFFFF'
                    });
                }
            }
        }

        async function changeStatus(id, element) {
            const checked = element.checked;
            try {
                const response = await fetch(`/admin/banner/changeStatus/${id}`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await response.json();
                
                if (data.success) {
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'success',
                        title: 'Status Updated',
                        showConfirmButton: false,
                        timer: 2000,
                        background: '#121212',
                        color: '#FFFFFF'
                    });
                    
                    if (checked) {
                        const allSwitches = document.querySelectorAll('input[type="checkbox"]');
                        allSwitches.forEach(sw => {
                            if (sw !== element) {
                                sw.checked = false;
                                const otherLabel = sw.parentElement.nextElementSibling;
                                if (otherLabel) {
                                    otherLabel.textContent = 'Inactive';
                                    otherLabel.className = 'text-[9px] font-black uppercase tracking-widest text-white/20';
                                }
                            }
                        });
                    }

                    const label = element.parentElement.nextElementSibling;
                    if (label) {
                        label.textContent = checked ? 'Active' : 'Inactive';
                        label.className = `text-[9px] font-black uppercase tracking-widest ${checked ? 'text-orange-500' : 'text-white/20'}`;
                    }
                } else {
                    throw new Error(data.message);
                }
            } catch (error) {
                Swal.fire({ icon: 'error', title: 'Error', text: error.message || 'Failed to update status' });
                element.checked = !checked;
            }
        }
    </script>
</body>
</html>
