<style>
    :root {
        --primary-orange: #FF5A1F;
        --primary-orange-hover: #E44D18;
        --deep-black: #0F0F0F;
        --white: #FFFFFF;
        --transition: all 0.3s ease;
    }

    header {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.92rem 5%;
        z-index: 1000;
        background-color: rgba(15, 15, 15, 0.7);
        backdrop-filter: blur(8px);
        transition: var(--transition);
    }

    header.scrolled {
        padding: 0.63rem 5%;
        background-color: rgba(15, 15, 15, 0.95);
        box-shadow: 0 4px 40px rgba(255, 90, 31, 0.4);
    }

    .logo {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .logo img.icon { height: 100px; }
    .logo img.name { height: 70px; }

    .nav-links {
        display: flex;
        gap: 2rem;
        list-style: none;
    }

    .nav-links a {
        color: white;
        text-decoration: none;
        opacity: 0.8;
    }

    .nav-links a:hover {
        color: var(--primary-orange);
        opacity: 1;
    }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .profile-link {
        background: var(--primary-orange);
        color: white;
        padding: 0.6rem 1.2rem;
        border-radius: 6px;
        text-decoration: none;
        font-size: 0.9rem;
    }

    .signup-link {
        border: 1px solid var(--primary-orange);
        color: var(--primary-orange);
        padding: 0.6rem 1.2rem;
        border-radius: 6px;
        text-decoration: none;
        font-size: 0.9rem;
    }

    /* MOBILE FIXES */
    @media (max-width: 768px) {

        .nav-links {
            display: none;
        }

        .logo img.icon { height: 55px; }
        .logo img.name { height: 35px; }

        .profile-link,
        .signup-link {
            padding: 0.4rem 0.8rem;
            font-size: 0.75rem;
        }
    }
</style>

<header id="main-header">
    <a href="/" class="logo">
        <img src="/public/public/logo-icon.png" class="icon">
        <img src="/public/public/logo-name.png" class="name">
    </a>

    <ul class="nav-links">
        <li><a href="/">Home</a></li>
        <li><a href="/shop">Shop</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/contact">Contact</a></li>
    </ul>

    <div class="header-actions">

        <!-- KEEP THESE VISIBLE -->
        <a href="/login" class="profile-link">Login</a>
        <a href="/signUp" class="signup-link">Sign Up</a>

        <!-- HAMBURGER -->
        <button id="menu-btn" class="lg:hidden text-white">
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
        </button>
    </div>
</header>

<!-- MOBILE MENU -->
<div id="mobile-menu" class="fixed top-0 left-0 w-full h-full bg-black/80 hidden z-[999]">

    <!-- padding-top FIX -->
    <div class="bg-[#0F0F0F] w-[75%] max-w-[280px] h-full pt-24 p-6 flex flex-col gap-6">

        <a href="/" class="text-white text-lg">Home</a>
        <a href="/shop" class="text-white text-lg">Shop</a>
        <a href="/about" class="text-white text-lg">About</a>
        <a href="/contact" class="text-white text-lg">Contact</a>

    </div>
</div>

<%- include('flashAlert') %>

<script>
    const header = document.getElementById('main-header');
    const menuBtn = document.getElementById('menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    // scroll effect
    window.addEventListener('scroll', () => {
        window.scrollY > 50
            ? header.classList.add('scrolled')
            : header.classList.remove('scrolled');
    });

    // toggle menu
    menuBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        mobileMenu.classList.toggle('hidden');
    });

    // close outside
    mobileMenu.addEventListener('click', (e) => {
        if (e.target === mobileMenu) {
            mobileMenu.classList.add('hidden');
        }
    });

    // close on link click
    document.querySelectorAll('#mobile-menu a').forEach(link => {
        link.addEventListener('click', () => {
            mobileMenu.classList.add('hidden');
        });
    });
</script>