<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<style>
    /* --- THE ONLY FIX ADDED --- */
    *, *::before, *::after {
        box-sizing: border-box;
    }
    html, body {
        margin: 0;
        padding: 0;
        width: 100%;
        max-width: 100vw;
        overflow-x: hidden;
    }
    /* -------------------------- */

    :root {
        --primary-orange: #FF5A1F;
        --primary-orange-hover: #E44D18;
        --deep-black: #0F0F0F;
        --white: #FFFFFF;
        --transition: all 0.3s ease;
    }

    header {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.8rem 5%;
        z-index: 1000;
        background: rgba(15,15,15,0.7);
        backdrop-filter: blur(8px);
    }

    header.scrolled {
        background: rgba(15,15,15,0.95);
        box-shadow: 0 4px 40px rgba(255, 90, 31, 0.4);
    }

    .logo img.icon { height: 70px; }
    .logo img.name { height: 30px; }

    .nav-links {
        display: flex;
        gap: 2rem;
        list-style: none;
    }

    .nav-links a {
        color: white;
        text-decoration: none;
        opacity: 0.8;
    }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .cart-btn, .wishlist-btn {
        position: relative;
        color: white;
        font-size: 1.4rem;
        transition: var(--transition);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .cart-btn:hover, .wishlist-btn:hover {
        color: var(--primary-orange);
        transform: scale(1.1);
    }

    .cart-count, .wishlist-count {
        position: absolute;
        top: -5px;
        right: -8px;
        background: var(--primary-orange);
        font-size: 0.65rem;
        font-weight: 800;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        border: 2px solid var(--deep-black);
    }

    .profile-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: 2px solid var(--primary-orange);
        overflow: hidden;
        transition: var(--transition);
    }

    .profile-avatar:hover {
        transform: scale(1.1);
        box-shadow: 0 0 15px rgba(255, 90, 31, 0.3);
    }

    .profile-avatar img {
        width: 100%;
        height: 100%;
    }

    /* MOBILE */
    @media (max-width:768px){
        .nav-links{ display:none; }
        .logo img.icon { height: 50px; }
        .header-actions { gap: 0.75rem; }
        header { padding: 0.8rem 3%; }
    }
</style>

<header id="main-header">
    <a href="/" class="logo flex items-center gap-2">
        <img src="/public/public/logo-icon.png" class="icon">
        <img src="/public/public/logo-name.png" class="name">
    </a>

    <!-- DESKTOP NAV -->
    <ul class="nav-links hidden lg:flex">
        <li><a href="/">Home</a></li>
        <li><a href="/shop">Shop</a></li>
        <li><a href="/user/orders">Orders</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/contact">Contact</a></li>
    </ul>

    <div class="header-actions">

        <!-- Cart -->
        <a href="/user/cart" class="cart-btn">
            <i class="fas fa-shopping-cart"></i>
            <span class="cart-count" id="cart-count-badge"><%= typeof cartCount !== 'undefined' ? cartCount : 0 %></span>
        </a>

        <!-- Wishlist -->
        <a href="/user/wishlist" class="wishlist-btn">
            <i class="fas fa-heart"></i>
            <span class="wishlist-count" id="wishlist-count-badge"><%= typeof wishlistCount !== 'undefined' ? wishlistCount : 0 %></span>
        </a>

        <!-- Profile -->
        <a href="/user/profile" class="profile-avatar">
            <img src="https://ui-avatars.com/api/?name=<%= user?.userName || 'User' %>&background=FF5A1F&color=fff">
        </a>

        <!-- HAMBURGER -->
        <button id="menu-btn" class="lg:hidden text-white text-xl">
            ☰
        </button>
    </div>
</header>

<!-- MOBILE MENU -->
<div id="mobile-menu" class="fixed top-0 left-0 w-full h-full bg-black/80 hidden z-[999]">

    <div class="bg-[#0F0F0F] w-[75%] max-w-[280px] h-full pt-24 p-6 flex flex-col gap-6">

        <a href="/" class="text-white text-lg">Home</a>
        <a href="/shop" class="text-white text-lg">Shop</a>
        <a href="/user/orders" class="text-white text-lg">Orders</a>
        <a href="/about" class="text-white text-lg">About</a>
        <a href="/contact" class="text-white text-lg">Contact</a>

        <hr class="border-gray-700">

        <!-- LOGOUT MOVED HERE -->
        <a href="/logout" class="text-red-400">Logout</a>
    </div>
</div>

<script>
    const header = document.getElementById('main-header');
    const menuBtn = document.getElementById('menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    window.addEventListener('scroll', () => {
        window.scrollY > 50
            ? header.classList.add('scrolled')
            : header.classList.remove('scrolled');
    });

    menuBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        mobileMenu.classList.toggle('hidden');
    });

    mobileMenu.addEventListener('click', (e) => {
        if (e.target === mobileMenu) {
            mobileMenu.classList.add('hidden');
        }
    });

    document.querySelectorAll('#mobile-menu a').forEach(link => {
        link.addEventListener('click', () => {
            mobileMenu.classList.add('hidden');
        });
    });

    // --- CART & WISHLIST COUNT UPDATERS ---
    window.updateCartCount = function(count) {
        const badge = document.getElementById('cart-count-badge');
        if (badge) {
            badge.innerText = count;
            // Optional: Add a small animation on change
            badge.style.transform = 'scale(1.2)';
            setTimeout(() => badge.style.transform = 'scale(1)', 200);
        }
    };

    window.updateWishlistCount = function(count) {
        const badge = document.getElementById('wishlist-count-badge');
        if (badge) {
            badge.innerText = count;
            badge.style.transform = 'scale(1.2)';
            setTimeout(() => badge.style.transform = 'scale(1)', 200);
        }
    };
</script>