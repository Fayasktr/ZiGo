<style>
    :root {
        --primary-orange: #FF5A1F;
        --primary-orange-hover: #E44D18;
        --deep-black: #0F0F0F;
        --off-white: #F9F9F9;
        --dark-navy: #1E293B;
        --gray-light: #E2E8F0;
        --white: #FFFFFF;
        --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* --- Header --- */
    header {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.92rem 5%;
        z-index: 1000;
        transition: var(--transition);
        background-color: transparent;
    }

    header::before {
        content: '';
        position: absolute;
        inset: 0;
        background-color: rgba(15, 15, 15, 0.7);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        z-index: -1;
        transition: background-color 0.3s ease;
    }

    header.scrolled::before {
        background-color: rgba(15, 15, 15, 0.95);
    }

    header.scrolled {
        padding: 0.81rem 5%;
        box-shadow: 0 4px 40px rgba(255, 90, 31, 0.4);
    }

    .logo {
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
    }

    .logo img.icon {
        height: 76px;
        /* Final calibration (+5% more) */
        /* Increased by 10% from 65px */
        width: auto;
    }

    .logo img.name {
        height: 33px;
        /* Final calibration (+5% more) */
        /* Increased by 10% from 28px */
        width: auto;
        margin-top: 2px;
        mix-blend-mode: screen;
    }

    .nav-links {
        display: flex;
        gap: 2rem;
        list-style: none;
    }

    .nav-links a {
        color: var(--white);
        text-decoration: none;
        font-weight: 500;
        font-size: 0.95rem;
        opacity: 0.8;
        transition: var(--transition);
    }

    .nav-links a:hover {
        opacity: 1;
        color: var(--primary-orange);
    }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }

    .cart-btn, .wishlist-btn {
        position: relative;
        background: none;
        border: none;
        color: var(--white);
        cursor: pointer;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: var(--transition);
        font-size: 1.2rem;
    }

    /* Red hover ONLY for header icons */
    .header-actions .wishlist-btn:hover {
        color: #ff4757;
    }

    .cart-count, .wishlist-count {
        position: absolute;
        top: -8px;
        right: -8px;
        background-color: var(--primary-orange);
        color: white;
        font-size: 0.7rem;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        font-weight: 700;
        transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        transform-origin: center;
    }

    .wishlist-count {
        background-color: #ff4757; /* Use a redder tone for wishlist */
    }

    .profile-avatar {
        width: 38px;
        /* Increased from 30px */
        height: 38px;
        border-radius: 50%;
        border: 2px solid var(--primary-orange);
        cursor: pointer;
        overflow: hidden;
        transition: var(--transition);
    }

    .profile-avatar:hover {
        transform: scale(1.1);
    }

    .profile-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .logout-btn {
        background: rgba(255, 255, 255, 0.1);
        color: white;
        padding: 0.6rem 1.2rem;
        border-radius: 8px;
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 600;
        transition: var(--transition);
    }

    .logout-btn:hover {
        background: #ff4757;
        color: white;
    }

    /* Global Modal Layering Safety */
    #successModal, #errorModal, .swal2-container, .swal2-backdrop-show {
        z-index: 999999 !important;
    }
</style>

<header id="main-header" class="flex items-center justify-between">
    <a href="/" class="logo">
        <img src="/public/public/logo-icon.png" alt="ZiGo Icon" class="icon">
        <img src="/public/public/logo-name.png" alt="ZiGo" class="name">
    </a>
    <ul class="nav-links hidden lg:flex">
        <li><a href="/">Home</a></li>
        <li><a href="/shop">Shop</a></li>
        <li><a href="/user/orders">Orders</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/contact">Contact</a></li>
    </ul>
    <div class="header-actions flex items-center gap-6">
        <!-- Cart -->
        <a href="/user/cart" class="cart-btn">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <circle cx="9" cy="21" r="1"></circle>
                <circle cx="20" cy="21" r="1"></circle>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
            </svg>
            <span class="cart-count">
                <%= (typeof locals.cartCount !=='undefined' && locals.cartCount) ? cartCount : 0 %>
            </span>
        </a>

        <!-- Wishlist -->
        <a href="/user/wishlist" class="wishlist-btn hidden sm:flex">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path
                    d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.82-8.82 1.06-1.06a5.5 5.5 0 0 0 0-7.78z">
                </path>
            </svg>
            <span class="wishlist-count">
                <%= (typeof locals.wishlistCount !== 'undefined') ? (Array.isArray(wishlistCount) ? wishlistCount.length : wishlistCount) : 0 %>
            </span>
        </a>

        <!-- Profile Avatar -->
        <a href="/user/profile" class="profile-avatar hidden sm:block">
            <% if (user && user.profileImage) { %>
                <img src="<%= user.profileImage %>" alt="User" id="headerProfileImage">
            <% } else if (user) { %>
                <img src="https://ui-avatars.com/api/?name=<%= user.userName %>&background=FF5A1F&color=fff"
                    alt="User" id="headerProfileImage">
            <% } else { %>
                <img src="https://ui-avatars.com/api/?name=Guest&background=FF5A1F&color=fff" alt="User">
            <% } %>
        </a>

        <!-- Logout Button -->
        <a href="/logout" class="logout-btn hidden sm:block">Logout</a>

        <button class="lg:hidden text-white">
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
        </button>
    </div>

        <button class="lg:hidden text-white">
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
        </button>
    </div>
</header>

<%- include('flashAlert') %>

    <script>
        // Header Scroll Effect
        window.addEventListener('scroll', () => {
            const header = document.getElementById('main-header');
            if (window.scrollY > 50) {
                header.classList.add('scrolled');
            } else {
                header.classList.remove('scrolled');
            }
        });

        // Global Cart Count Update
        window.updateCartCount = function(count) {
            const badge = document.querySelector('.cart-count');
            if (badge) {
                badge.innerText = count;
                // Add a small scale animation for feedback
                badge.style.transform = 'scale(1.3)';
                setTimeout(() => badge.style.transform = 'scale(1)', 200);
            }
        };

        // Global Wishlist Count Update
        window.updateWishlistCount = function(count) {
            const badge = document.querySelector('.wishlist-count');
            if (badge) {
                badge.innerText = count;
                // Add a small scale animation for feedback
                badge.style.transform = 'scale(1.3)';
                setTimeout(() => badge.style.transform = 'scale(1)', 200);
            }
        };
    </script>