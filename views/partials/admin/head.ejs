<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<link rel="icon" type="image/png" href="/public/public/favicon.png">

<style>
    :root {
        --primary-orange: #FF5A1F;
        --primary-orange-hover: #E44D18;
        --deep-black: #0F0F0F;
        --dark-navy: #1E293B;
        --off-white: #F9F9F9;
        --gray-light: #E2E8F0;
        --white: #FFFFFF;
        --glass: rgba(255, 255, 255, 0.03);
        --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: 'Inter', sans-serif;
    }

    body {
        background-color: var(--deep-black);
        color: var(--white);
        overflow-x: hidden;
        display: flex;
        min-height: 100vh;
    }

    /* --- Admin Sidebar --- */
    .admin-sidebar {
        width: 280px;
        background: rgba(255, 255, 255, 0.02);
        backdrop-filter: blur(20px);
        border-right: 1px solid rgba(255, 255, 255, 0.05);
        height: 100vh;
        position: fixed;
        left: 0;
        top: 0;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        z-index: 1000;
        overflow-y: auto;
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Mobile Sidebar State */
    @media (max-width: 1024px) {
        .admin-sidebar {
            transform: translateX(-100%);
        }
        .admin-sidebar.mobile-active {
            transform: translateX(0);
        }
    }

    .admin-sidebar::-webkit-scrollbar { width: 4px; }
    .admin-sidebar::-webkit-scrollbar-thumb { background: rgba(255, 90, 31, 0.2); border-radius: 10px; }

    .admin-logo { display: flex; align-items: center; gap: 12px; margin-bottom: 3rem; text-decoration: none; }
    .admin-logo img { height: 48px; }

    .nav-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.5rem;
        border-radius: 16px;
        color: rgba(255, 255, 255, 0.5);
        text-decoration: none;
        font-weight: 600;
        transition: var(--transition);
        margin-bottom: 0.5rem;
    }

    .nav-item:hover, .nav-item.active { background: rgba(255, 90, 31, 0.1); color: var(--primary-orange); }
    .nav-item.active { box-shadow: 0 4px 15px rgba(255, 90, 31, 0.1); }

    .logout-btn { color: #FF4757; background: rgba(255, 71, 87, 0.05); }
    .logout-btn:hover { background: #FF4757; color: white; }

    /* --- Main Content --- */
    .admin-main {
        flex: 1;
        margin-left: 280px;
        padding: 2.5rem 3.5rem;
        transition: all 0.3s ease;
        max-width: 100%;
        width: calc(100% - 280px);
    }

    @media (max-width: 1024px) {
        .admin-main {
            margin-left: 0;
            padding: 1.5rem 1rem;
            width: 100%;
        }
    }

    .admin-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 3rem; gap: 1rem; }
    @media (max-width: 640px) { .admin-header { flex-direction: column; align-items: flex-start; margin-bottom: 2rem; } }

    .header-title h1 { font-size: clamp(1.5rem, 5vw, 2rem); font-weight: 800; letter-spacing: -1px; }

    /* --- Stats Grid --- */
    .stats-grid { 
        display: grid; 
        grid-template-columns: repeat(1, 1fr); 
        gap: 1.5rem; 
        margin-bottom: 3rem; 
    }
    @media (min-width: 640px) { .stats-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (min-width: 1280px) { .stats-grid { grid-template-columns: repeat(5, 1fr); } }

    .stat-card { 
        background: var(--glass); 
        border: 1px solid rgba(255, 255, 255, 0.05); 
        padding: 2rem; 
        border-radius: 2rem; 
        transition: var(--transition); 
    }
    .stat-card:hover { border-color: rgba(255, 90, 31, 0.2); transform: translateY(-5px); }
    .stat-icon { width: 48px; height: 48px; background: rgba(255, 90, 31, 0.1); color: var(--primary-orange); border-radius: 14px; display: flex; align-items: center; justify-content: center; margin-bottom: 1.5rem; font-size: 1.25rem; }
    .stat-value { font-size: 1.75rem; font-weight: 900; margin-bottom: 0.5rem; letter-spacing: -1px; }
    .stat-label { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; opacity: 0.4; }

    /* --- Charts Section --- */
    .charts-section { 
        display: grid; 
        grid-template-columns: 1fr; 
        gap: 2rem; 
        margin-bottom: 3rem; 
    }
    @media (min-width: 1024px) { .charts-section { grid-template-columns: 2fr 1fr; } }

    .chart-container { 
        background: var(--glass); 
        border: 1px solid rgba(255, 255, 255, 0.05); 
        padding: 2.5rem; 
        border-radius: 2.5rem; 
        min-height: 400px; 
    }

    /* --- Recent Orders Table --- */
    .data-table { width: 100%; border-collapse: separate; border-spacing: 0 0.75rem; }
    .data-table th { padding: 1rem 1.5rem; text-align: left; font-size: 0.7rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; opacity: 0.3; }
    .data-table td { padding: 1.25rem 1.5rem; background: rgba(255, 255, 255, 0.02); border-top: 1px solid rgba(255, 255, 255, 0.05); border-bottom: 1px solid rgba(255, 255, 255, 0.05); }
    .data-table td:first-child { border-left: 1px solid rgba(255, 255, 255, 0.05); border-radius: 16px 0 0 16px; }
    .data-table td:last-child { border-right: 1px solid rgba(255, 255, 255, 0.05); border-radius: 0 16px 16px 0; }
    .data-table tr:hover td { background: rgba(255, 255, 255, 0.04); border-color: rgba(255, 90, 31, 0.2); }

    /* --- Utility Classes --- */
    .status-pill { padding: 4px 12px; border-radius: 100px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; }
    .data-table-wrapper { overflow-x: auto; width: 100%; border-radius: 24px; }
    
    /* Chart responsiveness */
    canvas { max-width: 100% !important; height: auto !important; }

    /* --- Restored Search Bar Styles --- */
    .search-row { margin-bottom: 2rem; display: flex; align-items: center; gap: 1rem; }
    .search-wrapper { position: relative; flex: 1; min-width: 300px; }
    .search-input { 
        width: 100%; 
        background: rgba(255, 255, 255, 0.05); 
        border: 1px solid rgba(255, 255, 255, 0.1); 
        padding: 0.85rem 1rem 0.85rem 3rem; 
        border-radius: 12px; 
        color: white; 
        font-weight: 500; 
        outline: none; 
        transition: var(--transition); 
    }
    .search-input:focus { border-color: var(--primary-orange); background: rgba(0,0,0,0.2); }
    .search-icon { position: absolute; left: 1.25rem; top: 50%; transform: translateY(-50%); color: var(--primary-orange); opacity: 0.5; }
    
    .btn-search-panel { 
        padding: 0.85rem 1.5rem; 
        border-radius: 12px; 
        font-weight: 800; 
        font-size: 0.7rem; 
        letter-spacing: 1px; 
        transition: var(--transition); 
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    @media (min-width: 1024px) {
        .btn-search-panel { font-size: 0.8rem; }
    }
    .btn-search-submit { background: var(--primary-orange); color: white; border: none; }
    .btn-search-submit:hover { background: var(--primary-orange-hover); transform: translateY(-2px); }
    
    .btn-search-clear { background: rgba(255, 255, 255, 0.05); color: rgba(255, 255, 255, 0.4); border: 1px solid rgba(255, 255, 255, 0.1); }
    .btn-search-clear:hover { background: rgba(255, 255, 255, 0.1); color: white; }

    /* --- Form Styling --- */
    .form-group { margin-bottom: 1.5rem; }
    .form-label { display: block; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; color: var(--white); opacity: 0.4; margin-bottom: 0.75rem; }
    .form-input { 
        width: 100%; 
        background: rgba(255, 255, 255, 0.05); 
        border: 1px solid rgba(255, 255, 255, 0.08); 
        padding: 1rem 1.25rem; 
        border-radius: 16px; 
        color: white; 
        font-weight: 500; 
        outline: none; 
        transition: var(--transition); 
    }
    .form-input:focus { border-color: var(--primary-orange); background: rgba(255, 90, 31, 0.02); }
    .form-input::placeholder { color: rgba(255, 255, 255, 0.2); }

    .btn-submit { 
        width: 100%; 
        background: var(--primary-orange); 
        color: white; 
        border: none; 
        padding: 1.1rem 2rem; 
        border-radius: 16px; 
        font-size: 0.9rem; 
        font-weight: 800; 
        text-transform: uppercase; 
        letter-spacing: 1px; 
        transition: var(--transition); 
        cursor: pointer; 
        box-shadow: 0 10px 30px rgba(255, 90, 31, 0.2); 
    }
    .btn-submit:hover { background: var(--primary-orange-hover); transform: translateY(-2px); box-shadow: 0 15px 40px rgba(255, 90, 31, 0.4); }

    /* --- Global Font Size Fixes for Laptop --- */
    @media (min-width: 1024px) {
        .text-\[9px\] { font-size: 11px !important; }
        .text-\[10px\] { font-size: 13px !important; }
        .text-xs { font-size: 0.875rem !important; } /* Equivalent to text-sm */
        .text-sm { font-size: 1rem !important; }    /* Equivalent to text-base */
    }
</style>
