<style>
    .pagination-bar {
        background: rgba(128, 128, 128, 0.05);
        border: 1px solid rgba(128, 128, 128, 0.1);
        border-radius: 24px;
        padding: 1.25rem 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 3rem;
        gap: 1.5rem;
        transition: all 0.3s ease;
    }

    .pagination-info {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: inherit;
        opacity: 0.4;
    }

    .pagination-info span {
        opacity: 1;
        color: var(--primary-orange);
    }

    .pagination-buttons {
        display: flex;
        gap: 0.75rem;
        align-items: center;
    }

    .page-btn {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: rgba(128, 128, 128, 0.08);
        color: inherit;
        font-size: 0.9rem;
        font-weight: 800;
        text-decoration: none;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid transparent;
    }

    .page-btn:hover {
        background: var(--primary-orange);
        color: white !important;
        transform: translateY(-4px);
        box-shadow: 0 8px 20px rgba(255, 90, 31, 0.2);
        border-color: var(--primary-orange);
    }

    .page-btn.active {
        background: var(--primary-orange);
        color: white !important;
        box-shadow: 0 8px 25px rgba(255, 90, 31, 0.4);
        border-color: var(--primary-orange);
    }

    .page-btn.disabled {
        opacity: 0.2;
        pointer-events: none;
    }

    /* Responsive Adjustments */
    @media (max-width: 1024px) {
        .pagination-bar {
            padding: 1rem 1.5rem;
        }
        .page-btn {
            width: 38px;
            height: 38px;
            font-size: 0.85rem;
        }
    }

    @media (max-width: 768px) {
        .pagination-bar {
            flex-direction: column;
            padding: 2rem 1.5rem;
            border-radius: 20px;
            gap: 1.25rem;
        }
        .pagination-info:first-child {
            display: none; 
        }
        .pagination-buttons {
            width: 100%;
            justify-content: center;
        }
    }

    @media (max-width: 480px) {
        .pagination-bar {
            padding: 1.5rem 1rem;
        }
        .pagination-buttons {
            gap: 0.35rem;
        }
        .pagination-info {
            font-size: 0.65rem;
            letter-spacing: 1px;
        }
        .page-btn {
            width: 34px;
            height: 34px;
            font-size: 0.75rem;
            border-radius: 10px;
        }
    }
</style>

<% 
    const isCompact = locals.compact || false;
    const currentPage = locals.currentPage || 1; 
    const limit = locals.limit || 10; 
    const search = locals.search || ""; 
    const status = locals.status || ""; 
    const totalItems = locals.totalCount || 0; 
    const totalPages = locals.totalPages || Math.ceil(totalItems / limit) || 1; 
    
    // Build query portion
    let queryStr = "";
    if (search) queryStr += `&search=${search}`;
    if (status && status.toLowerCase() !== 'all') queryStr += `&status=${status.toLowerCase()}`;
%>

    <div class="pagination-bar <%= isCompact ? 'justify-center' : '' %>">
        <% if (!isCompact) { %>
            <div class="pagination-info">
                SHOWING <span>
                    <%= totalItems > 0 ? (currentPage - 1) * limit + 1 : 0 %>-<%= Math.min(currentPage * limit, totalItems) %>
                </span> OF <span>
                    <%= totalItems %>
                </span> RESULTS
            </div>
        <% } %>

        <div class="pagination-buttons">
            <% if (!isCompact) { %>
                <div class="pagination-info">
                    SHOWING <span>
                        <%= currentPage %>
                    </span> OF <span>
                        <%= totalPages %>
                    </span> PAGES
                </div>
            <% } %>

            <!-- Previous Page -->
            <% if (currentPage > 1) { %>
                <a href="?page=<%= currentPage - 1 %><%= queryStr %>" class="page-btn">
                    <i class="fas fa-chevron-left"></i>
                </a>
            <% } else { %>
                <div class="page-btn disabled"><i class="fas fa-chevron-left"></i></div>
            <% } %>

            <!-- Page Numbers -->
            <% 
               let startPage, endPage;
               if (isCompact) {
                   startPage = currentPage;
                   endPage = currentPage;
               } else {
                   startPage = Math.max(1, currentPage - 2);
                   endPage = Math.min(totalPages, startPage + 4);
                   if (endPage - startPage < 4) startPage = Math.max(1, endPage - 4);
               }
            %>

            <% for(let i = startPage; i <= endPage; i++) { %>
                <a href="?page=<%= i %><%= queryStr %>" class="page-btn <%= currentPage === i ? 'active' : '' %>">
                    <%= i %>
                </a>
            <% } %>

            <!-- Next Page -->
            <% if (currentPage < totalPages) { %>
                <a href="?page=<%= currentPage + 1 %><%= queryStr %>" class="page-btn">
                    <i class="fas fa-chevron-right"></i>
                </a>
            <% } else { %>
                <div class="page-btn disabled"><i class="fas fa-chevron-right"></i></div>
            <% } %>
        </div>
    </div>