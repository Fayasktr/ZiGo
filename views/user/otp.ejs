<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ZiGo | Verify Your Email</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="icon" type="image/png" href="/public/public/favicon.png">
    <style>
        :root {
            --primary-orange: #FF5A1F;
            --primary-orange-hover: #E44D18;
            --deep-black: #0F0F0F;
            --off-white: #F9F9F9;
            --dark-navy: #1E293B;
            --gray-light: #E2E8F0;
            --white: #FFFFFF;
            --transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }

        html,
        body {
            width: 100%;
            height: 100%;
            background-color: var(--deep-black);
            color: var(--white);
            overflow-x: clip;
            line-height: 1.6;
        }

        .otp-container {
            min-height: 100dvh;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: var(--deep-black);
            padding: 2rem;
            position: relative;
            padding-top: clamp(82px, 10vh, 110px);
            overflow: hidden;
        }

        .otp-container::before {
            content: '';
            position: absolute;
            width: 80vw;
            height: 80vw;
            max-width: 1200px;
            max-height: 1200px;
            background: radial-gradient(circle, rgba(255, 90, 31, 0.08) 0%, transparent 70%);
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 1;
            pointer-events: none;
        }

        .otp-card {
            width: 100%;
            max-width: 500px;
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 40px;
            padding: 3.5rem 2.5rem;
            text-align: center;
            z-index: 2;
            box-shadow: 0 40px 100px -20px rgba(0, 0, 0, 0.6);
            opacity: 0;
            transform: translateY(40px);
            transition: all 1s cubic-bezier(0.2, 0.8, 0.2, 1);
        }

        .otp-card.active {
            opacity: 1;
            transform: translateY(0);
        }

        .otp-icon {
            width: 80px;
            height: 80px;
            background: rgba(255, 90, 31, 0.1);
            border-radius: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.5rem;
            color: var(--primary-orange);
            font-size: 2rem;
            box-shadow: 0 8px 16px -4px rgba(255, 90, 31, 0.2);
        }

        .otp-header h2 {
            font-size: clamp(1.75rem, 4vw, 2.25rem);
            font-weight: 800;
            margin-bottom: 0.75rem;
            background: linear-gradient(135deg, #fff 0%, var(--primary-orange) 100%);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            letter-spacing: -0.02em;
        }

        .otp-header p {
            opacity: 0.5;
            margin-bottom: 2.5rem;
            font-size: 0.95rem;
            line-height: 1.6;
        }

        .otp-inputs {
            display: flex;
            gap: 1rem;
            justify-content: center;
            margin-bottom: 2.5rem;
        }

        .otp-field {
            width: clamp(50px, 12vw, 65px);
            height: clamp(60px, 15vw, 75px);
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            font-size: 1.75rem;
            font-weight: 700;
            color: white;
            text-align: center;
            outline: none;
            transition: var(--transition);
        }

        .otp-field:focus {
            border-color: var(--primary-orange);
            background: rgba(255, 255, 255, 0.08);
            box-shadow: 0 0 0 4px rgba(255, 90, 31, 0.15);
            transform: translateY(-2px);
        }

        .verify-btn {
            width: 100%;
            background: var(--primary-orange);
            color: white;
            border: none;
            padding: 1.2rem;
            border-radius: 16px;
            font-size: 1.05rem;
            font-weight: 700;
            cursor: pointer;
            transition: var(--transition);
            margin-bottom: 2rem;
            box-shadow: 0 8px 25px rgba(255, 90, 31, 0.3);
        }

        .verify-btn:hover {
            background: var(--primary-orange-hover);
            transform: translateY(-2px);
            box-shadow: 0 12px 30px rgba(255, 90, 31, 0.4);
        }

        .timer-container {
            font-size: 0.9rem;
            color: rgba(255, 255, 255, 0.4);
            margin-bottom: 1rem;
        }

        #timer {
            color: var(--primary-orange);
            font-weight: 700;
        }

        .resend-link {
            color: var(--primary-orange);
            text-decoration: none;
            font-weight: 700;
            font-size: 0.95rem;
            transition: var(--transition);
        }

        .resend-link:hover:not(.disabled) {
            text-decoration: underline;
            color: var(--primary-orange-hover);
        }

        .resend-link.disabled {
            opacity: 0.3;
            cursor: not-allowed;
            pointer-events: none;
        }

        .error-alert {
            background: rgba(239, 68, 68, 0.1);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(239, 68, 68, 0.2);
            padding: 0.75rem 1rem;
            border-radius: 12px;
            color: #ef4444;
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            animation: shake 0.5s ease-in-out;
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-5px); }
            75% { transform: translateX(5px); }
        }

        /* Responsive */
        @media (max-width: 640px) {
            .otp-container { padding: 1.5rem; padding-top: 80px; }
            .otp-card { padding: 2.5rem 1.5rem; border-radius: 32px; border: none; background: transparent; backdrop-filter: none; box-shadow: none; }
            .otp-inputs { gap: 0.75rem; }
        }

        @keyframes slideDown {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>

<body>
    <%- include('../partials/headerBeforeLogin') %>

    <div class="otp-container">
        <div class="otp-card" id="otpCard">
            <div class="otp-icon">
                <i class="fas fa-shield-alt"></i>
            </div>
            
            <div class="otp-header">
                <h2>Verify Email</h2>
                <p>We've sent a 4-digit code to your email. Enter it below to secure your account.</p>
                
                <% if (error && error.length > 0) { %>
                    <div class="error-alert">
                        <i class="fas fa-exclamation-circle"></i>
                        <span><%= error %></span>
                    </div>
                <% } %>
                
                <div id="clientError" class="error-alert hidden">
                    <i class="fas fa-exclamation-circle"></i>
                    <span id="clientErrorMessage">Numbers only allowed.</span>
                </div>
            </div>

            <form id="otpForm" action="<%= locals.verifyAction || '/verifyOtp' %>" method="POST">
                <div class="otp-inputs">
                    <input type="text" class="otp-field otp-input" maxlength="1" pattern="\d" required autocomplete="one-time-code">
                    <input type="text" class="otp-field otp-input" maxlength="1" pattern="\d" required>
                    <input type="text" class="otp-field otp-input" maxlength="1" pattern="\d" required>
                    <input type="text" class="otp-field otp-input" maxlength="1" pattern="\d" required>
                </div>
                <input type="hidden" name="otp" id="full-otp">
                <input type="hidden" name="userId" value="<%= locals.userId || '' %>">

                <button type="submit" class="verify-btn">Verify Account</button>
            </form>

            <div class="timer-container" id="timerBox">
                Resend code in <span id="timer">01:00</span>
            </div>
            <a href="<%= locals.resendAction || '/resendOtp' %>" class="resend-link disabled" id="resendBtn">Resend Code</a>
        </div>
    </div>

    <script>
        const inputs = document.querySelectorAll('.otp-input');
        const form = document.getElementById('otpForm');
        const fullOtpInput = document.getElementById('full-otp');
        const timerDisplay = document.getElementById('timer');
        const resendBtn = document.getElementById('resendBtn');
        const timerBox = document.getElementById('timerBox');

        // --- PASTE LOGIC ---
        inputs[0].addEventListener("paste", (event) => {
            event.preventDefault();
            const pasteData = event.clipboardData.getData("text");
            const clientError = document.getElementById('clientError');

            if (/[^0-9]/.test(pasteData)) {
                clientError.classList.remove('hidden');
                setTimeout(() => {
                    clientError.classList.add('hidden');
                }, 2000);
            }

            const otpArray = pasteData.replace(/[^0-9]/g, '').split('');
            otpArray.forEach((char, index) => {
                if (inputs[index]) {
                    inputs[index].value = char;
                }
            });

            const nextFocusIndex = Math.min(otpArray.length, inputs.length - 1);
            if (inputs[nextFocusIndex]) inputs[nextFocusIndex].focus();
            updateFullOtp();
        });

        // --- TIMER LOGIC ---
        let timeLeft;
        let countdown;

        function startTimer() {
            resendBtn.classList.add('disabled');
            timerBox.style.display = 'block';

            const expiryTime = Number("<%=otpTime%>");
            const currentTime = Date.now();
            timeLeft = Math.max(0, Math.floor((expiryTime - currentTime) / 1000));

            updateTimerDisplay();

            clearInterval(countdown);
            countdown = setInterval(() => {
                timeLeft--;

                if (timeLeft <= 0) {
                    clearInterval(countdown);
                    timeLeft = 0;
                    updateTimerDisplay();
                    timerBox.style.display = 'none';
                    resendBtn.classList.remove('disabled');
                } else {
                    updateTimerDisplay();
                }
            }, 1000);
        }

        function updateTimerDisplay() {
            const mins = Math.floor(timeLeft / 60);
            const secs = timeLeft % 60;
            timerDisplay.textContent = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
        }

        inputs.forEach((input, index) => {
            input.addEventListener('input', (e) => {
                const val = e.target.value;
                const clientError = document.getElementById('clientError');
                
                if (val && !/^\d$/.test(val)) {
                    e.target.value = '';
                    clientError.classList.remove('hidden');
                    setTimeout(() => {
                        clientError.classList.add('hidden');
                    }, 2000);
                    return;
                }

                if (val.length == 1 && index < inputs.length - 1) {
                    inputs[index + 1].focus();
                }
                updateFullOtp();
            });

            input.addEventListener('keydown', (e) => {
                if (e.key == 'Backspace' && !e.target.value && index > 0) {
                    inputs[index - 1].focus();
                }
            });
        });

        function updateFullOtp() {
            let otp = '';
            inputs.forEach(input => otp += input.value);
            fullOtpInput.value = otp;
        }

        form.addEventListener('submit', (e) => {
            updateFullOtp();
            if (fullOtpInput.value.length != inputs.length) {
                e.preventDefault();
            }
        });

        window.onload = () => {
            document.getElementById('otpCard').classList.add('active');
            inputs[0].focus();
            startTimer();
        };
    </script>
</body>

</html>

