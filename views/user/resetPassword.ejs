<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ZiGo | Reset Password</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="icon" type="image/png" href="/public/public/favicon.png">
    <style>
        :root {
            --primary-orange: #FF5A1F;
            --primary-orange-hover: #E44D18;
            --deep-black: #0F0F0F;
            --off-white: #F9F9F9;
            --dark-navy: #1E293B;
            --gray-light: #E2E8F0;
            --white: #FFFFFF;
            --transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }

        html,
        body {
            width: 100%;
            height: 100%;
            background-color: var(--deep-black);
            color: var(--white);
            overflow-x: clip;
            line-height: 1.6;
            display: flex;
            flex-direction: column;
        }

        .reset-container {
            min-height: 100dvh;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: var(--deep-black);
            padding: 2rem;
            position: relative;
            padding-top: clamp(82px, 10vh, 110px);
            flex: 1;
            overflow: hidden;
        }

        .reset-container::before {
            content: '';
            position: absolute;
            width: 80vw;
            height: 80vw;
            max-width: 1200px;
            max-height: 1200px;
            background: radial-gradient(circle, rgba(255, 90, 31, 0.08) 0%, transparent 70%);
            bottom: -20%;
            left: -20%;
            z-index: 1;
            pointer-events: none;
        }

        .reset-card {
            width: 100%;
            max-width: 1100px;
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 32px;
            display: flex;
            overflow: hidden;
            z-index: 2;
            box-shadow: 0 40px 100px -20px rgba(0, 0, 0, 0.6);
            opacity: 0;
            transform: translateY(40px);
            transition: all 1s cubic-bezier(0.2, 0.8, 0.2, 1);
        }

        .reset-card.active {
            opacity: 1;
            transform: translateY(0);
        }

        .reset-visual {
            flex: 1.2;
            background: url('/public/login/login-bg.png') center/cover no-repeat;
            display: none;
            position: relative;
            min-height: 500px;
        }

        .reset-visual::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(to right, rgba(15, 15, 15, 0.85), transparent);
        }

        .reset-form-side {
            flex: 1;
            padding: 3.5rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
            background: rgba(255, 255, 255, 0.01);
        }

        .reset-header h2 {
            font-size: clamp(2rem, 5vw, 2.75rem);
            font-weight: 800;
            margin-bottom: 0.75rem;
            background: linear-gradient(135deg, #fff 0%, var(--primary-orange) 100%);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            letter-spacing: -0.02em;
        }

        .reset-header p {
            opacity: 0.5;
            margin-bottom: 2.5rem;
            font-size: 1.05rem;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-group label {
            display: block;
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 0.6rem;
            opacity: 0.7;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .input-wrapper input {
            width: 100%;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.1);
            padding: 1.1rem 1.25rem;
            border-radius: 14px;
            color: white;
            font-size: 1rem;
            outline: none;
            transition: var(--transition);
        }

        .input-wrapper input:focus {
            border-color: var(--primary-orange);
            background: rgba(255, 255, 255, 0.08);
            box-shadow: 0 0 0 4px rgba(255, 90, 31, 0.15);
        }

        .reset-btn {
            width: 100%;
            background: var(--primary-orange);
            color: white;
            border: none;
            padding: 1.2rem;
            border-radius: 14px;
            font-size: 1.05rem;
            font-weight: 700;
            cursor: pointer;
            transition: var(--transition);
            margin-top: 1rem;
            box-shadow: 0 8px 25px rgba(255, 90, 31, 0.25);
        }

        .reset-btn:hover {
            background: var(--primary-orange-hover);
            transform: translateY(-2px);
            box-shadow: 0 12px 30px rgba(255, 90, 31, 0.4);
        }

        .eye-toggle {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            color: white;
            opacity: 0.6;
            display: flex;
            align-items: center;
            transition: var(--transition);
        }

        .eye-toggle:hover {
            opacity: 1;
            color: var(--primary-orange);
        }

        /* Responsive */
        @media (min-width: 1024px) {
            .reset-visual { display: block; }
        }

        @media (max-width: 1023px) {
            .reset-container { padding: 1.5rem; padding-top: 90px; }
            .reset-card { max-width: 540px; border-radius: 24px; }
            .reset-form-side { padding: 2.5rem; }
        }

        @media (max-width: 640px) {
            .reset-container { padding: 1rem; padding-top: 80px; }
            .reset-card { border-radius: 20px; border: none; background: transparent; backdrop-filter: none; box-shadow: none; }
            .reset-form-side { padding: 1.5rem 0.5rem; }
            .reset-header h2 { font-size: 2.25rem; }
        }

        @media (max-width: 480px) {
            .reset-container { padding-top: 70px; }
            .reset-header h2 { font-size: 2rem; }
        }

        @keyframes slideDown {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>

<body>
    <%- include('../partials/headerBeforeLogin') %>

    <div class="reset-container">
        <div class="reset-card" id="resetCard">
            <div class="reset-visual">
                <div class="absolute bottom-12 left-12 z-10 p-8">
                    <h3 class="text-3xl font-extrabold text-white mb-2">Security First.</h3>
                    <p class="text-white/60">Choose a strong password to protect your account.</p>
                </div>
            </div>

            <div class="reset-form-side">
                <div class="reset-header">
                    <h2>Set New Password</h2>
                    <p>Create a strong password that you haven't used before. Minimum 8 characters required.</p>
                    
                    <% if (locals.error && error.length > 0) { %>
                        <div class="error-alert mb-6 bg-red-500/10 border border-red-500/20 p-4 rounded-xl text-red-500 flex items-center gap-3">
                            <i class="fas fa-exclamation-circle"></i>
                            <span class="text-sm font-semibold"><%= error %></span>
                        </div>
                    <% } %>

                    <% if(locals.email && email.includes("@")){ 
                        const [name, domain] = email.split("@"); 
                        const masked = name.slice(0,2) + "*".repeat(Math.max(name.length - 2,1)) + "@" + domain; %>
                        <p class="text-white/40 text-sm mb-4">Resetting for: <span class="text-white"><%= masked %></span></p>
                    <% } %>
                </div>

                <form action="/resetPassword" method="POST">
                    <input type="hidden" name="email" value="<%= locals.email %>">

                    <div class="form-group">
                        <label for="newPass">New Password</label>
                        <div class="input-wrapper" style="position: relative;">
                            <input type="password" id="newPass" name="newPass" placeholder="••••••••" required style="padding-right: 45px;">
                            <button type="button" onclick="togglePassword('newPass', 'eye-open-1', 'eye-closed-1')" class="eye-toggle">
                                <svg id="eye-open-1" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                                <svg id="eye-closed-1" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                    <line x1="1" y1="1" x2="23" y2="23"></line>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="conformPass">Confirm New Password</label>
                        <div class="input-wrapper" style="position: relative;">
                            <input type="password" id="conformPass" name="conformPass" placeholder="••••••••" required style="padding-right: 45px;">
                            <button type="button" onclick="togglePassword('conformPass', 'eye-open-2', 'eye-closed-2')" class="eye-toggle">
                                <svg id="eye-open-2" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                                <svg id="eye-closed-2" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                    <line x1="1" y1="1" x2="23" y2="23"></line>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="reset-btn">Update Password & Login</button>
                </form>
            </div>
        </div>
    </div>

    <%- include('../partials/footer') %>

    <script>
        window.onload = () => {
            document.getElementById('resetCard').classList.add('active');
        }

        function togglePassword(inputId, openEyeId, closedEyeId) {
            const passwordInput = document.getElementById(inputId);
            const eyeOpen = document.getElementById(openEyeId);
            const eyeClosed = document.getElementById(closedEyeId);

            if (passwordInput.type === "password") {
                passwordInput.type = "text";
                eyeOpen.style.display = "none";
                eyeClosed.style.display = "block";
            } else {
                passwordInput.type = "password";
                eyeOpen.style.display = "block";
                eyeClosed.style.display = "none";
            }
        }
    </script>
</body>

</html>

