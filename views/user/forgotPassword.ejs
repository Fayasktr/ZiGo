<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ZiGo | Forgot Password</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="icon" type="image/png" href="/public/public/favicon.png">
    <style>
        :root {
            --primary-orange: #FF5A1F;
            --primary-orange-hover: #E44D18;
            --deep-black: #0F0F0F;
            --off-white: #F9F9F9;
            --dark-navy: #1E293B;
            --gray-light: #E2E8F0;
            --white: #FFFFFF;
            --transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }

        html,
        body {
            width: 100%;
            height: 100%;
            background-color: var(--deep-black);
            color: var(--white);
            overflow-x: clip;
            line-height: 1.6;
            display: flex;
            flex-direction: column;
        }

        .forgot-container {
            min-height: 100dvh;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: var(--deep-black);
            padding: 2rem;
            position: relative;
            padding-top: clamp(82px, 10vh, 110px);
            flex: 1;
            overflow: hidden;
        }

        .forgot-container::before {
            content: '';
            position: absolute;
            width: 80vw;
            height: 80vw;
            max-width: 1200px;
            max-height: 1200px;
            background: radial-gradient(circle, rgba(255, 90, 31, 0.08) 0%, transparent 70%);
            top: -20%;
            right: -20%;
            z-index: 1;
            pointer-events: none;
        }

        .forgot-card {
            width: 100%;
            max-width: 1100px;
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 32px;
            display: flex;
            overflow: hidden;
            z-index: 2;
            box-shadow: 0 40px 100px -20px rgba(0, 0, 0, 0.6);
            opacity: 0;
            transform: translateY(40px);
            transition: all 1s cubic-bezier(0.2, 0.8, 0.2, 1);
        }

        .forgot-card.active {
            opacity: 1;
            transform: translateY(0);
        }

        .forgot-visual {
            flex: 1.2;
            background: url('/public/login/login-bg.png') center/cover no-repeat;
            display: none;
            position: relative;
            min-height: 500px;
        }

        .forgot-visual::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(to right, rgba(15, 15, 15, 0.85), transparent);
        }

        .forgot-form-side {
            flex: 1;
            padding: 3.5rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
            background: rgba(255, 255, 255, 0.01);
        }

        .forgot-header h2 {
            font-size: clamp(2rem, 5vw, 2.75rem);
            font-weight: 800;
            margin-bottom: 0.75rem;
            background: linear-gradient(135deg, #fff 0%, var(--primary-orange) 100%);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            letter-spacing: -0.02em;
        }

        .forgot-header p {
            opacity: 0.5;
            margin-bottom: 2.5rem;
            font-size: 1.05rem;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-group label {
            display: block;
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 0.6rem;
            opacity: 0.7;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .input-wrapper input {
            width: 100%;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.1);
            padding: 1.1rem 1.25rem;
            border-radius: 14px;
            color: white;
            font-size: 1rem;
            outline: none;
            transition: var(--transition);
        }

        .input-wrapper input:focus {
            border-color: var(--primary-orange);
            background: rgba(255, 255, 255, 0.08);
            box-shadow: 0 0 0 4px rgba(255, 90, 31, 0.15);
        }

        .submit-btn {
            width: 100%;
            background: var(--primary-orange);
            color: white;
            border: none;
            padding: 1.2rem;
            border-radius: 14px;
            font-size: 1.05rem;
            font-weight: 700;
            cursor: pointer;
            transition: var(--transition);
            margin-top: 1rem;
            box-shadow: 0 8px 25px rgba(255, 90, 31, 0.25);
        }

        .submit-btn:hover {
            background: var(--primary-orange-hover);
            transform: translateY(-2px);
            box-shadow: 0 12px 30px rgba(255, 90, 31, 0.4);
        }

        .back-to-login {
            text-align: center;
            margin-top: 2rem;
            opacity: 0.6;
            font-size: 0.95rem;
        }

        .back-to-login a {
            color: var(--primary-orange);
            text-decoration: none;
            font-weight: 700;
            transition: var(--transition);
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .back-to-login a:hover {
            color: var(--primary-orange-hover);
            text-decoration: underline;
        }

        /* Responsive */
        @media (min-width: 1024px) {
            .forgot-visual { display: block; }
        }

        @media (max-width: 1023px) {
            .forgot-container { padding: 1.5rem; padding-top: 90px; }
            .forgot-card { max-width: 540px; border-radius: 24px; }
            .forgot-form-side { padding: 2.5rem; }
        }

        @media (max-width: 640px) {
            .forgot-container { padding: 1rem; padding-top: 80px; }
            .forgot-card { border-radius: 20px; border: none; background: transparent; backdrop-filter: none; box-shadow: none; }
            .forgot-form-side { padding: 1.5rem 0.5rem; }
            .forgot-header h2 { font-size: 2.25rem; }
        }

        @media (max-width: 480px) {
            .forgot-container { padding-top: 70px; }
            .forgot-header h2 { font-size: 2rem; }
        }

        @keyframes slideDown {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>

<body>
    <%- include('../partials/headerBeforeLogin') %>

    <div class="forgot-container">
        <div class="forgot-card" id="forgotCard">
            <div class="forgot-visual">
                <div class="absolute bottom-12 left-12 z-10 p-8">
                    <h3 class="text-3xl font-extrabold text-white mb-2">Secure Your Account</h3>
                    <p class="text-white/60">We'll help you get back into ZiGo.</p>
                </div>
            </div>

            <div class="forgot-form-side">
                <div class="forgot-header">
                    <h2>Forgot Password?</h2>
                    <p>No worries, it happens. Enter your email address and we'll send you a link to reset your password.</p>
                    
                    <% if (locals.error && error.length > 0) { %>
                        <div class="error-alert mb-6 bg-red-500/10 border border-red-500/20 p-4 rounded-xl text-red-500 flex items-center gap-3">
                            <i class="fas fa-exclamation-circle"></i>
                            <span class="text-sm font-semibold"><%= error %></span>
                        </div>
                    <% } %>
                    
                    <% if (locals.success && success.length > 0) { %>
                        <div class="success-alert mb-6 bg-green-500/10 border border-green-500/20 p-4 rounded-xl text-green-500 flex items-center gap-3">
                            <i class="fas fa-check-circle"></i>
                            <span class="text-sm font-semibold"><%= success %></span>
                        </div>
                    <% } %>
                </div>

                <form action="/forgotPassword" method="POST">
                    <div class="form-group">
                        <label>Email Address</label>
                        <div class="input-wrapper">
                            <input type="email" name="email" placeholder="name@example.com" required>
                        </div>
                    </div>

                    <button type="submit" class="submit-btn">Send Reset Link</button>
                </form>

                <p class="back-to-login">
                    <a href="/login">
                        <i class="fas fa-arrow-left"></i>
                        Back to Login
                    </a>
                </p>
            </div>
        </div>
    </div>

    <%- include('../partials/footer') %>

    <script>
        window.onload = () => {
            document.getElementById('forgotCard').classList.add('active');
        }
    </script>
</body>

</html>

