<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ZiGo | My Account</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="icon" type="image/png" href="/public/public/favicon.png">
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        :root {
            --primary-orange: #FF5A1F;
            --primary-orange-hover: #E44D18;
            --deep-black: #0F0F0F;
            --off-white: #F9F9F9;
            --dark-navy: #1E293B;
            --gray-light: #E2E8F0;
            --white: #FFFFFF;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }

        body {
            background-color: var(--off-white);
            color: var(--dark-navy);
            overflow-x: hidden;
            line-height: 1.6;
        }

        /* --- Profile Container --- */
        .profile-container {
            padding: 140px 5% 80px;
            max-width: 1400px;
            margin: 0 auto;
        }

        .profile-layout {
            display: grid;
            grid-template-columns: 320px 1fr;
            gap: 3rem;
        }

        @media (max-width: 1024px) {
            .profile-layout {
                grid-template-columns: 1fr;
            }
        }

        /* --- Sidebar --- */
        .profile-sidebar {
            background: white;
            border-radius: 32px;
            padding: 2.5rem;
            border: 1px solid var(--gray-light);
            height: min-content;
            position: sticky;
            top: 120px;
        }

        .user-info {
            text-align: center;
            margin-bottom: 2.5rem;
            padding-bottom: 2rem;
            border-bottom: 1px solid var(--gray-light);
        }

        .user-avatar-large {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            border: 4px solid var(--primary-orange);
            margin: 0 auto 1.5rem;
            overflow: hidden;
            box-shadow: 0 10px 20px rgba(255, 90, 31, 0.15);
        }

        .user-avatar-large img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .user-name {
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--dark-navy);
        }

        .user-email {
            font-size: 0.9rem;
            opacity: 0.5;
        }

        .sidebar-nav {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 1.2rem;
            padding: 1.1rem 1.5rem;
            border-radius: 16px;
            text-decoration: none;
            color: var(--dark-navy);
            font-weight: 600;
            transition: var(--transition);
            cursor: pointer;
        }

        .sidebar-link i {
            font-size: 1.2rem;
            width: 24px;
            text-align: center;
            opacity: 0.4;
            transition: var(--transition);
        }

        .sidebar-link:hover {
            background: var(--off-white);
            color: var(--primary-orange);
        }

        .sidebar-link:hover i {
            opacity: 1;
            color: var(--primary-orange);
        }

        .sidebar-link.active {
            background: var(--primary-orange);
            color: white;
            box-shadow: 0 10px 20px rgba(255, 90, 31, 0.2);
        }

        .sidebar-link.active i {
            opacity: 1;
            color: white;
        }

        .logout-link {
            margin-top: 1rem;
            color: #ff4757;
        }

        .logout-link:hover {
            background: rgba(255, 71, 87, 0.1);
            color: #ff4757;
        }

        /* --- Content Panels --- */
        .panel-header {
            margin-bottom: 2.5rem;
        }

        .panel-title {
            font-size: 2.5rem;
            font-weight: 800;
            color: var(--dark-navy);
        }

        /* --- Form Elements --- */
        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-label {
            display: block;
            font-size: 0.75rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1px;
            opacity: 0.4;
            margin-bottom: 0.5rem;
        }

        .form-input {
            width: 100%;
            padding: 1rem 1.5rem;
            border-radius: 16px;
            border: 2px solid var(--gray-light);
            font-weight: 600;
            outline: none;
            transition: var(--transition);
        }

        .form-input:focus {
            border-color: var(--primary-orange);
            box-shadow: 0 0 0 4px rgba(255, 90, 31, 0.1);
        }

        .save-btn {
            width: 100%;
            background: var(--deep-black);
            color: white;
            padding: 1.2rem;
            border-radius: 20px;
            font-weight: 800;
            transition: var(--transition);
            border: none;
            cursor: pointer;
        }

        .save-btn:hover {
            background: var(--primary-orange);
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(255, 90, 31, 0.2);
        }
    

        .profile-content {
            min-width: 0;
            width: 100%;
        }

        .mobile-sidebar-toggle,
        .mobile-sidebar-close,
        .sidebar-backdrop {
            display: none;
        }

        @media (max-width: 1024px) {
            .profile-container {
                padding: 108px 0.9rem 40px;
            }

            .profile-layout {
                display: block;
            }

            .profile-sidebar {
                position: fixed;
                top: 0;
                left: 0;
                width: min(84vw, 320px);
                height: 100dvh;
                padding: 1rem;
                border-radius: 0 22px 22px 0;
                transform: translateX(-104%);
                transition: transform 0.28s ease;
                z-index: 1200;
                overflow-y: auto;
                box-shadow: 0 20px 48px rgba(0, 0, 0, 0.2);
            }

            .profile-sidebar.active {
                transform: translateX(0);
            }

            .mobile-sidebar-close {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 34px;
                height: 34px;
                margin-left: auto;
                margin-bottom: 0.8rem;
                border-radius: 10px;
                border: 1px solid var(--gray-light);
                background: #fff;
                color: var(--dark-navy);
                cursor: pointer;
            }

            .sidebar-backdrop {
                display: block;
                position: fixed;
                inset: 0;
                background: rgba(15, 15, 15, 0.45);
                backdrop-filter: blur(2px);
                opacity: 0;
                visibility: hidden;
                pointer-events: none;
                transition: var(--transition);
                z-index: 1100;
            }

            .sidebar-backdrop.active {
                opacity: 1;
                visibility: visible;
                pointer-events: auto;
            }

            .mobile-sidebar-toggle {
                display: inline-flex;
                align-items: center;
                gap: 0.45rem;
                border: 1px solid var(--gray-light);
                background: #fff;
                color: var(--dark-navy);
                border-radius: 12px;
                padding: 0.6rem 0.9rem;
                font-size: 0.82rem;
                font-weight: 700;
                margin-bottom: 1rem;
                cursor: pointer;
            }

            .panel-title {
                font-size: 1.8rem;
            }

            .user-info {
                margin-bottom: 1.25rem;
                padding-bottom: 1rem;
            }

            .user-avatar-large {
                width: 72px;
                height: 72px;
                margin-bottom: 0.7rem;
            }

            .user-name {
                font-size: 1.1rem;
            }

            .user-email {
                font-size: 0.78rem;
            }

            .sidebar-nav {
                gap: 0.35rem;
            }

            .sidebar-link {
                padding: 0.72rem 0.8rem;
                font-size: 0.84rem;
                border-radius: 12px;
                gap: 0.6rem;
            }

            .sidebar-link i {
                font-size: 0.92rem;
            }
        }

        @media (max-width: 640px) {
            .profile-container {
                padding: 96px 0.65rem 34px;
            }

            .mobile-sidebar-toggle {
                width: 100%;
                justify-content: center;
                margin-bottom: 0.85rem;
            }

            .panel-title {
                font-size: 1.5rem;
            }
        }

    </style>
</head>

<body>
    <%- include('../../partials/header') %>

        <main class="profile-container">
            <div class="profile-layout">
                <!-- Sidebar -->
                <aside class="profile-sidebar" id="profileSidebar">
                    <button type="button" class="mobile-sidebar-close" id="profileSidebarClose" aria-label="Close menu">
                        <i class="fas fa-times"></i>
                    </button>
                    <div class="user-info">
                        <div class="user-avatar-large">
                            <% if (user && user.profileImage) { %>
                                <img src="<%= user.profileImage %>" alt="User Avatar">
                                <% } else { %>
                                    <img src="https://ui-avatars.com/api/?name=<%= user.userName %>&background=FF5A1F&color=fff"
                                        alt="User Avatar">
                                    <% } %>
                        </div>
                        <h2 class="user-name">
                            <%= user.userName %>
                        </h2>
                        <p class="user-email">
                            <%= user.email %>
                        </p>
                    </div>

                    <nav class="sidebar-nav">
                        <a href="/user/profile" class="sidebar-link active">
                            <i class="fas fa-th-large"></i> Overview
                        </a>
                        <a href="/user/orders" class="sidebar-link">
                            <i class="fas fa-shopping-bag"></i> Order History
                        </a>
                        <a href="/user/wallet" class="sidebar-link">
                            <i class="fas fa-wallet"></i> My Wallet
                        </a>
                        <a href="/user/wishlist" class="sidebar-link">
                            <i class="fas fa-heart"></i> Wishlist
                        </a>
                        <a href="/user/addresses" class="sidebar-link">
                            <i class="fas fa-map-marker-alt"></i> Addresses
                        </a>
                        <a href="/user/cart" class="sidebar-link">
                            <i class="fas fa-shopping-cart"></i> My Cart
                        </a>
                        <a href="/logout" class="sidebar-link logout-link">
                            <i class="fas fa-sign-out-alt"></i> Logout
                        </a>
                    </nav>
                </aside>

                <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

                <!-- Main Content Area -->
                <div class="profile-content">
                    <button type="button" class="mobile-sidebar-toggle" id="profileSidebarToggle" aria-controls="profileSidebar" aria-expanded="false">
                        <i class="fas fa-bars"></i>
                        <span>Profile Menu</span>
                    </button>
                    <!-- Overview Panel -->
                    <div id="overview-panel">
                        <div class="panel-header">
                            <h1 class="panel-title">Account <span class="text-orange-500">Overview</span></h1>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
                            <div class="bg-white p-8 rounded-[32px] border border-gray-100">
                                <div class="flex items-center justify-between mb-4">
                                    <h3 class="text-lg font-bold opacity-40 uppercase tracking-widest">Personal Details
                                    </h3>
                                    <div class="w-10 h-10 rounded-full border-2 border-orange-500 overflow-hidden">
                                        <% if (user && user.profileImage) { %>
                                            <img src="<%= user.profileImage %>" alt="User"
                                                class="w-full h-full object-cover">
                                            <% } else { %>
                                                <img src="https://ui-avatars.com/api/?name=<%= user.userName %>&background=FF5A1F&color=fff"
                                                    alt="User" class="w-full h-full object-cover">
                                                <% } %>
                                    </div>
                                </div>
                                <p class="text-xl font-bold">
                                    <%= user.userName %>
                                </p>
                                <p class="opacity-60 mb-6">
                                    <%= user.email %>
                                </p>
                                <a href="/user/profile/edit"
                                    class="text-orange-500 font-bold text-sm hover:underline">Edit
                                    Profile</a>
                            </div>
                            <div class="bg-white p-8 rounded-[32px] border border-gray-100">
                                <h3 class="text-lg font-bold mb-4 opacity-40 uppercase tracking-widest">Default Address
                                </h3>
                                <% // Robust check: handles both a single object or an array of addresses let
                                    primaryAddr=null; if (typeof defaultAddres !=='undefined' && defaultAddres) { if
                                    (Array.isArray(defaultAddres)) { primaryAddr=defaultAddres.find(a=> a.isDefault);
                                    } else {
                                    // It's a single object from showProfileData findOne()
                                    primaryAddr = defaultAddres;
                                    }
                                    }
                                    %>

                                    <% if (primaryAddr) { %>
                                        <p class="font-bold">
                                            <%= primaryAddr.addressType.charAt(0).toUpperCase() +
                                                primaryAddr.addressType.slice(1) %>
                                        </p>
                                        <p class="opacity-60 text-sm mb-6">
                                            <%= primaryAddr.detailedAddress %>,<br>
                                                <%= primaryAddr.city %>, <%= primaryAddr.pincode %>
                                        </p>
                                        <% } else { %>
                                            <p class="opacity-60 text-sm mb-6">No default address set.</p>
                                            <% } %>
                                                <a href="/user/addresses"
                                                    class="text-orange-500 font-bold text-sm hover:underline">Manage
                                                    Addresses</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <%- include('../../partials/footer') %>


            <!-- Hidden data for flash messages -->
            <div id="flash-data"
                data-error="<%= (typeof error !== 'undefined' && error && error.length > 0) ? error : '' %>"
                data-success="<%= (typeof success !== 'undefined' && success && success.length > 0) ? success : '' %>"
                style="display: none;">
            </div>

            <script>
                // SweetAlert2 Toast configuration
                const Toast = Swal.mixin({
                    toast: true,
                    position: 'top',
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true,
                    didOpen: (toast) => {
                        toast.addEventListener('mouseenter', Swal.stopTimer)
                        toast.addEventListener('mouseleave', Swal.resumeTimer)
                    }
                });

                // Get messages from data attributes
                const flashData = document.getElementById('flash-data');
                const errorMsg = flashData.dataset.error;
                const successMsg = flashData.dataset.success;

                if (errorMsg && errorMsg.trim().length > 0) {
                    Toast.fire({
                        icon: 'error',
                        title: errorMsg
                    });
                }

                if (successMsg && successMsg.trim().length > 0) {
                    Toast.fire({
                        icon: 'success',
                        title: successMsg
                    });
                }
            </script>

    <script>
        (() => {
            const sidebar = document.getElementById('profileSidebar');
            const toggleBtn = document.getElementById('profileSidebarToggle');
            const closeBtn = document.getElementById('profileSidebarClose');
            const backdrop = document.getElementById('sidebarBackdrop');

            if (!sidebar || !toggleBtn || !closeBtn || !backdrop) return;

            const mobileMedia = window.matchMedia('(max-width: 1024px)');

            const setSidebarState = (isOpen) => {
                if (!mobileMedia.matches) {
                    sidebar.classList.remove('active');
                    backdrop.classList.remove('active');
                    toggleBtn.setAttribute('aria-expanded', 'false');
                    document.body.style.overflow = '';
                    return;
                }

                sidebar.classList.toggle('active', isOpen);
                backdrop.classList.toggle('active', isOpen);
                toggleBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
                document.body.style.overflow = isOpen ? 'hidden' : '';
            };

            toggleBtn.addEventListener('click', () => setSidebarState(true));
            closeBtn.addEventListener('click', () => setSidebarState(false));
            backdrop.addEventListener('click', () => setSidebarState(false));

            document.addEventListener('keydown', (event) => {
                if (event.key === 'Escape') setSidebarState(false);
            });

            window.addEventListener('resize', () => {
                if (!mobileMedia.matches) setSidebarState(false);
            });

            sidebar.querySelectorAll('a').forEach((link) => {
                link.addEventListener('click', () => setSidebarState(false));
            });
        })();
    </script>

</body>

</html>