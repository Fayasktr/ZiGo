<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ZiGo | Order Success</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="icon" type="image/png" href="/public/public/favicon.png">
    <style>
        :root {
            --primary-orange: #FF5A1F;
            --primary-orange-hover: #E44D18;
            --deep-black: #0F0F0F;
            --off-white: #F9F9F9;
            --dark-navy: #1E293B;
            --gray-light: #E2E8F0;
            --white: #FFFFFF;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }

        body {
            background-color: var(--off-white);
            color: var(--dark-navy);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .success-container {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 120px 5% 80px;
        }

        .success-card {
            background: white;
            max-width: 550px;
            width: 100%;
            border-radius: 40px;
            padding: 4rem 3rem;
            text-align: center;
            border: 1px solid var(--gray-light);
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.05);
            animation: cardPop 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        @keyframes cardPop {
            from { transform: scale(0.9); opacity: 0; }
            to { transform: scale(1); opacity: 1; }
        }

        .success-icon {
            width: 100px;
            height: 100px;
            background: #E7F9F0;
            color: #2ED573;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            margin: 0 auto 2.5rem;
        }

        .btn-primary {
            display: block;
            width: 100%;
            background: var(--primary-orange);
            color: white;
            font-weight: 800;
            padding: 1.25rem;
            border-radius: 20px;
            transition: var(--transition);
            margin-bottom: 1rem;
        }

        .btn-primary:hover {
            background: var(--primary-orange-hover);
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(255, 90, 31, 0.2);
        }

        .btn-secondary {
            display: block;
            width: 100%;
            background: var(--off-white);
            color: var(--dark-navy);
            font-weight: 700;
            padding: 1.25rem;
            border-radius: 20px;
            transition: var(--transition);
        }

        .btn-secondary:hover {
            background: var(--gray-light);
            transform: translateY(-2px);
        }
    </style>
</head>

<body>
    <%- include('../../partials/headerMinimal') %>

    <main class="success-container">
        <div class="success-card">
            <div class="success-icon">
                <i class="fas fa-check"></i>
            </div>
            <h1 class="text-4xl font-black mb-4">Order Placed!</h1>
            <p class="text-gray-500 mb-10 text-lg">Thank you for shopping with ZiGo. Your order has been successfully placed and is now being processed.</p>
            
            <div class="space-y-4">
                <a href="/shop" class="btn-primary">
                    <i class="fas fa-shopping-bag mr-2"></i> Continue Shopping
                </a>
                <a href="/user/orders" class="btn-secondary">
                    <i class="fas fa-list-ul mr-2"></i> View Order Details
                </a>
            </div>
        </div>
    </main>

    <%- include('../../partials/footerMinimal') %>
</body>

</html>
