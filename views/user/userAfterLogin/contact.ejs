<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact ZiGo | 24/7 Tech Support</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="icon" type="image/png" href="/public/public/favicon.png">
    <style>
        :root {
            --primary-orange: #FF5A1F;
            --primary-orange-hover: #E44D18;
            --deep-black: #0F0F0F;
            --off-white: #F9F9F9;
            --dark-navy: #1E293B;
            --gray-light: #E2E8F0;
            --white: #FFFFFF;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }

        body {
            background-color: var(--off-white);
            color: var(--dark-navy);
            overflow-x: hidden;
            line-height: 1.6;
        }

        .light-theme {
            background-color: var(--white);
            color: var(--deep-black);
        }

        .reveal {
            opacity: 0;
            transform: translateY(30px);
            transition: all 0.8s ease-out;
        }

        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }

        .social-icon-btn.dark {
            background: rgba(0, 0, 0, 0.05);
            border: 1px solid rgba(0, 0, 0, 0.1);
            color: #0F0F0F;
            width: 48px;
            height: 48px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition);
        }

        .social-icon-btn.dark:hover {
            background: var(--primary-orange);
            border-color: var(--primary-orange);
            color: white;
            transform: translateY(-3px);
        }
    </style>
</head>

<body>
    <%- include('../../partials/header') %>

    <main class="pt-24 md:pt-32">
        <!-- Contact Hero -->
        <section class="hero flex flex-col items-center text-center gap-6 py-20 md:py-32"
            style="background: linear-gradient(to bottom, #F8FAFC, #FFFFFF);">
            <div class="px-5">
                <span class="text-[#FF5A1F] font-bold tracking-widest uppercase text-sm mb-4 block text-center">Contact Support</span>
                <h1 class="text-4xl md:text-6xl lg:text-7xl font-extrabold max-w-4xl text-[#0F0F0F] leading-[1.1]">
                    We're Here to <span class="text-[#FF5A1F]">Help You.</span>
                </h1>
                <p class="max-w-2xl mx-auto mt-8 text-[#0F0F0F]/70 text-lg md:text-xl font-light">
                    Have a question about a product or an order? Our team of tech experts is ready to assist you.
                </p>
            </div>
        </section>

        <!-- Main Contact Section -->
        <section id="contact" class="reveal py-20 bg-white">
            <div class="max-w-6xl mx-auto px-5 grid grid-cols-1 lg:grid-cols-2 gap-16">
                <div class="contact-info space-y-12">
                    <div>
                        <h2 class="text-4xl font-black mb-6 tracking-tight text-gray-900">Get in Touch</h2>
                        <p class="text-gray-500 mb-10 text-lg leading-relaxed font-light">Reach out through any of these channels. We typically respond within 12-24 hours.</p>
                    </div>

                    <div class="space-y-6">
                        <div class="flex items-start gap-6 p-6 rounded-[32px] hover:bg-orange-500/5 transition-all duration-300 border border-gray-50 hover:border-orange-500/20 group">
                            <div class="w-16 h-16 rounded-2xl bg-orange-500/10 flex items-center justify-center text-3xl group-hover:scale-110 transition-transform">📍</div>
                            <div>
                                <h4 class="font-black text-xl mb-1 text-gray-900">Visit Our HQ</h4>
                                <p class="text-gray-500 font-light">Tech Hub Plaza, 4th Floor,<br>Electronic City, Bangalore, KA 560100</p>
                            </div>
                        </div>

                        <div class="flex items-start gap-6 p-6 rounded-[32px] hover:bg-orange-500/5 transition-all duration-300 border border-gray-50 hover:border-orange-500/20 group">
                            <div class="w-16 h-16 rounded-2xl bg-orange-500/10 flex items-center justify-center text-3xl group-hover:scale-110 transition-transform">📞</div>
                            <div>
                                <h4 class="font-black text-xl mb-1 text-gray-900">Direct Line</h4>
                                <p class="text-gray-500 font-light">+91 1800-ZIGO-TECH<br>Mon-Fri, 9am - 6pm IST</p>
                            </div>
                        </div>

                        <div class="flex items-start gap-6 p-6 rounded-[32px] hover:bg-orange-500/5 transition-all duration-300 border border-gray-50 hover:border-orange-500/20 group">
                            <div class="w-16 h-16 rounded-2xl bg-orange-500/10 flex items-center justify-center text-3xl group-hover:scale-110 transition-transform">📧</div>
                            <div>
                                <h4 class="font-black text-xl mb-1 text-gray-900">Email Support</h4>
                                <p class="text-gray-500 font-light">support@zigo.com<br>Response within 24 hours</p>
                            </div>
                        </div>
                    </div>

                    <div class="pt-10 border-t border-gray-100">
                        <h4 class="font-black mb-6 text-gray-900">Connect with us</h4>
                        <div class="flex gap-4">
                            <a href="#" class="social-icon-btn dark font-bold text-xs hover:text-white transition-colors">FB</a>
                            <a href="#" class="social-icon-btn dark font-bold text-xs hover:text-white transition-colors">TW</a>
                            <a href="#" class="social-icon-btn dark font-bold text-xs hover:text-white transition-colors">IG</a>
                        </div>
                    </div>
                </div>

                <div class="contact-form-card p-10 md:p-12 rounded-[40px] bg-white border border-gray-100 shadow-2xl relative">
                    <div class="absolute -top-4 -left-4 w-12 h-12 bg-orange-500 rounded-2xl flex items-center justify-center text-white text-xl shadow-lg">✉️</div>
                    <h3 class="text-2xl font-black mb-8 text-gray-900">Send a Message</h3>
                    <form class="space-y-6" onsubmit="event.preventDefault(); Swal.fire('Sent!', 'We will get back to you soon.', 'success')">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div class="form-group">
                                <label class="block text-xs font-bold uppercase tracking-wider mb-2 text-gray-400">Full Name</label>
                                <input type="text" placeholder="John Doe" required
                                    class="w-full p-4 rounded-xl bg-gray-50 border border-gray-100 outline-none focus:border-orange-500 transition-colors text-gray-900">
                            </div>
                            <div class="form-group">
                                <label class="block text-xs font-bold uppercase tracking-wider mb-2 text-gray-400">Email Address</label>
                                <input type="email" placeholder="john@example.com" required
                                    class="w-full p-4 rounded-xl bg-gray-50 border border-gray-100 outline-none focus:border-orange-500 transition-colors text-gray-900">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="block text-xs font-bold uppercase tracking-wider mb-2 text-gray-400">Subject</label>
                            <input type="text" placeholder="How can we help?" required
                                class="w-full p-4 rounded-xl bg-gray-50 border border-gray-100 outline-none focus:border-orange-500 transition-colors text-gray-900">
                        </div>
                        <div class="form-group">
                            <label class="block text-xs font-bold uppercase tracking-wider mb-2 text-gray-400">Message</label>
                            <textarea placeholder="Write your message here..." rows="5" required
                                class="w-full p-4 rounded-xl bg-gray-50 border border-gray-100 outline-none focus:border-orange-500 transition-colors text-gray-900"></textarea>
                        </div>
                        <button type="submit"
                            class="w-full py-5 bg-orange-500 text-white font-black rounded-2xl hover:bg-orange-600 transition-all transform hover:-translate-y-1 shadow-xl shadow-orange-500/20">
                            Send Message &rarr;
                        </button>
                    </form>
                </div>
            </div>
        </section>
    </main>

    <%- include('../../partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Scroll Reveal Animation
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) entry.target.classList.add('active');
            });
        }, { threshold: 0.1 });

        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
    </script>
</body>

</html>
