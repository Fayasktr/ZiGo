<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ZiGo | Secure Checkout</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="icon" type="image/png" href="/public/public/favicon.png">
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <style>
        :root {
            --primary-orange: #FF5A1F;
            --primary-orange-hover: #E44D18;
            --deep-black: #0F0F0F;
            --off-white: #F9F9F9;
            --dark-navy: #1E293B;
            --gray-light: #E2E8F0;
            --white: #FFFFFF;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }

        body {
            background-color: var(--off-white);
            color: var(--dark-navy);
            overflow-x: hidden;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* --- Checkout Container --- */
        .checkout-container {
            padding: 140px 5% 80px;
            max-width: 1400px;
            margin: 0 auto;
            flex: 1;
        }

        .checkout-grid {
            display: grid;
            grid-template-columns: 1fr 400px;
            gap: 4rem;
        }

        @media (max-width: 1024px) {
            .checkout-grid {
                grid-template-columns: 1fr;
            }
        }

        .checkout-section {
            background: white;
            border-radius: 32px;
            padding: 2.5rem;
            border: 1px solid var(--gray-light);
            margin-bottom: 2rem;
        }

        .section-title {
            font-size: 1.5rem;
            font-weight: 800;
            margin-bottom: 2rem;
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .section-title i {
            color: var(--primary-orange);
        }

        /* --- Forms --- */
        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
        }

        .input-group {
            margin-bottom: 1.5rem;
        }

        .input-group label {
            display: block;
            font-size: 0.85rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
            opacity: 0.6;
        }

        .input-group input,
        .input-group textarea {
            width: 100%;
            padding: 1rem;
            border-radius: 12px;
            border: 1px solid var(--gray-light);
            outline: none;
            transition: var(--transition);
            background: var(--off-white);
        }

        .input-group input:focus {
            border-color: var(--primary-orange);
            background: white;
        }

        .full-width {
            grid-column: span 2;
        }

        /* --- Saved Address --- */
        .saved-address-card {
            border: 2px solid var(--gray-light);
            border-radius: 16px;
            padding: 1.2rem;
            margin-bottom: 1rem;
            cursor: pointer;
            transition: var(--transition);
            position: relative;
        }

        .saved-address-card.selected {
            border-color: var(--primary-orange);
            background: rgba(255, 90, 31, 0.03);
        }

        .address-badge {
            position: absolute;
            top: 1rem;
            right: 1.2rem;
            background: var(--primary-orange);
            color: white;
            font-size: 0.65rem;
            padding: 2px 8px;
            border-radius: 100px;
            font-weight: 700;
        }

        /* --- Payment Methods --- */
        .payment-method {
            display: flex;
            align-items: center;
            gap: 1.5rem;
            padding: 1.5rem;
            border: 2px solid var(--gray-light);
            border-radius: 16px;
            margin-bottom: 1rem;
            cursor: pointer;
            transition: var(--transition);
        }

        .payment-method:hover {
            border-color: var(--gray-light);
            background: var(--off-white);
        }

        .payment-method.selected {
            border-color: var(--primary-orange);
            background: rgba(255, 90, 31, 0.03);
        }

        .method-icon {
            width: 50px;
            height: 50px;
            background: white;
            border-radius: 12px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 1.5rem;
            color: var(--dark-navy);
            border: 1px solid var(--gray-light);
        }

        /* --- Modal Popups --- */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(15, 15, 15, 0.8);
            backdrop-filter: blur(8px);
            z-index: 3000;
            display: none;
            justify-content: center;
            align-items: center;
            padding: 2rem;
        }

        #successModal, #errorModal {
            z-index: 4000;
        }

        .modal-card {
            background: white;
            max-width: 500px;
            width: 100%;
            border-radius: 32px;
            padding: 2.5rem 3rem;
            text-align: left;
            position: relative;
            animation: modalPop 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        @keyframes modalPop {
            from {
                transform: scale(0.9);
                opacity: 0;
            }

            to {
                transform: scale(1);
                opacity: 1;
            }
        }

        .modal-icon-circle {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 2.5rem;
            margin: 0 auto 2rem;
        }

        .success .modal-icon-circle {
            background: #E7F9F0;
            color: #2ED573;
        }

        .error .modal-icon-circle {
            background: #FFEEEE;
            color: #FF4757;
        }

        .modal-btn {
            width: 100%;
            padding: 1rem;
            border-radius: 12px;
            font-weight: 700;
            margin-top: 2rem;
            border: none;
            cursor: pointer;
        }

        .success .modal-btn {
            background: #2ED573;
            color: white;
        }

        .error .modal-btn {
            background: #FF4757;
            color: white;
        }

        .summary-mini {
            position: sticky;
            top: 120px;
            background: white;
            border-radius: 24px;
            padding: 2rem;
            border: 1px solid var(--gray-light);
        }

        .coupon-section {
            border: 1px dashed var(--gray-light);
            border-radius: 16px;
            padding: 1.25rem;
            margin-bottom: 2rem;
            background: var(--off-white);
        }

        .coupon-toggle {
            display: flex;
            align-items: center;
            justify-content: space-between;
            cursor: pointer;
            font-weight: 700;
            font-size: 0.9rem;
            color: var(--primary-orange);
        }

        .coupon-input-group {
            display: flex;
            gap: 0.75rem;
            margin-top: 1rem;
        }

        .coupon-input {
            flex: 1;
            padding: 0.75rem 1rem;
            border-radius: 10px;
            border: 1px solid var(--gray-light);
            font-size: 0.85rem;
            outline: none;
            background: white;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .apply-coupon-btn {
            background: var(--dark-navy);
            color: white;
            padding: 0.75rem 1.25rem;
            border-radius: 10px;
            font-weight: 700;
            font-size: 0.85rem;
            transition: var(--transition);
        }

        .apply-coupon-btn:hover {
            background: var(--primary-orange);
            transform: translateY(-2px);
        }

        /* --- Refined Address Selection --- */
        .select-address-field {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: white;
            border: 1px solid var(--gray-light);
            padding: 1.25rem 1.5rem;
            border-radius: 16px;
            margin-bottom: 2rem;
            transition: var(--transition);
        }

        .select-address-field:hover {
            border-color: var(--primary-orange);
        }

        .change-address-btn {
            background: var(--off-white);
            color: var(--primary-orange);
            font-weight: 700;
            font-size: 0.85rem;
            padding: 0.6rem 1.2rem;
            border-radius: 10px;
            border: 1px solid var(--gray-light);
            transition: var(--transition);
        }

        .change-address-btn:hover {
            background: var(--primary-orange);
            color: white;
            border-color: var(--primary-orange);
        }

        .add-address-link-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.75rem;
            background: white;
            color: var(--dark-navy);
            font-weight: 700;
            font-size: 0.9rem;
            padding: 1.25rem 1.5rem;
            border-radius: 16px;
            border: 1px dashed var(--gray-light);
            transition: var(--transition);
            white-space: nowrap;
            height: 100%;
        }

        .add-address-link-btn:hover {
            border-color: var(--primary-orange);
            color: var(--primary-orange);
            background: rgba(255, 90, 31, 0.02);
        }

        /* --- Address Modal Specific --- */
        .address-modal-content {
            text-align: left !important;
            max-height: 80vh;
            overflow-y: auto;
        }

        .modal-address-item {
            padding: 1.25rem;
            border: 1px solid var(--gray-light);
            border-radius: 16px;
            margin-bottom: 1rem;
            cursor: pointer;
            transition: var(--transition);
            position: relative;
        }

        .modal-address-item:hover {
            border-color: var(--primary-orange);
            background: var(--off-white);
        }

        .modal-address-item.active {
            border-color: var(--primary-orange);
            background: rgba(255, 90, 31, 0.03);
        }

        .modal-close-btn {
            position: absolute;
            top: 1.5rem;
            right: 1.5rem;
            font-size: 1.25rem;
            opacity: 0.4;
            cursor: pointer;
            transition: var(--transition);
            z-index: 10;
        }

        .modal-close-btn:hover {
            opacity: 1;
            color: var(--primary-orange);
        }

        /* --- Loading Spinner --- */
        .spinner {
            display: none;
            width: 20px;
            height: 20px;
            border: 3px solid rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            border-top-color: white;
            animation: spin 1s ease-in-out infinite;
            margin-right: 10px;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        #addAddressModal .modal-card,
        #addressModal .modal-card {
            max-width: 650px;
            padding: 2.5rem;
            max-height: 85vh;
            display: flex;
            flex-direction: column;
        }

        .address-modal-content {
            text-align: left !important;
            overflow-y: auto;
            scrollbar-width: thin;
            scrollbar-color: var(--primary-orange) transparent;
        }

        /* Custom Scrollbar for Chrome/Safari */
        .address-modal-content::-webkit-scrollbar {
            width: 5px;
        }

        .address-modal-content::-webkit-scrollbar-track {
            background: transparent;
            margin: 20px 0; /* Keeps scrollbar away from top/bottom curves */
        }

        .address-modal-content::-webkit-scrollbar-thumb {
            background-color: var(--primary-orange);
            border-radius: 20px;
        }

        #placeOrderBtn:disabled {
            opacity: 0.7;
            cursor: not-allowed;
        }

        #placeOrderBtn.loading .spinner {
            display: inline-block;
        }

        .error-message {
            color: #FF4757;
            font-size: 0.75rem;
            font-weight: 600;
            margin-top: 0.25rem;
            display: none;
        }

        .input-group.has-error input, 
        .input-group.has-error textarea, 
        .input-group.has-error select {
            border-color: #FF4757 !important;
            background: #FFF5F5 !important;
        }
    </style>
</head>

<body>
    <%- include('../../partials/headerMinimal') %>

        <main class="checkout-container">
            <h1 class="text-4xl font-extrabold mb-10">Checkout</h1>

            <div class="checkout-grid">
                <div class="checkout-main">
                    <!-- Address Section -->
                    <div class="checkout-section">
                        <h2 class="section-title"><i class="fas fa-map-marker-alt"></i> Shipping Address</h2>

                        <div class="flex flex-col md:flex-row gap-4 mb-8">
                            <div class="select-address-field flex-1 mb-0" id="selectedAddressDisplay">
                                <div class="flex items-center gap-4">
                                    <div class="w-12 h-12 bg-orange-100 text-orange-500 rounded-full flex items-center justify-center text-xl">
                                        <i class="fas fa-location-dot"></i>
                                    </div>
                                    <div class="text-left">
                                        <p class="font-bold text-sm" id="current_addr_name">
                                            <%= checkout.defaultAddress ? checkout.defaultAddress.userName : 'No Address Selected' %>
                                        </p>
                                        <p class="text-xs opacity-60" id="current_addr_text">
                                            <%= checkout.defaultAddress ? (checkout.defaultAddress.detailedAddress + ', ' + checkout.defaultAddress.city) : 'Please select a shipping address' %>
                                        </p>
                                    </div>
                                </div>
                                <button type="button" class="change-address-btn" onclick="openAddressModal()">
                                    <i class="fas fa-exchange-alt mr-2"></i> change Address
                                </button>
                            </div>
                            
                            <button type="button" onclick="openAddAddressModal()" class="add-address-link-btn">
                                <i class="fas fa-plus text-orange-500"></i>
                                <span>Add New Address</span>
                            </button>
                        </div>

                        <!-- Flash Message Alerts -->
                        <% if (locals.success && success && success.length > 0) { %>
                            <script>
                                window.addEventListener('DOMContentLoaded', () => {
                                    Swal.fire({
                                        icon: 'success',
                                        title: 'Success',
                                        text: '<%= success %>',
                                        confirmButtonColor: '#FF5A1F',
                                        timer: 3000
                                    });
                                });
                            </script>
                        <% } %>
                        <% if (locals.error && error && error.length > 0) { %>
                            <script>
                                window.addEventListener('DOMContentLoaded', () => {
                                    Swal.fire({
                                        icon: 'error',
                                        title: 'Oops...',
                                        text: '<%= error %>',
                                        confirmButtonColor: '#FF5A1F',
                                    });
                                });
                            </script>
                        <% } %>

                        <form class="form-grid" id="checkoutForm" action="/user/checkout/place" method="POST">
                            <input type="hidden" name="addressId" id="selectedAddressId"
                                value="<%= checkout.defaultAddress ? checkout.defaultAddress._id : '' %>">
                            <input type="hidden" name="paymentMethod" id="selectedPaymentMethod" value="cash">
                            
                            <!-- Support for Buy Now -->
                            <% if (typeof isBuyNow !== 'undefined' && isBuyNow && checkout.checkoutData.length > 0) { %>
                                <input type="hidden" name="productId" id="buyNowProductId" value="<%= checkout.checkoutData[0].productId %>">
                                <input type="hidden" name="variantId" id="buyNowVariantId" value="<%= checkout.checkoutData[0].variantId %>">
                            <% } else { %>
                                <input type="hidden" name="productId" id="buyNowProductId" value="">
                                <input type="hidden" name="variantId" id="buyNowVariantId" value="">
                            <% } %>

                            <div class="input-group">
                                <label>USERNAME</label>
                                <input type="text" id="display_name" readonly
                                    value="<%= checkout.defaultAddress ? checkout.defaultAddress.userName : '' %>">
                            </div>
                            <div class="input-group">
                                <label>MOBILE NUMBER</label>
                                <input type="text" id="display_phone" readonly
                                    value="<%= checkout.defaultAddress ? checkout.defaultAddress.phoneNumber : '' %>">
                            </div>
                            <div class="input-group full-width">
                                <label>STREET ADDRESS</label>
                                <input type="text" id="display_address" readonly
                                    value="<%= checkout.defaultAddress ? checkout.defaultAddress.detailedAddress : '' %>">
                            </div>
                            <div class="input-group">
                                <label>CITY</label>
                                <input type="text" id="display_city" readonly
                                    value="<%= checkout.defaultAddress ? checkout.defaultAddress.city : '' %>">
                            </div>
                            <div class="input-group">
                                <label>PINCODE / COUNTRY</label>
                                <input type="text" id="display_pincode" readonly
                                    value="<%= checkout.defaultAddress ? (checkout.defaultAddress.pincode + ' / ' + checkout.defaultAddress.country) : '' %>">
                            </div>
                        </form>
                    </div>


                    <!-- Payment Section -->
                    <div class="checkout-section">
                        <h2 class="section-title"><i class="fas fa-credit-card"></i> Payment Method</h2>

                        <div class="payment-method selected" onclick="selectPayment(this, 'cash')">
                            <div class="method-icon"><i class="fas fa-money-bill-wave"></i></div>
                            <div class="flex-1">
                                <p class="font-bold">Cash on Delivery</p>
                                <p class="text-xs opacity-50">Pay when you receive the product</p>
                            </div>
                            <i class="fas fa-check-circle text-orange-500 check-icon"></i>
                        </div>

                        <% 
                            const walletBalance = (locals.wallet && locals.wallet.balance) || 0;
                            const totalAmount = checkout.totals.total || 0;
                            const isWalletDisabled = walletBalance < totalAmount;
                            const onWalletSelect = isWalletDisabled ? '' : "selectPayment(this, 'wallet')";
                        %>
                        <div class="payment-method <%= isWalletDisabled ? 'opacity-50 cursor-not-allowed grayscale pointer-events-none' : '' %>" 
                             onclick="<%= onWalletSelect %>">
                            <div class="method-icon"><i class="fas fa-wallet"></i></div>
                            <div class="flex-1">
                                <p class="font-bold">My Wallet (Balance: ₹<%= walletBalance.toLocaleString('en-IN') %>)</p>
                                <p class="text-xs opacity-50"><%= isWalletDisabled ? 'Insufficient Balance' : 'Secure and fast checkout' %></p>
                            </div>
                            <i class="fas fa-check-circle text-orange-500 check-icon hidden"></i>
                        </div>

                        <div class="payment-method" onclick="selectPayment(this, 'razorpay')">
                            <div class="method-icon"><i class="fas fa-bolt"></i></div>
                            <div class="flex-1">
                                <p class="font-bold">Razorpay</p>
                                <p class="text-xs opacity-50">Cards, UPI, Netbanking</p>
                            </div>
                            <i class="fas fa-check-circle text-orange-500 check-icon hidden"></i>
                        </div>
                    </div>

                </div>

                <!-- Order Review Sidebar -->
                <aside>
                    <div class="summary-mini">
                        <h3 class="font-bold mb-6 text-xl">Order Review</h3>
                        <div class="space-y-4 mb-8 max-h-[300px] overflow-y-auto pr-2">
                            <% if (checkout.checkoutData && checkout.checkoutData.length> 0) { %>
                                <% checkout.checkoutData.forEach(item=> { %>
                                    <div class="flex justify-between text-sm items-start gap-4">
                                        <div class="flex-1">
                                            <p class="<%= item.isAvailable ? '' : 'text-red-500 line-through' %>">
                                                <%= item.productName %>
                                            </p>
                                            <p class="text-[10px] opacity-50">
                                                <%= item.quantity %> x ₹<%= item.price.toLocaleString('en-IN') %>
                                            </p>
                                            <% if (!item.isAvailable) { %>
                                                <p class="text-[9px] text-red-500 font-bold uppercase">Not Available</p>
                                                <% } %>
                                        </div>
                                        <span
                                            class="font-bold whitespace-nowrap <%= item.isAvailable ? '' : 'opacity-30' %>">₹
                                            <%= item.totalPrice.toLocaleString('en-IN') %></span>
                                    </div>
                                    <% }) %>
                                        <% } %>
                        </div>

                        <!-- Coupon Section -->
                        <div class="coupon-section">
                            <div class="coupon-toggle" onclick="toggleCoupon()">
                                <span><i class="fas fa-ticket-alt mr-2"></i> Have a coupon?</span>
                                <i class="fas fa-chevron-down text-xs opacity-40" id="couponChevron"></i>
                            </div>
                            <div id="couponInputCont" class="hidden">
                                <div class="coupon-input-group">
                                    <input type="text" class="coupon-input" placeholder="Enter Code">
                                    <button class="apply-coupon-btn">Apply</button>
                                </div>
                            </div>
                        </div>

                        <div class="border-t border-gray-100 pt-6 space-y-3">
                            <div class="flex justify-between text-sm opacity-60">
                                <span>SubTotal</span>
                                <span>₹<%= checkout.totals.subTotal.toLocaleString('en-IN') %></span>
                            </div>
                            <div class="flex justify-between text-sm opacity-60">
                                <span>Tax (18%)</span>
                                <span>₹<%= checkout.totals.tax.toLocaleString('en-IN') %></span>
                            </div>
                            <% if (checkout.totals.shipping > 0) { %>
                                <div class="flex justify-between text-sm opacity-60">
                                    <span>Shipping</span>
                                    <span>₹<%= checkout.totals.shipping.toLocaleString('en-IN') %></span>
                                </div>
                            <% } else { %>
                                <div class="flex justify-between text-sm text-green-600 font-bold">
                                    <span>Shipping</span>
                                    <span>FREE</span>
                                </div>
                            <% } %>
                            <p class="text-[9px] text-gray-400 mt-[-5px] mb-2 text-right opacity-60">Small order fee ₹40 for orders under ₹1,000</p>
                                        <div class="flex justify-between text-xl font-bold text-orange-500 mt-4">
                                            <span>Total</span>
                                            <span>₹<%= checkout.totals.total.toLocaleString('en-IN') %></span>
                                        </div>
                        </div>



                        <button class="w-full bg-orange-500 text-white font-bold py-4 rounded-xl mt-8 flex items-center justify-center" id="placeOrderBtn">
                            <div class="spinner"></div>
                            <span class="btn-text">Place Order Now</span>
                        </button>

                    </div>
                </aside>
            </div>
        </main>

        <!-- Success Modal Removed: Replaced by orderSuccess.ejs -->

        <!-- Failure Modal -->
        <div id="errorModal" class="modal-overlay">
            <div class="relative bg-white max-w-md w-full rounded-[40px] p-10 text-center shadow-2xl scale-110">
                <div
                    class="w-20 h-20 bg-red-100 text-red-500 rounded-full flex items-center justify-center text-4xl mx-auto mb-8">
                    <i class="fas fa-times"></i>
                </div>
                <h1 class="text-3xl font-black text-gray-900 mb-3">Payment Failed</h1>
                <p class="text-gray-500 mb-8 px-4">There was an issue processing your transaction. Please try again or
                    use a different method.</p>
                <div class="space-y-3">
                    <button onclick="document.getElementById('errorModal').style.display='none'"
                        class="block w-full bg-red-500 text-white font-bold py-4 rounded-2xl hover:bg-red-600 transition-all">
                        Try Again
                    </button>
                    <a href="/user/cart"
                        class="block w-full bg-gray-100 text-gray-900 font-bold py-4 rounded-2xl hover:bg-gray-200 transition-all">
                        Return to Cart
                    </a>
                </div>
            </div>
        </div>

        <!-- Add Address Modal -->
        <div id="addAddressModal" class="modal-overlay">
            <div class="modal-card address-modal-content">
                <i class="fas fa-times modal-close-btn" onclick="closeAddAddressModal()"></i>
                <h2 class="text-2xl font-black mb-6 text-center">Add New Shipping Address</h2>
                
                <form id="addAddressForm" class="form-grid">
                    <div class="input-group">
                        <label>FULL NAME</label>
                        <input type="text" name="userName" required placeholder="John Doe">
                        <span class="error-message" id="error_userName">Name is required</span>
                    </div>
                    <div class="input-group">
                        <label>ADDRESS TYPE</label>
                        <select name="type" class="w-full padding-1rem border-radius-12 border-gray-light bg-off-white outline-none focus-border-orange" 
                            style="width: 100%; padding: 1rem; border-radius: 12px; border: 1px solid var(--gray-light); background: var(--off-white); font-size: 0.9rem;">
                            <option value="Home">Home</option>
                            <option value="Work">Work</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="input-group full-width">
                        <label>DETAILED ADDRESS</label>
                        <textarea name="detailedAddress" rows="3" required placeholder="House No, Street, Landmark..."></textarea>
                        <span class="error-message" id="error_detailedAddress">Please provide a detailed address</span>
                    </div>
                    <div class="input-group">
                        <label>CITY</label>
                        <input type="text" name="city" required placeholder="City">
                        <span class="error-message" id="error_city">City is required</span>
                    </div>
                    <div class="input-group">
                        <label>STATE / PROVINCE</label>
                        <input type="text" name="state" placeholder="State">
                    </div>
                    <div class="input-group">
                        <label>PINCODE</label>
                        <input type="text" name="pincode" required placeholder="654321">
                        <span class="error-message" id="error_pincode">Valid pincode is required</span>
                    </div>
                    <div class="input-group">
                        <label>COUNTRY</label>
                        <input type="text" name="country" required value="India">
                    </div>
                    <div class="input-group">
                        <label>MOBILE NUMBER</label>
                        <input type="tel" name="phoneNumber" required placeholder="9876543210">
                        <span class="error-message" id="error_phoneNumber">Enter a valid 10-digit mobile number</span>
                    </div>
                    <div class="input-group">
                        <label>EMAIL (OPTIONAL)</label>
                        <input type="email" name="email" placeholder="email@example.com">
                    </div>
                    <div class="input-group full-width flex items-center gap-4 py-2 mt-2" style="background: var(--off-white); border-radius: 12px; padding-left: 1rem; border: 1px dashed var(--gray-light);">
                        <input type="checkbox" name="isDefault" id="isDefaultAddr" class="w-5 h-5 accent-orange-500 cursor-pointer">
                        <label for="isDefaultAddr" class="mb-0 text-sm font-semibold opacity-80 cursor-pointer select-none">Set as default shipping address</label>
                    </div>
                </form>

                <div class="flex gap-4 mt-6 justify-center">
                    <button type="button" onclick="closeAddAddressModal()" class="flex-1 bg-gray-100 text-gray-900 font-bold py-4 rounded-2xl hover:bg-gray-200 transition-all">
                        Cancel
                    </button>
                    <button type="button" onclick="saveNewAddress()" class="flex-1 bg-orange-500 text-white font-bold py-4 rounded-2xl hover:bg-orange-600 transition-all">
                        Save Address
                    </button>
                </div>
            </div>
        </div>

        <!-- Address Selection Modal -->
        <div id="addressModal" class="modal-overlay">
            <div class="modal-card address-modal-content">
                <i class="fas fa-times modal-close-btn" onclick="closeAddressModal()"></i>
                <h2 class="text-2xl font-black mb-6">Select Shipping Address</h2>
                
                <div class="space-y-3 mb-8">
                    <% if (checkout.addresses && checkout.addresses.length > 0) { %>
                        <% checkout.addresses.forEach(addr => { %>
                            <div class="modal-address-item <%= (checkout.defaultAddress && addr._id.toString() === checkout.defaultAddress._id.toString()) ? 'active' : '' %>"
                                 onclick="selectAddressFromModal(this, '<%= addr._id %>')"
                                 data-id="<%= addr._id %>"
                                 data-name="<%= addr.userName %>"
                                 data-phone="<%= addr.phoneNumber %>"
                                 data-address="<%= addr.detailedAddress %>"
                                 data-city="<%= addr.city %>"
                                 data-pincode="<%= addr.pincode %>"
                                 data-country="<%= addr.country %>">
                                <div class="flex justify-between items-start">
                                    <div>
                                        <p class="font-bold text-sm"><%= addr.userName %></p>
                                        <p class="text-xs opacity-60"><%= addr.detailedAddress %></p>
                                        <p class="text-xs opacity-60"><%= addr.city %>, <%= addr.country %> - <%= addr.pincode %></p>
                                    </div>
                                    <% if (addr.isDefault) { %>
                                        <span class="bg-orange-100 text-orange-500 text-[9px] font-black px-2 py-1 rounded-md flex items-center gap-1">
                                            <i class="fas fa-star text-[7px]"></i> DEFAULT
                                        </span>
                                    <% } %>
                                </div>
                            </div>
                        <% }) %>
                    <% } %>
                </div>

                <button type="button" onclick="closeAddressModal()" class="w-full bg-gray-100 text-gray-900 font-bold py-4 rounded-2xl hover:bg-gray-200 transition-all">
                    Cancel
                </button>
            </div>
        </div>

        <script>
            function openAddressModal() {
                document.getElementById('addressModal').style.display = 'flex';
            }

            function closeAddressModal() {
                document.getElementById('addressModal').style.display = 'none';
            }

            // Close modal if clicking outside the card
            window.onclick = function(event) {
                const modal = document.getElementById('addressModal');
                const addModal = document.getElementById('addAddressModal');
                const successModal = document.getElementById('successModal');
                const errorModal = document.getElementById('errorModal');
                
                if (modal && event.target == modal) closeAddressModal();
                if (addModal && event.target == addModal) closeAddAddressModal();
                if (successModal && event.target == successModal) successModal.style.display = 'none';
                if (errorModal && event.target == errorModal) errorModal.style.display = 'none';
            }

            function openAddAddressModal() {
                document.getElementById('addAddressModal').style.display = 'flex';
            }

            function closeAddAddressModal() {
                document.getElementById('addAddressModal').style.display = 'none';
                document.getElementById('addAddressForm').reset();
                document.querySelectorAll('.error-message').forEach(el => el.style.display = 'none');
                document.querySelectorAll('.input-group').forEach(el => el.classList.remove('has-error'));
            }

            async function saveNewAddress() {
                const form = document.getElementById('addAddressForm');
                const formData = new FormData(form);
                const data = Object.fromEntries(formData.entries());

                // Handle Checkbox separately
                data.isDefault = document.getElementById('isDefaultAddr').checked;

                // Reset Errors
                document.querySelectorAll('.error-message').forEach(el => el.style.display = 'none');
                document.querySelectorAll('.input-group').forEach(el => el.classList.remove('has-error'));

                let hasError = false;

                // Enhanced Inline Validation
                if (!data.userName.trim()) {
                    showFieldError('userName', 'Please enter your full name');
                    hasError = true;
                }
                if (!data.detailedAddress.trim()) {
                    showFieldError('detailedAddress', 'Address cannot be empty');
                    hasError = true;
                }
                if (!data.city.trim()) {
                    showFieldError('city', 'City is required');
                    hasError = true;
                }
                const pincodeRegex = /^\d{6}$/;
                if (!pincodeRegex.test(data.pincode)) {
                    showFieldError('pincode', 'Enter a valid 6-digit pincode');
                    hasError = true;
                }
                const phoneRegex = /^[6-9]\d{9}$/;
                if (!phoneRegex.test(data.phoneNumber)) {
                    showFieldError('phoneNumber', 'Enter a valid 10-digit mobile number');
                    hasError = true;
                }

                if (hasError) return;

                function showFieldError(fieldName, message) {
                    const errorEl = document.getElementById('error_' + fieldName);
                    if (errorEl) {
                        errorEl.innerText = message;
                        errorEl.style.display = 'block';
                        errorEl.closest('.input-group').classList.add('has-error');
                    }
                }

                try {
                    const response = await fetch('/user/addresses/add', {
                        method: 'POST',
                        headers: { 
                            'Content-Type': 'application/json',
                            'Accept': 'application/json'
                        },
                        body: JSON.stringify(data)
                    });

                    const result = await response.json();

                    if (result.success) {
                        const newAddress = result.address;
                        
                        // 1. Create and Add the new address to the address list modal
                        const addressList = document.querySelector('#addressModal .space-y-3');
                        const newAddrHTML = `
                            <div class="modal-address-item"
                                 onclick="selectAddressFromModal(this, '${newAddress._id}')"
                                 data-id="${newAddress._id}"
                                 data-name="${newAddress.userName}"
                                 data-phone="${newAddress.phoneNumber}"
                                 data-address="${newAddress.detailedAddress}"
                                 data-city="${newAddress.city}"
                                 data-pincode="${newAddress.pincode}"
                                 data-country="${newAddress.country}">
                                <div class="flex justify-between items-start">
                                    <div>
                                        <p class="font-bold text-sm">${newAddress.userName}</p>
                                        <p class="text-xs opacity-60">${newAddress.detailedAddress}</p>
                                        <p class="text-xs opacity-60">${newAddress.city}, ${newAddress.country} - ${newAddress.pincode}</p>
                                    </div>
                                    <span class="bg-blue-100 text-blue-500 text-[9px] font-black px-2 py-1 rounded-md flex items-center gap-1">
                                        NEW
                                    </span>
                                </div>
                            </div>
                        `;
                        
                        if (addressList) {
                            addressList.insertAdjacentHTML('afterbegin', newAddrHTML);
                        }

                        // 2. Automatically select this new address
                        const tempEl = document.createElement('div');
                        tempEl.innerHTML = newAddrHTML;
                        const newEl = tempEl.firstElementChild;
                        selectAddressFromModal(newEl, newAddress._id);

                        // 3. Close the Add Address modal
                        closeAddAddressModal();

                        Swal.fire({
                            icon: 'success',
                            title: 'Address Saved',
                            text: 'New shipping address has been added and selected.',
                            confirmButtonColor: '#FF5A1F',
                            timer: 2000
                        });
                    } else {
                        throw new Error(result.message || 'Failed to save address');
                    }
                } catch (error) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: error.message,
                        confirmButtonColor: '#FF5A1F'
                    });
                }
            }

            function selectAddressFromModal(element, addressId) {
                // Remove active class from all items
                document.querySelectorAll('.modal-address-item').forEach(item => item.classList.remove('active'));
                // Add to current
                element.classList.add('active');

                // Update hidden ID input
                document.getElementById('selectedAddressId').value = addressId;

                // Update display fields in the form
                document.getElementById('display_name').value = element.dataset.name;
                document.getElementById('display_phone').value = element.dataset.phone;
                document.getElementById('display_address').value = element.dataset.address;
                document.getElementById('display_city').value = element.dataset.city;
                document.getElementById('display_pincode').value = element.dataset.pincode + ' / ' + element.dataset.country;

                // Update main select field display
                document.getElementById('current_addr_name').textContent = element.dataset.name;
                document.getElementById('current_addr_text').textContent = element.dataset.address + ', ' + element.dataset.city;

                // Close modal
                closeAddressModal();
            }

            function selectPayment(element, method) {
                // Remove selected class from all payment methods
                document.querySelectorAll('.payment-method').forEach(m => {
                    m.classList.remove('selected');
                    const check = m.querySelector('.check-icon');
                    if (check) check.classList.add('hidden');
                });
                // Add to current
                element.classList.add('selected');
                const currentCheck = element.querySelector('.check-icon');
                if (currentCheck) currentCheck.classList.remove('hidden');

                // Update hidden input
                document.getElementById('selectedPaymentMethod').value = method;
            }

            document.getElementById('placeOrderBtn').addEventListener('click', async (e) => {
                const addressId = document.getElementById('selectedAddressId').value;
                const paymentMethod = document.getElementById('selectedPaymentMethod').value;
                const checkoutForm = document.getElementById('checkoutForm');

                if (!addressId) {
                    return Swal.fire({
                        icon: 'warning',
                        title: 'Selection Required',
                        text: 'Please select a shipping address before placing your order.',
                        confirmButtonColor: '#FF5A1F',
                    });
                }

                // Show loading state
                const placeOrderBtn = document.getElementById('placeOrderBtn');
                const btnText = placeOrderBtn.querySelector('.btn-text');
                placeOrderBtn.disabled = true;
                placeOrderBtn.classList.add('loading');
                btnText.textContent = 'Processing...';

                if (paymentMethod.toLowerCase() === 'razorpay') {
                    // RAZORPAY FLOW: Needs AJAX to get the Order ID first
                    try {
                        const response = await fetch('/user/checkout/place', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ 
                                addressId, 
                                paymentMethod: 'razorpay',
                                productId: document.getElementById('buyNowProductId').value,
                                variantId: document.getElementById('buyNowVariantId').value
                            })
                        });

                        const data = await response.json();
                        if (!data.success) throw new Error(data.message || 'Payment setup failed');

                        handleRazorpayModal(
                            data, 
                            addressId, 
                            document.getElementById('buyNowProductId').value, 
                            document.getElementById('buyNowVariantId').value
                        );
                    } catch (error) {
                        resetBtn();
                        Swal.fire({ icon: 'error', title: 'Payment Error', text: error.message });
                    }
                } else {
                    // COD / WALLET FLOW: Uses standard form submission because the backend redirects
                    checkoutForm.submit();
                }

                function resetBtn() {
                    placeOrderBtn.disabled = false;
                    placeOrderBtn.classList.remove('loading');
                    btnText.textContent = 'Place Order Now';
                }
            });

            function handleRazorpayModal(orderData, addressId, productId, variantId) {
                const options = {
                    key: orderData.key,
                    amount: orderData.amount,
                    currency: orderData.currency,
                    name: "ZiGo",
                    description: "Secure Order Payment",
                    order_id: orderData.orderId,
                    handler: async function (response) {
                        try {
                            const verifyRes = await fetch('/user/checkout/verify', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                    razorpay_order_id: response.razorpay_order_id,
                                    razorpay_payment_id: response.razorpay_payment_id,
                                    razorpay_signature: response.razorpay_signature,
                                    addressId,
                                    productId,
                                    variantId
                                })
                            });

                            const verifyResult = await verifyRes.json();
                            if (verifyResult.success) {
                                window.location.href = verifyResult.redirectUrl;
                            } else {
                                throw new Error(verifyResult.message || "Verification failed");
                            }
                        } catch (err) {
                            window.location.href = `/user/paymentFailed?orderId=${orderData.orderId}`;
                        }
                    },
                    modal: {
                        ondismiss: function() {
                            window.location.href = `/user/paymentFailed?orderId=${orderData.orderId}`;
                        }
                    },
                    prefill: {
                        name: document.getElementById('current_addr_name').textContent.trim(),
                        contact: document.getElementById('display_phone').value
                    },
                    theme: { color: "#FF5A1F" }
                };

                const rzp = new Razorpay(options);
                
                rzp.on('payment.failed', function (response) {
                    window.location.href = `/user/paymentFailed?orderId=${orderData.orderId}`;
                });

                rzp.open();
            }

            // Initialize Buy Now data if applicable
            window.addEventListener('DOMContentLoaded', () => {
                const urlParams = new URLSearchParams(window.location.search);
                if (urlParams.get('type') === 'buyNow') {
                    // Fields already populated by EJS if isBuyNow was true
                }
            });

            function toggleCoupon() {
                const cont = document.getElementById('couponInputCont');
                const chev = document.getElementById('couponChevron');
                cont.classList.toggle('hidden');
                chev.classList.toggle('rotate-180');
            }
        </script>


        <%- include('../../partials/footerMinimal') %>
</body>

</html>