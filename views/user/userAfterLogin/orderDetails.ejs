<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ZiGo | Order Details</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="icon" type="image/png" href="/public/public/favicon.png">
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        :root {
            --primary-orange: #FF5A1F;
            --primary-orange-hover: #E44D18;
            --deep-black: #0F0F0F;
            --off-white: #F9F9F9;
            --dark-navy: #1E293B;
            --gray-light: #E2E8F0;
            --white: #FFFFFF;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }

        body {
            background-color: var(--off-white);
            color: var(--dark-navy);
            overflow-x: hidden;
            line-height: 1.6;
        }

        /* --- Details Container --- */
        .details-container {
            padding: 140px 5% 80px;
            max-width: 1200px;
            margin: 0 auto;
        }

        .details-card {
            background: white;
            border-radius: 32px;
            overflow: hidden;
            border: 1px solid var(--gray-light);
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.02);
        }

        .details-header {
            background: var(--off-white);
            padding: 2.5rem;
            border-bottom: 1px solid var(--gray-light);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .order-status-badge {
            padding: 8px 20px;
            border-radius: 100px;
            font-weight: 700;
            font-size: 0.9rem;
        }

        .status-delivered { background: #E7F9F0; color: #2ED573; }
        .status-processing { background: #FFF4E5; color: #FF9F43; }
        .status-shipped { background: #E0F2FE; color: #0EA5E9; }
        .status-cancelled { background: #FFEEEE; color: #FF4757; }
        .status-returned { background: #F3E8FF; color: #A855F7; }
        .status-pending { background: #F1F5F9; color: #64748B; }
        
        .item-status-badge {
            padding: 2px 10px;
            border-radius: 100px;
            font-size: 0.65rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            display: inline-block;
            margin-top: 4px;
        }

        .details-body {
            padding: 2.5rem;
        }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 2rem;
            margin-bottom: 3rem;
        }

        .info-box h4 {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            opacity: 0.4;
            margin-bottom: 1rem;
            font-weight: 800;
        }

        /* --- Item Row --- */
        .order-item {
            display: flex;
            align-items: center;
            gap: 2rem;
            padding: 1.5rem 0;
            border-bottom: 1px solid var(--gray-light);
        }

        .order-item:last-of-type {
            border-bottom: none;
        }

        .item-thumb {
            width: 100px;
            height: 100px;
            background: var(--off-white);
            border-radius: 20px;
            padding: 1rem;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .item-thumb img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }

        /* --- Tracking Timeline --- */
        .timeline {
            margin-top: 3rem;
            padding-top: 3rem;
            border-top: 2px dashed var(--gray-light);
        }

        .timeline-step {
            display: flex;
            gap: 2rem;
            position: relative;
            padding-bottom: 2rem;
        }

        .timeline-step::before {
            content: '';
            position: absolute;
            left: 15px;
            top: 30px;
            width: 2px;
            height: calc(100% - 30px);
            background: var(--gray-light);
        }

        .timeline-step.completed::before {
            background: var(--primary-orange);
        }

        .timeline-step:last-child::before {
            display: none;
        }

        .step-icon {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: var(--gray-light);
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 0.8rem;
            z-index: 1;
            transition: var(--transition);
        }

        .step-icon.completed {
            background: var(--primary-orange);
            color: white;
        }

        .timeline-step.cancelled::before {
            background: #FF4757;
        }

        .step-icon.cancelled {
            background: #FF4757;
            color: white;
        }

        .text-cancelled {
            color: #FF4757 !important;
        }

        /* --- Action Buttons --- */
        .action-btn {
            padding: 1rem 2rem;
            border-radius: 16px;
            font-weight: 700;
            transition: var(--transition);
            display: flex;
            align-items: center;
            gap: 12px;
            cursor: pointer;
        }

        .btn-cancel {
            background: #FFF0F0;
            color: #FF4757;
            border: 1px solid #FFE0E0;
        }

        .btn-cancel:hover {
            background: #FF4757;
            color: white;
        }

        .btn-return {
            background: #F0F4FF;
            color: #3395FF;
            border: 1px solid #E0E8FF;
        }

        .btn-return:hover {
            background: #3395FF;
            color: white;
        }

        /* --- Rating System --- */
        .rating-stars {
            display: flex;
            gap: 10px;
            font-size: 2rem;
            color: var(--gray-light);
            cursor: pointer;
        }

        .rating-stars .fa-star.active {
            color: #FFD700;
        }

        /* --- Modals --- */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(8px);
            z-index: 2000;
            display: none;
            justify-content: center;
            align-items: center;
            padding: 2rem;
        }

        .modal-body {
            background: white;
            width: 100%;
            max-width: 500px;
            border-radius: 32px;
            padding: 3rem;
            position: relative;
            animation: modalPop 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        @keyframes modalPop {
            from {
                transform: scale(0.9);
                opacity: 0;
            }

            to {
                transform: scale(1);
                opacity: 1;
            }
        }

        textarea {
            width: 100%;
            padding: 1rem;
            border-radius: 16px;
            border: 1px solid var(--gray-light);
            background: var(--off-white);
            outline: none;
            resize: none;
            margin-top: 1rem;
        }
    </style>
</head>

