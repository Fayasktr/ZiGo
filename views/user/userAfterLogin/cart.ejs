        <script>
            async function updateQuantity(productId, change, _, variantId) {
                const quantitySpan = document.getElementById(`qtyValue-${variantId}`);
                const currentQty = parseInt(quantitySpan.innerText);

                if (currentQty >= 10 && change == 1) {
                    return Swal.fire({
                        icon: 'warning',
                        title: "Limit Reached",
                        text: "Maximum quantity is 10 per product",
                        timer: 2000,
                        position: "top",
                        toast: true,
                        showConfirmButton: false
                    });
                }

                if (currentQty <= 1 && change == -1) {
                    return Swal.fire({
                        icon: 'warning',
                        title: "Minimum Reached",
                        text: "Minimum quantity is 1",
                        timer: 2000,
                        position: "top",
                        toast: true,
                        showConfirmButton: false
                    });
                }

                try {
                    const response = await fetch(`/user/cart/changeQty/?productId=${productId}&change=${change}&variantId=${variantId}&currentQty=${currentQty}`, {
                        method: 'PATCH',
                        headers: { "Content-Type": "application/json" }
                    });

                    const result = await response.json();

                    if (response.ok && result.success) {
                        quantitySpan.innerText = result.update.quantity;
                        updateFrontendTotals();
                    } else {
                        throw new Error(result.message || "Failed to update quantity");
                    }
                } catch (error) {
                    Swal.fire({
                        icon: 'error',
                        title: "Update Failed",
                        text: error.message,
                        timer: 2500,
                    });
                }
            }

            function updateFrontendTotals() {
                let rawSubtotal = 0;
                let subtotal = 0;
                let totalItemsCount = 0;
                const items = document.querySelectorAll('.cart-item');
                
                items.forEach(item => {
                    const variantIdElement = item.querySelector('[id^="qtyValue-"]');
                    if (!variantIdElement) return;
                    
                    const variantId = variantIdElement.id.split('-')[1];
                    const isAvailable = item.getAttribute('data-available') === 'true';
                    const originalPrice = parseFloat(item.getAttribute('data-price'));
                    const finalPrice = parseFloat(item.getAttribute('data-final-price'));
                    const quantity = parseInt(variantIdElement.innerText);
                    
                    const itemTotal = finalPrice * quantity;
                    
                    const itemTotalElement = document.getElementById(`itemTotal-${variantId}`);
                    if (itemTotalElement) {
                        itemTotalElement.innerText = `₹${itemTotal.toLocaleString()}`;
                    }
                    
                    if (isAvailable) {
                        rawSubtotal += (originalPrice * quantity);
                        subtotal += itemTotal;
                        totalItemsCount += quantity;
                    }
                });

                if (window.updateCartCount) {
                    window.updateCartCount(totalItemsCount);
                }

                const savings = rawSubtotal - subtotal;
                const shippingCharge = (subtotal > 1000 || subtotal === 0) ? 0 : 40;
                const tax = subtotal * 0.18;
                const total = subtotal + tax + shippingCharge;

                document.getElementById('cartRawSubtotal').innerText = `₹${rawSubtotal.toLocaleString()}`;
                document.getElementById('cartOfferDiscount').innerText = `-₹${savings.toLocaleString()}`;
                document.getElementById('cartSubtotal').innerText = `₹${subtotal.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
                
                const shippingEl = document.getElementById('cartShipping');
                if (shippingCharge === 0) {
                    shippingEl.innerText = 'FREE';
                    shippingEl.classList.add('text-green-500');
                } else {
                    shippingEl.innerText = `₹${shippingCharge.toLocaleString()}`;
                    shippingEl.classList.remove('text-green-500');
                }

                document.getElementById('cartTax').innerText = `₹${tax.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
                document.getElementById('cartTotal').innerText = `₹${total.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;

                const btnCont = document.getElementById('checkoutBtnContainer');
                if (subtotal === 0 && btnCont) {
                    btnCont.innerHTML = `<button class="checkout-btn opacity-50 cursor-not-allowed w-full" disabled>Cart is Empty</button>`;
                }
            }

            async function removeFromCart(productId, variantId) {
                const result = await Swal.fire({
                    title: 'Are you sure?',
                    text: "You want to remove this item from cart?",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#FF5A1F',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Yes, remove it!'
                });
                if (result.isConfirmed) {
                    try {
                        const update = await fetch(`/user/cart/delete/${productId}?variantId=${variantId}`, {
                            method: "PATCH",
                            headers: { "Content-Type": "application/json" }
                        });

                        const res = await update.json();
                        if (update.ok && res.success) {
                            await Swal.fire({
                                title: "item removed",
                                icon: "success",
                                position: "top",
                                timer: 1500,
                                showConfirmButton: false
                            });
                            window.location.href = "/user/cart";
                        } else {
                            throw new Error("item not deleted");
                        }
                    } catch (error) {
                        Swal.fire({
                            icon: "error",
                            title: "item not removed",
                            text: "Could not delete the item from cart",
                            position: "top",
                            timer: 2000,
                        });
                    }
                }
            }
        </script>

        <!-- Flash Message Alerts -->
        <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
            <script>
                window.addEventListener('DOMContentLoaded', () => {
                    Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: '<%= success %>',
                        confirmButtonColor: '#FF5A1F',
                        timer: 3000
                    });
                });
            </script>
        <% } %>
        <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
            <script>
                window.addEventListener('DOMContentLoaded', () => {
                    Swal.fire({
                        icon: 'error',
                        title: 'Oops...',
                        text: '<%= error %>',
                        confirmButtonColor: '#FF5A1F',
                    });
                });
            </script>
        <% } %>
    </body>
</html>
