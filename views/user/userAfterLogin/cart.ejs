<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ZiGo | Your Shopping Cart</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="icon" type="image/png" href="/public/public/favicon.png">
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        :root {
            --primary-orange: #FF5A1F;
            --primary-orange-hover: #E44D18;
            --deep-black: #0F0F0F;
            --off-white: #F9F9F9;
            --dark-navy: #1E293B;
            --gray-light: #E2E8F0;
            --white: #FFFFFF;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }

        html,
        body {
            width: 100%;
            max-width: 100%;
            overflow-x: hidden;
            background-color: var(--off-white);
            color: var(--dark-navy);
            line-height: 1.6;
        }

        /* --- Cart Container --- */
        .cart-container {
            padding: 140px 5% 80px;
            max-width: 1400px;
            margin: 0 auto;
        }

        .cart-layout {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 380px;
            gap: 2.5rem;
            align-items: flex-start;
        }

        @media (max-width: 1200px) {
            .cart-layout {
                grid-template-columns: minmax(0, 1fr) 340px;
                gap: 1.8rem;
            }
        }

        @media (max-width: 1024px) {
            .cart-layout {
                grid-template-columns: 1fr;
            }
        }

        .cart-items {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
            min-width: 0;
        }

        .cart-item {
            background: white;
            border-radius: 24px;
            padding: 1.5rem;
            display: flex;
            align-items: center;
            gap: 2rem;
            border: 1px solid var(--gray-light);
            transition: var(--transition);
            position: relative;
        }

        .cart-item:hover {
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
            transform: translateY(-4px);
        }

        .item-unavailable {
            filter: grayscale(1) opacity(0.6);
        }

        .item-img {
            width: 120px;
            height: 120px;
            background: var(--off-white);
            border-radius: 16px;
            padding: 1rem;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
        }

        .item-img img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }

        .item-details {
            flex: 1;
        }

        .item-title {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--dark-navy);
            margin-bottom: 0.5rem;
            cursor: pointer;
        }

        .item-meta {
            font-size: 0.85rem;
            color: rgba(30, 41, 59, 0.6);
            display: flex;
            gap: 1.5rem;
            flex-wrap: wrap;
        }

        .qty-control {
            display: flex;
            align-items: center;
            gap: 1rem;
            background: var(--off-white);
            padding: 0.5rem 1rem;
            border-radius: 10px;
        }

        .qty-btn {
            background: none;
            border: none;
            font-weight: 700;
            cursor: pointer;
            color: var(--primary-orange);
            width: 24px;
            height: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition);
        }

        .qty-btn:hover {
            background: rgba(255, 90, 31, 0.1);
            border-radius: 50%;
        }

        .qty-btn:disabled {
            opacity: 0.3;
            cursor: not-allowed;
        }

        .item-price-block {
            text-align: right;
            min-width: 140px;
        }

        .item-price {
            font-size: 1.25rem;
            font-weight: 800;
            color: var(--dark-navy);
        }

        .remove-btn {
            color: #ff4757;
            background: rgba(255, 71, 87, 0.1);
            width: 36px;
            height: 36px;
            border-radius: 10px;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            transition: var(--transition);
            border: none;
        }

        .remove-btn:hover {
            background: #ff4757;
            color: white;
        }

        /* --- Summary Card --- */
        .summary-card {
            background: white;
            border-radius: 24px;
            padding: 2rem;
            border: 1px solid var(--gray-light);
            height: min-content;
            position: sticky;
            top: 108px;
        }

        .summary-title {
            font-size: 1.5rem;
            font-weight: 800;
            margin-bottom: 2rem;
            display: flex;
            justify-content: space-between;
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 1.2rem;
            font-size: 1rem;
            opacity: 0.8;
        }

        .summary-total {
            border-top: 2px dashed var(--gray-light);
            margin-top: 1.5rem;
            padding-top: 1.5rem;
            display: flex;
            justify-content: space-between;
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--primary-orange);
        }

        .checkout-btn {
            width: 100%;
            background: var(--primary-orange);
            color: white;
            padding: 1.2rem;
            border-radius: 14px;
            font-weight: 700;
            font-size: 1.1rem;
            margin-top: 2rem;
            border: none;
            cursor: pointer;
            transition: var(--transition);
            display: block;
            text-align: center;
        }

        .checkout-btn:hover {
            background: var(--primary-orange-hover);
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(255, 90, 31, 0.2);
        }

        .coupon-box {
            margin-top: 2rem;
            background: var(--off-white);
            padding: 1.2rem;
            border-radius: 16px;
        }

        .coupon-input {
            width: 100%;
            padding: 0.8rem 1rem;
            border-radius: 10px;
            border: 1px solid var(--gray-light);
            margin-bottom: 0.8rem;
            outline: none;
            transition: var(--transition);
        }

        .coupon-input:focus {
            border-color: var(--primary-orange);
        }

        .coupon-btn {
            width: 100%;
            padding: 0.8rem;
            background: var(--dark-navy);
            color: white;
            border-radius: 10px;
            font-weight: 600;
            border: none;
            cursor: pointer;
            transition: var(--transition);
        }

        .coupon-btn:hover {
            opacity: 0.9;
        }

        .item-actions {
            margin-left: auto;
        }

        @media (max-width: 1024px) {
            .summary-card {
                position: static;
                top: auto;
                margin-top: 1rem;
            }
        }

        @media (max-width: 768px) {
            .cart-container {
                padding: 94px 0.55rem 40px;
            }

            .cart-container > h1 {
                font-size: 1.55rem;
                margin-bottom: 0.8rem;
            }

            .cart-items {
                gap: 0.62rem;
            }

            .cart-item {
                display: grid;
                grid-template-columns: 78px minmax(0, 1fr) auto;
                gap: 0.62rem;
                padding: 0.68rem;
                border-radius: 14px;
                align-items: center;
            }

            .item-img {
                width: 78px;
                height: 78px;
                padding: 0.45rem;
                border-radius: 10px;
            }

            .item-details {
                min-width: 0;
            }

            .item-title {
                font-size: 0.84rem;
                line-height: 1.25;
                margin-bottom: 0.22rem;
            }

            .item-title .text-xs {
                font-size: 0.6rem !important;
                margin-left: 0 !important;
                display: block;
            }

            .item-meta {
                gap: 0.35rem;
                font-size: 0.65rem;
            }

            .item-actions {
                grid-column: auto;
                width: auto;
                min-width: 74px;
                margin-left: auto;
                display: flex;
                flex-direction: column;
                justify-content: center;
                align-items: flex-end;
                gap: 0.35rem;
            }

            .qty-control {
                padding: 0.26rem 0.44rem;
                gap: 0.3rem;
                border-radius: 8px;
            }

            .qty-btn {
                width: 18px;
                height: 18px;
                font-size: 0.82rem;
            }

            .qty-control [id^="qtyValue-"] {
                font-size: 0.8rem;
                width: 1.6rem;
            }

            .item-price-block {
                min-width: 0;
                text-align: right;
            }

            .item-price {
                font-size: 0.9rem;
                line-height: 1.1;
            }

            .remove-btn {
                width: 28px;
                height: 28px;
                margin-top: 0;
                margin-left: auto;
                border-radius: 8px;
                font-size: 0.72rem;
            }

            .price-line {
                margin-top: 0.35rem !important;
                gap: 0.3rem !important;
            }

            .price-line .text-lg {
                font-size: 0.86rem !important;
                line-height: 1.1;
            }

            .price-line .text-sm {
                font-size: 0.66rem !important;
                line-height: 1;
            }

            .price-line .text-\[10px\] {
                font-size: 0.52rem !important;
                padding: 0.12rem 0.3rem !important;
            }

            .summary-card {
                border-radius: 14px;
                padding: 0.78rem;
            }

            .summary-title {
                font-size: 1rem;
                margin-bottom: 0.75rem;
            }

            .summary-row {
                margin-bottom: 0.55rem;
                font-size: 0.78rem;
            }

            .summary-total {
                margin-top: 0.55rem;
                padding-top: 0.6rem;
                font-size: 1rem;
            }

            .checkout-btn {
                margin-top: 0.7rem;
                padding: 0.72rem;
                font-size: 0.82rem;
                border-radius: 10px;
            }
        }

        @media (max-width: 420px) {
            .cart-container {
                padding: 90px 0.45rem 34px;
            }

            .cart-item {
                grid-template-columns: 68px minmax(0, 1fr) auto;
                gap: 0.5rem;
                padding: 0.58rem;
            }

            .item-img {
                width: 68px;
                height: 68px;
            }

            .item-actions {
                min-width: 66px;
                align-items: flex-end;
            }

            .item-price-block {
                text-align: right;
            }

            .remove-btn {
                margin-left: auto;
            }
        }
    </style>
</head>

<body>
    <%- include('../../partials/header') %>

    <main class="cart-container">
        <h1 class="text-3xl md:text-5xl font-extrabold mb-8 md:mb-12">Shopping <span class="text-orange-500">Cart</span></h1>


            <div class="cart-layout">
                <!-- Product List -->
                <div class="cart-items">
                    <% if (typeof cart !=='undefined' && cart && cart.items && cart.items.length> 0) { %>
                        <% cart.items.forEach(item=> { %>
                            <% 
                                const hasProduct = !!item.product;
                                const cartVariant = item.matchedVariant; 
                                
                                let cartImg = '/public/landing/no-image.png';
                                if (cartVariant && cartVariant.images && cartVariant.images[0]) {
                                    cartImg = cartVariant.images[0];
                                } else if (hasProduct && item.product.variants && item.product.variants[0] && item.product.variants[0].images && item.product.variants[0].images[0]) {
                                    cartImg = item.product.variants[0].images[0];
                                }
                                
                                const currentPrice = cartVariant ? (cartVariant.price || 0) : 0; 
                                const itemTotal = currentPrice * item.quantity; 
                                const prodIdStr = hasProduct ? item.product._id.toString() : ''; 
                                const variantIdStr = item.variantId ? item.variantId.toString() : '';
                                const isAvailable = !!item.isAvailable;
                            %>
                            <div class="cart-item" 
                                 data-item-id="<%= item._id %>" 
                                 data-price="<%= cartVariant ? (cartVariant.price || 0) : 0 %>" 
                                 data-final-price="<%= item.finalPrice || currentPrice %>"
                                 data-available="<%= isAvailable %>">
                                <div class="item-img <%= !isAvailable ? 'item-unavailable' : '' %>" 
                                     <% if (hasProduct && isAvailable) { %> onclick="window.location.href='/productDetailse/<%= prodIdStr %>'" <% } %>>
                                    <img src="<%= cartImg %>" alt="<%= hasProduct ? item.product.productName : 'Product Unavailable' %>">
                                </div>
                                <div class="item-details">
                                    <h3 class="item-title" 
                                        <% if (hasProduct && isAvailable) { %> onclick="window.location.href='/productDetailse/<%= prodIdStr %>'" <% } %>>
                                        <%= hasProduct ? item.product.productName : 'This product is no longer available' %>
                                        <% if (cartVariant && cartVariant.attributes) { %>
                                            <span class="text-xs text-orange-500 font-bold ml-2">
                                                <% 
                                                    let attrValues = []; 
                                                    if (cartVariant.attributes instanceof Map) { 
                                                        attrValues = Array.from(cartVariant.attributes.values()); 
                                                    } else { 
                                                        attrValues = Object.values(cartVariant.attributes); 
                                                    }
                                                %>
                                                (<%= attrValues.join(' / ') %>)
                                            </span>
                                        <% } %>
                                    </h3>
                                    <div class="item-meta">
                                        <span>Brand: <%= (hasProduct && item.product.brand) ? item.product.brand : 'ZiGo' %></span>
                                        <span>Category: <%= (item.category) ? item.category.categoryName : 'N/A' %></span>
                                    </div>
                                    
                                    <div class="price-line flex items-center gap-2 mt-2 flex-wrap">
                                        <% if (item.offerDiscount > 0) { %>
                                            <span class="text-lg font-black text-[#0F0F0F]">₹<%= item.finalPrice.toLocaleString() %></span>
                                            <span class="text-sm text-gray-400 line-through">₹<%= currentPrice.toLocaleString() %></span>
                                            <span class="text-[10px] font-bold text-orange-500 bg-orange-50 px-2 py-0.5 rounded border border-orange-100 uppercase tracking-tighter">
                                                <%= Math.round((item.offerDiscount / currentPrice) * 100) %>% OFF
                                            </span>
                                        <% } else { %>
                                            <span class="text-lg font-black text-[#0F0F0F]">₹<%= currentPrice.toLocaleString() %></span>
                                        <% } %>
                                    </div>

                                    <% if (!isAvailable) { %>
                                        <span class="text-xs font-bold text-red-500 bg-red-50 px-3 py-1.5 rounded-full mt-2 inline-block">
                                            ⚠ <%= (cartVariant && cartVariant.stock <= 0) ? 'Out of Stock' : 'Currently Unavailable' %>
                                        </span>
                                    <% } %>
                                </div>
                                <div class="item-actions flex flex-col items-end gap-4">
                                    <div class="qty-control">
                                        <button class="qty-btn"
                                            <%= !isAvailable ? 'disabled' : '' %>
                                            onclick="updateQuantity('<%= prodIdStr %>', -1, '<%= item.quantity %>', '<%= variantIdStr %>')">-</button>
                                        <span class="font-bold w-10 text-center" id="qtyValue-<%= variantIdStr %>">
                                            <%= item.quantity %>
                                        </span>
                                        <button class="qty-btn" 
                                            <%= !isAvailable ? 'disabled' : '' %>
                                            onclick="updateQuantity('<%= prodIdStr %>', 1, '<%= item.quantity %>', '<%= variantIdStr %>')">+</button>
                                    </div>
                                    <div class="item-price-block">
                                        <p class="item-price" id="itemTotal-<%= variantIdStr %>">
                                            ₹<%= ((item.finalPrice || currentPrice) * item.quantity).toLocaleString() %>
                                        </p>
                                        <button class="remove-btn mt-2 ml-auto"
                                            onclick="removeFromCart('<%= prodIdStr %>', '<%= variantIdStr %>')">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="bg-white p-12 rounded-[32px] border border-dashed border-gray-300 text-center">
                            <div
                                class="w-20 h-20 bg-gray-50 rounded-full flex items-center justify-center mx-auto mb-6 text-gray-300">
                                <i class="fas fa-shopping-cart text-3xl"></i>
                            </div>
                            <h2 class="text-2xl font-bold mb-4">Your cart is empty</h2>
                            <p class="text-gray-500 mb-8">Looks like you haven't added anything to
                                your cart
                                yet.</p>
                            <a href="/shop"
                                class="bg-orange-500 text-white px-10 py-4 rounded-2xl font-bold hover:bg-orange-600 transition-all inline-block">
                                Start Shopping
                            </a>
                        </div>
                    <% } %>
            </div>

            <!-- Sidebar Summary -->
            <div class="summary-card">
                <h2 class="summary-title">Order Summary <span>(<%= (typeof cart !=='undefined' && cart ) ?
                            cart.items.length : 0 %>)</span></h2>

                <div class="space-y-4">
                    <div class="summary-row">
                        <span>Bag Total</span>
                        <% 
                            const rawSubtotal = cart && cart.items ? cart.items.reduce((acc, i) => acc + ( (i.matchedVariant ? i.matchedVariant.price : 0) * i.quantity), 0) : 0;
                        %>
                        <span class="font-bold" id="cartRawSubtotal">₹<%= rawSubtotal.toLocaleString() %></span>
                    </div>

                    <div class="summary-row text-orange-500 font-bold">
                        <span>Offer Savings</span>
                        <span id="cartOfferDiscount">-₹<%= (cart && cart.totalSavings ? cart.totalSavings : 0).toLocaleString() %></span>
                    </div>

                    <div class="summary-row border-t border-gray-100 pt-4">
                        <span>Subtotal</span>
                        <span class="font-bold" id="cartSubtotal">₹<%= (typeof cart !== 'undefined' && cart) ?
                                cart.totalPrice.toLocaleString() : '0.00' %></span>
                    </div>
                    <% 
                        let subtotal = (typeof cart !== 'undefined' && cart && cart.totalPrice) ? cart.totalPrice : 0;
                        let shippingCharge = (subtotal > 1000 || subtotal === 0) ? 0 : 40;
                        let tax = subtotal * 0.18;
                        let total = subtotal + tax + shippingCharge;
                    %>
                    <div class="summary-row">
                        <span>Estimated Shipping</span>
                        <span id="cartShipping" class="<%= shippingCharge === 0 ? 'text-green-500' : '' %> font-bold">
                            <%= shippingCharge === 0 ? 'FREE' : '₹' + shippingCharge.toLocaleString() %>
                        </span>
                    </div>
                    <p class="text-[10px] text-gray-400 mt-[-10px] mb-4">Free delivery on orders above ₹1,000. Else ₹40 applies.</p>
                    <div class="summary-row">
                        <span>Tax (GST 18%)</span>
                        <span class="font-bold" id="cartTax">₹<%= tax.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></span>
                    </div>


                    <div class="summary-total">
                        <span>Total</span>
                        <span id="cartTotal">₹<%= total.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></span>
                    </div>
                </div>

                <%
                    const hasOutOfStock = cart && cart.items.some(i => !i.isAvailable);
                %>

                <div id="checkoutBtnContainer">
                    <% if (!cart || cart.items.length === 0) { %>
                        <button class="checkout-btn opacity-50 cursor-not-allowed w-full" disabled>
                            Cart is Empty
                        </button>
                    <% } else if (hasOutOfStock) { %>
                        <button class="checkout-btn opacity-50 cursor-not-allowed w-full" disabled>
                            Fix Out-of-Stock Items First
                        </button>
                    <% } else { %>
                        <a href="/user/checkout" class="checkout-btn block text-center w-full">
                            Proceed to Checkout
                        </a>
                    <% } %>
                </div>

               
            </div>
            </main>


        <%- include('../../partials/footer') %>
            <script>
                async function updateQuantity(productId, change, _, variantId) {
                    const quantitySpan = document.getElementById(`qtyValue-${variantId}`);
                    const currentQty = parseInt(quantitySpan.innerText);

                    if (currentQty >= 10 && change == 1) {
                        return Swal.fire({
                            icon: 'warning',
                            title: "Limit Reached",
                            text: "Maximum quantity is 10 per product",
                            timer: 2000,
                            position: "top",
                            toast: true,
                            showConfirmButton: false
                        });
                    }

                    if (currentQty <= 1 && change == -1) {
                        return Swal.fire({
                            icon: 'warning',
                            title: "Minimum Reached",
                            text: "Minimum quantity is 1",
                            timer: 2000,
                            position: "top",
                            toast: true,
                            showConfirmButton: false
                        });
                    }

                    try {
                        const response = await fetch(`/user/cart/changeQty/?productId=${productId}&change=${change}&variantId=${variantId}&currentQty=${currentQty}`, {
                            method: 'PATCH',
                            headers: { "Content-Type": "application/json" }
                        });

                        const result = await response.json();

                        if (response.ok && result.success) {
                            quantitySpan.innerText = result.update.quantity;
                            
                            // Re-calculate calculations on frontend
                            updateFrontendTotals();
                        } else {
                            throw new Error(result.message || "Failed to update quantity");
                        }
                    } catch (error) {
                        Swal.fire({
                            icon: 'error',
                            title: "Update Failed",
                            text: error.message,
                            timer: 2500,
                        });
                    }
                }

                function updateFrontendTotals() {
                    let rawSubtotal = 0;
                    let subtotal = 0;
                    let totalItemsCount = 0;
                    const items = document.querySelectorAll('.cart-item');
                    
                    items.forEach(item => {
                        const variantId = item.querySelector('[id^="qtyValue-"]').id.split('-')[1];
                        const isAvailable = item.getAttribute('data-available') === 'true';
                        const originalPrice = parseFloat(item.getAttribute('data-price'));
                        const finalPrice = parseFloat(item.getAttribute('data-final-price'));
                        const quantity = parseInt(document.getElementById(`qtyValue-${variantId}`).innerText);
                        
                        const itemTotal = finalPrice * quantity;
                        
                        // Update item total display
                        const itemTotalElement = document.getElementById(`itemTotal-${variantId}`);
                        if (itemTotalElement) {
                            itemTotalElement.innerText = `₹${itemTotal.toLocaleString()}`;
                        }
                        
                        if (isAvailable) {
                            rawSubtotal += (originalPrice * quantity);
                            subtotal += itemTotal;
                            totalItemsCount += quantity;
                        }
                    });

                    // Update header cart badge
                    if (window.updateCartCount) {
                        window.updateCartCount(totalItemsCount);
                    }

                    const savings = rawSubtotal - subtotal;

                    // Dynamic Shipping Logic
                    const shippingCharge = (subtotal > 1000 || subtotal === 0) ? 0 : 40;
                    const tax = subtotal * 0.18;
                    const total = subtotal + tax + shippingCharge;

                    // Update summary display
                    document.getElementById('cartRawSubtotal').innerText = `₹${rawSubtotal.toLocaleString()}`;
                    document.getElementById('cartOfferDiscount').innerText = `-₹${savings.toLocaleString()}`;
                    document.getElementById('cartSubtotal').innerText = `₹${subtotal.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
                    
                    const shippingEl = document.getElementById('cartShipping');
                    if (shippingCharge === 0) {
                        shippingEl.innerText = 'FREE';
                        shippingEl.classList.add('text-green-500');
                    } else {
                        shippingEl.innerText = `₹${shippingCharge.toLocaleString()}`;
                        shippingEl.classList.remove('text-green-500');
                    }

