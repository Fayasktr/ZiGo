<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About ZiGo | Our Tech Journey</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="icon" type="image/png" href="/public/public/favicon.png">
    <style>
        :root {
            --primary-orange: #FF5A1F;
            --primary-orange-hover: #E44D18;
            --deep-black: #0F0F0F;
            --off-white: #F9F9F9;
            --dark-navy: #1E293B;
            --gray-light: #E2E8F0;
            --white: #FFFFFF;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }

        body {
            background-color: var(--off-white);
            color: var(--dark-navy);
            overflow-x: hidden;
            line-height: 1.6;
        }

        .light-theme {
            background-color: var(--white);
            color: var(--deep-black);
        }

        .reveal {
            opacity: 0;
            transform: translateY(30px);
            transition: all 0.8s ease-out;
        }

        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }
    </style>
</head>

<body>
    <%- include('../../partials/header') %>

    <main class="pt-24 md:pt-32">
        <!-- About Hero -->
        <section class="hero flex flex-col items-center text-center gap-6 py-20 md:py-32"
            style="background: linear-gradient(to bottom, #F8FAFC, #FFFFFF);">
            <div class="px-5">
                <span class="text-[#FF5A1F] font-bold tracking-widest uppercase text-sm mb-4 block">Our Story</span>
                <h1 class="text-4xl md:text-6xl lg:text-7xl font-extrabold max-w-4xl text-[#0F0F0F] leading-[1.1]">
                    Building the Future of 
                    <span class="text-[#FF5A1F]">Electronic Commerce.</span>
                </h1>
                <p class="max-w-2xl mx-auto mt-8 text-[#0F0F0F]/70 text-lg md:text-xl font-light">
                    From a local tech collective to a leading platform, ZiGo is redefining your relationship with technology.
                </p>
            </div>
        </section>

        <!-- Main About Content -->
        <section id="about" class="reveal py-20 bg-white">
            <div class="max-w-6xl mx-auto px-5 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
                <div class="about-visual relative">
                    <div class="w-full aspect-square bg-orange-500/5 rounded-[40px] overflow-hidden border border-orange-500/10 relative group shadow-2xl">
                        <img src="/public/landing/hero_premium.png" alt="ZiGo Tech Innovation"
                            class="w-full h-full object-cover transition-all duration-700 hover:scale-105">
                        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
                        <div class="absolute bottom-10 left-10">
                            <span class="text-white font-bold text-sm tracking-widest uppercase opacity-80">Innovation Hub</span>
                            <h3 class="text-3xl font-black text-white mt-2">Redefining Tech Since 2024</h3>
                        </div>
                    </div>
                    <div class="absolute -top-6 -right-6 w-32 h-32 bg-[#FF5A1F] rounded-3xl flex items-center justify-center p-6 shadow-2xl rotate-12 hidden md:flex">
                        <p class="text-white font-black text-center text-sm leading-tight">Top Rated Platform</p>
                    </div>
                </div>
                <div class="about-content">
                    <h2 class="text-4xl font-black mb-8 text-gray-900 tracking-tight">Who We Are</h2>
                    <p class="text-lg text-gray-600 mb-8 leading-relaxed font-light">
                        ZiGo isn't just another electronics store. We're a technology collective dedicated to bringing
                        premium, high-performance gadgets to everyone. Our mission is to bridge the gap between
                        cutting-edge innovation and accessible pricing.
                    </p>
                    <div class="grid grid-cols-2 gap-8 mb-10 bg-gray-50 p-8 rounded-3xl border border-gray-100">
                        <div>
                            <h4 class="text-4xl font-black text-[#FF5A1F] mb-1">50k+</h4>
                            <p class="text-xs font-bold uppercase tracking-wider text-gray-400">Global Downloads</p>
                        </div>
                        <div>
                            <h4 class="text-4xl font-black text-[#FF5A1F] mb-1">99%</h4>
                            <p class="text-xs font-bold uppercase tracking-wider text-gray-400">Satisfaction Rate</p>
                        </div>
                    </div>
                    <p class="text-gray-600 leading-relaxed font-light">
                        We believe technology should empower people. That's why we meticulously source every product in
                        our catalog, ensuring it meets our rigorous standards for quality, design, and usability.
                    </p>
                </div>
            </div>
        </section>

        <!-- Mission & Values -->
        <section class="py-24 bg-gray-50 border-y border-gray-100">
            <div class="max-w-6xl mx-auto px-5">
                <div class="section-header text-center mb-16">
                    <h2 class="text-4xl font-black mb-4">Our Values</h2>
                    <p class="text-gray-400 text-lg">The principles that drive us forward every day.</p>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <div class="p-10 rounded-[32px] bg-white border border-gray-100 hover:border-[#FF5A1F]/30 hover:shadow-2xl transition-all duration-500 group">
                        <div class="text-5xl mb-8 group-hover:scale-110 transition-transform duration-500">⚡</div>
                        <h3 class="text-2xl font-black mb-4">Speed</h3>
                        <p class="text-gray-500 font-light leading-relaxed">We move fast because technology doesn't wait. From order processing to delivery, we optimize for extreme efficiency.</p>
                    </div>
                    <div class="p-10 rounded-[32px] bg-white border border-gray-100 hover:border-[#FF5A1F]/30 hover:shadow-2xl transition-all duration-500 group">
                        <div class="text-5xl mb-8 group-hover:scale-110 transition-transform duration-500">💎</div>
                        <h3 class="text-2xl font-black mb-4">Quality</h3>
                        <p class="text-gray-500 font-light leading-relaxed">We don't compromise. Every product undergoes a multi-point professional inspection before it leaves our door.</p>
                    </div>
                    <div class="p-10 rounded-[32px] bg-white border border-gray-100 hover:border-[#FF5A1F]/30 hover:shadow-2xl transition-all duration-500 group">
                        <div class="text-5xl mb-8 group-hover:scale-110 transition-transform duration-500">🤝</div>
                        <h3 class="text-2xl font-black mb-4">Trust</h3>
                        <p class="text-gray-500 font-light leading-relaxed">Transparency is our core. We offer clear pricing, honest descriptions, and dedicated support for every member.</p>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <%- include('../../partials/footer') %>

    <script>
        // Scroll Reveal Animation
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) entry.target.classList.add('active');
            });
        }, { threshold: 0.1 });

        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
    </script>
</body>

</html>
