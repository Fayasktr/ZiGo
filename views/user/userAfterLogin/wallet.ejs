<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ZiGo | My Wallet</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="icon" type="image/png" href="/public/public/favicon.png">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        :root {
            --primary-orange: #FF5A1F;
            --primary-orange-hover: #E44D18;
            --deep-black: #0F0F0F;
            --off-white: #F9F9F9;
            --dark-navy: #1E293B;
            --gray-light: #E2E8F0;
            --white: #FFFFFF;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }

        body {
            background-color: var(--off-white);
            color: var(--dark-navy);
            overflow-x: hidden;
            line-height: 1.6;
        }

        /* --- Profile Container --- */
        .profile-container {
            padding: 140px 5% 80px;
            max-width: 1400px;
            margin: 0 auto;
        }

        .profile-layout {
            display: grid;
            grid-template-columns: 320px 1fr;
            gap: 3rem;
        }

        @media (max-width: 1024px) {
            .profile-layout {
                grid-template-columns: 1fr;
            }
        }

        /* --- Sidebar --- */
        .profile-sidebar {
            background: white;
            border-radius: 32px;
            padding: 2.5rem;
            border: 1px solid var(--gray-light);
            height: min-content;
            position: sticky;
            top: 120px;
        }

        .user-info {
            text-align: center;
            margin-bottom: 2.5rem;
            padding-bottom: 2rem;
            border-bottom: 1px solid var(--gray-light);
        }

        .user-avatar-large {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            border: 4px solid var(--primary-orange);
            margin: 0 auto 1.5rem;
            overflow: hidden;
            box-shadow: 0 10px 20px rgba(255, 90, 31, 0.15);
        }

        .user-avatar-large img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .user-name {
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--dark-navy);
        }

        .user-email {
            font-size: 0.9rem;
            opacity: 0.5;
        }

        .sidebar-nav {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 1.2rem;
            padding: 1.1rem 1.5rem;
            border-radius: 16px;
            text-decoration: none;
            color: var(--dark-navy);
            font-weight: 600;
            transition: var(--transition);
            cursor: pointer;
        }

        .sidebar-link i {
            font-size: 1.2rem;
            width: 24px;
            text-align: center;
            opacity: 0.4;
            transition: var(--transition);
        }

        .sidebar-link:hover {
            background: var(--off-white);
            color: var(--primary-orange);
        }

        .sidebar-link:hover i {
            opacity: 1;
            color: var(--primary-orange);
        }

        .sidebar-link.active {
            background: var(--primary-orange);
            color: white;
            box-shadow: 0 10px 20px rgba(255, 90, 31, 0.2);
        }

        .sidebar-link.active i {
            opacity: 1;
            color: white;
        }

        .logout-link {
            margin-top: 1rem;
            color: #ff4757;
        }

        .logout-link:hover {
            background: rgba(255, 71, 87, 0.1);
            color: #ff4757;
        }

        /* --- Content Panels --- */
        .panel-header {
            margin-bottom: 2.5rem;
        }

        .panel-title {
            font-size: 2.5rem;
            font-weight: 800;
            color: var(--dark-navy);
        }

        /* --- Wallet Card --- */
        .wallet-card {
            background: var(--deep-black);
            border-radius: 32px;
            padding: 3rem;
            color: white;
            position: relative;
            overflow: hidden;
            margin-bottom: 2.5rem;
        }

        .wallet-card::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -10%;
            width: 300px;
            height: 300px;
            background: var(--primary-orange);
            filter: blur(80px);
            opacity: 0.2;
            border-radius: 50%;
        }

        .wallet-balance-label {
            font-size: 0.9rem;
            opacity: 0.5;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 0.5rem;
            display: block;
        }

        .wallet-balance-amount {
            font-size: 3.5rem;
            font-weight: 800;
            color: var(--primary-orange);
        }

        /* --- Add Money Modal --- */
        .wallet-modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(8px);
            z-index: 2000;
            display: none;
            justify-content: center;
            align-items: center;
            padding: 1.5rem;
        }

        .wallet-modal {
            background: white;
            width: 100%;
            max-width: 450px;
            border-radius: 32px;
            padding: 2.5rem;
            position: relative;
            animation: modalPop 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        @keyframes modalPop {
            from {
                transform: scale(0.9);
                opacity: 0;
            }

            to {
                transform: scale(1);
                opacity: 1;
            }
        }

        .razorpay-badge {
            display: flex;
            align-items: center;
            gap: 8px;
            background: #F4F7FF;
            padding: 8px 16px;
            border-radius: 12px;
            font-size: 0.75rem;
            color: #2D3E50;
            font-weight: 700;
            margin-bottom: 2rem;
        }

        .amount-input-group {
            position: relative;
            margin-bottom: 2rem;
        }

        .amount-input-group span {
            position: absolute;
            left: 20px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 1.5rem;
            font-weight: 800;
            opacity: 0.3;
        }

        .amount-input {
            width: 100%;
            padding: 1.5rem 1.5rem 1.5rem 3.5rem;
            border-radius: 20px;
            border: 2px solid var(--gray-light);
            font-size: 1.5rem;
            font-weight: 800;
            outline: none;
            transition: var(--transition);
        }

        .amount-input:focus {
            border-color: #3395FF;
            box-shadow: 0 0 0 4px rgba(51, 149, 255, 0.1);
        }

        .quick-amounts {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            margin-bottom: 2rem;
        }

        .quick-btn {
            padding: 10px;
            border: 1px solid var(--gray-light);
            border-radius: 12px;
            font-size: 0.9rem;
            font-weight: 700;
            cursor: pointer;
            transition: var(--transition);
        }

        .quick-btn:hover {
            border-color: var(--primary-orange);
            color: var(--primary-orange);
            background: rgba(255, 90, 31, 0.05);
        }

        .razorpay-btn {
            width: 100%;
            background: #3395FF;
            color: white;
            padding: 1.2rem;
            border-radius: 16px;
            font-weight: 800;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            border: none;
            cursor: pointer;
            transition: 0.3s;
        }

        .razorpay-btn:hover {
            background: #217ADA;
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(51, 149, 255, 0.2);
        }
    </style>
</head>

<body>
    <%- include('../../partials/header') %>

    <main class="profile-container">
        <div class="profile-layout">
            <!-- Sidebar -->
            <aside class="profile-sidebar">
                <div class="user-info">
                    <div class="user-avatar-large">
                        <% if (user && user.profileImage) { %>
                            <img src="<%= user.profileImage %>" alt="User Avatar">
                        <% } else { %>
                            <img src="https://ui-avatars.com/api/?name=<%= user.userName %>&background=FF5A1F&color=fff" alt="User Avatar">
                        <% } %>
                    </div>
                    <h2 class="user-name"><%= user.userName %></h2>
                    <p class="user-email"><%= user.email %></p>
                </div>

                <nav class="sidebar-nav">
                    <a href="/user/profile" class="sidebar-link">
                        <i class="fas fa-th-large"></i> Overview
                    </a>
                    <a href="/user/orders" class="sidebar-link">
                        <i class="fas fa-shopping-bag"></i> Order History
                    </a>
                    <a href="/user/wallet" class="sidebar-link active">
                        <i class="fas fa-wallet"></i> My Wallet
                    </a>
                    <a href="/user/wishlist" class="sidebar-link">
                        <i class="fas fa-heart"></i> Wishlist
                    </a>
                    <a href="/user/addresses" class="sidebar-link">
                        <i class="fas fa-map-marker-alt"></i> Addresses
                    </a>
                    <a href="/user/cart" class="sidebar-link">
                        <i class="fas fa-shopping-cart"></i> My Cart
                    </a>
                    <a href="/logout" class="sidebar-link logout-link">
                        <i class="fas fa-sign-out-alt"></i> Logout
                    </a>
                </nav>
            </aside>

            <!-- Main Content Area -->
            <div class="profile-content">
                <!-- Wallet Panel -->
                <div id="wallet-panel">
                    <div class="panel-header">
                        <h1 class="panel-title">My <span class="text-orange-500">Wallet</span></h1>
                    </div>
                    <div class="wallet-card">
                        <span class="wallet-balance-label">Available Balance</span>
                        <h2 class="wallet-balance-amount">₹<%= wallet.balance.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></h2>
                        <div class="mt-8 flex gap-4">
                            <button onclick="openAddMoneyModal()"
                                class="bg-white text-black font-bold px-8 py-3 rounded-xl hover:scale-105 transition-all">Add
                                Money</button>
                        </div>
                    </div>

                    <h3 class="text-2xl font-extrabold mb-6">Transaction History</h3>
                    <div class="space-y-4">
                        <% if (wallet.transactions && wallet.transactions.length > 0) { %>
                            <% wallet.transactions.forEach(transaction => { %>
                                <div class="flex justify-between items-center p-6 bg-white rounded-2xl border border-gray-50 text-sm">
                                    <div class="flex items-center gap-4">
                                        <% if (transaction.type === 'credit') { %>
                                            <div class="w-10 h-10 rounded-full bg-green-50 text-green-500 flex items-center justify-center">
                                                <i class="fas fa-plus"></i>
                                            </div>
                                            <div>
                                                <b><%= transaction.description || "Credit" %></b>
                                                <p class="opacity-40"><%= new Date(transaction.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></p>
                                            </div>
                                        <% } else { %>
                                            <div class="w-10 h-10 rounded-full bg-red-50 text-red-500 flex items-center justify-center">
                                                <i class="fas fa-minus"></i>
                                            </div>
                                            <div>
                                                <b><%= transaction.description || "Payment" %></b>
                                                <p class="opacity-40"><%= new Date(transaction.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></p>
                                            </div>
                                        <% } %>
                                    </div>
                                    <span class="<%= transaction.type === 'credit' ? 'text-green-500' : 'text-red-500' %> font-bold">
                                        <%= transaction.type === 'credit' ? '+' : '-' %> ₹<%= parseFloat(transaction.amount).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                                    </span>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div class="text-center py-12 bg-white rounded-2xl border border-gray-50">
                                <p class="opacity-40 font-bold">No transactions found</p>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <%- include('../../partials/footer') %>

    <!-- Add Money Modal -->
    <div id="addMoneyModal" class="wallet-modal-overlay">
        <div class="wallet-modal">
            <button onclick="closeAddMoneyModal()" class="absolute top-6 right-6 text-gray-400 hover:text-black">
                <i class="fas fa-times text-xl"></i>
            </button>

            <h2 class="text-2xl font-black mb-1">Add Money</h2>
            <p class="text-sm opacity-50 mb-6">Top up your wallet instantly</p>

            <div class="razorpay-badge">
                <i class="fas fa-shield-alt text-blue-500"></i>
                Secured by Razorpay
            </div>

            <div class="amount-input-group">
                <span>₹</span>
                <input type="number" id="walletAmountInput" class="amount-input" placeholder="0.00" min="100">
            </div>

            <div class="quick-amounts">
                <button class="quick-btn" onclick="setAmount(500)">₹500</button>
                <button class="quick-btn" onclick="setAmount(1000)">₹1000</button>
                <button class="quick-btn" onclick="setAmount(2000)">₹2000</button>
            </div>

            <button class="razorpay-btn" onclick="processPayment()">
                <i class="fas fa-bolt"></i> Pay with Razorpay
            </button>

            <p class="text-[10px] text-center mt-6 uppercase tracking-widest opacity-40 font-bold">
                100% Safe • Instant Credit
            </p>
        </div>
    </div>

    <script>
        function openAddMoneyModal() {
            document.getElementById('addMoneyModal').style.display = 'flex';
        }

        function closeAddMoneyModal() {
            document.getElementById('addMoneyModal').style.display = 'none';
        }

        function setAmount(amt) {
            document.getElementById('walletAmountInput').value = amt;
        }

        function processPayment() {
            const amt = document.getElementById('walletAmountInput').value;
            if (!amt || amt < 1) {
                alert("Please enter a valid amount");
                return;
            }

            // Simulation of Razorpay
            const btn = document.querySelector('.razorpay-btn');
            const originalContent = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Securing Connection...';
            btn.disabled = true;

            setTimeout(() => {
                alert(`Redirecting to Razorpay for ₹${amt}...`);
                btn.innerHTML = originalContent;
                btn.disabled = false;
                closeAddMoneyModal();
            }, 1500);
        }
    </script>
</body>

</html>
