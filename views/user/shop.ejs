<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shop Tech | ZiGo Premium Electronics</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="icon" type="image/png" href="/public/public/favicon.png">
    <style>
        :root {
            --primary-orange: #FF5A1F;
            --primary-orange-hover: #E44D18;
            --deep-black: #0F0F0F;
            --off-white: #F9F9F9;
            --dark-navy: #1E293B;
            --gray-light: #E2E8F0;
            --white: #FFFFFF;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }

        html,
        body {
            width: 100%;
            max-width: 100%;
            background-color: var(--deep-black);
            color: var(--white);
            overflow-x: clip;
            line-height: 1.6;
        }

        /* --- Shop Section --- */
        .shop-container {
            padding: 130px 4% 72px;
            min-height: 100dvh;
        }

        .shop-layout {
            display: grid;
            grid-template-columns: minmax(250px, 290px) minmax(0, 1fr);
            gap: 2rem;
            max-width: 1440px;
            width: 100%;
            margin: 0 auto;
            align-items: start;
        }

        @media (max-width: 1280px) {
            .shop-layout {
                grid-template-columns: minmax(220px, 250px) minmax(0, 1fr);
                gap: 1.4rem;
            }
        }

        @media (max-width: 980px) {
            .shop-layout {
                grid-template-columns: 1fr;
                gap: 1rem;
            }
        }

        /* Filters Sidebar */
        .filters-sidebar {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            border-radius: 24px;
            padding: 1.5rem;
            border: 1px solid rgba(255, 255, 255, 0.1);
            height: min-content;
            position: sticky;
            top: 110px;
            max-height: calc(100dvh - 130px);
            overflow: auto;
            scrollbar-width: thin;
            scrollbar-color: rgba(255, 90, 31, 0.75) rgba(255, 255, 255, 0.08);
        }

        .filters-sidebar::-webkit-scrollbar {
            width: 9px;
        }

        .filters-sidebar::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.08);
            border-radius: 999px;
            border: 2px solid transparent;
            background-clip: content-box;
        }

        .filters-sidebar::-webkit-scrollbar-thumb {
            background: linear-gradient(180deg, #ff6f3f 0%, #ff5a1f 100%);
            border-radius: 999px;
            border: 2px solid rgba(15, 15, 15, 0.35);
        }

        .filters-sidebar::-webkit-scrollbar-thumb:hover {
            background: linear-gradient(180deg, #ff8258 0%, #ff5a1f 100%);
        }

        .filter-section {
            margin-bottom: 1.6rem;
        }

        .filter-section:last-child {
            margin-bottom: 0;
        }

        .filter-section h4 {
            font-size: 1.1rem;
            font-weight: 700;
            margin-bottom: 1.2rem;
            color: white;
            text-transform: uppercase;
            letter-spacing: 1px;
            opacity: 0.8;
        }

        .filter-list {
            list-style: none;
        }

        .filter-item {
            margin-bottom: 0.8rem;
        }

        .filter-item label {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-size: 0.95rem;
            color: rgba(255, 255, 255, 0.6);
            cursor: pointer;
            transition: var(--transition);
        }

        .filter-item label:hover {
            color: var(--primary-orange);
        }

        .filter-item input[type="radio"] {
            accent-color: var(--primary-orange);
            width: 18px;
            height: 18px;
            cursor: pointer;
        }

        /* Product Grid */
        .product-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 1.25rem;
            width: 100%;
        }

        .shop-content {
            min-width: 0;
        }

        .product-card {
            background: rgba(255, 255, 255, 0.03);
            border-radius: 18px;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.05);
            transition: var(--transition);
            position: relative;
            min-width: 0;
        }

        .product-card:hover {
            transform: translateY(-8px);
            border-color: var(--primary-orange);
            background: rgba(255, 255, 255, 0.05);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
        }

        .img-container {
            aspect-ratio: 1/1;
            background: rgba(255, 255, 255, 0.02);
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 1rem;
            position: relative;
        }

        .img-container img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            transition: var(--transition);
        }

        .product-card:hover .img-container img {
            transform: scale(1.1);
        }

        /* Wishlist/Love Button */
        .wishlist-heart-btn {
            position: absolute;
            top: 1.5rem;
            right: 1.5rem;
            z-index: 10;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(5px);
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            transition: var(--transition);
            border: 1px solid rgba(255, 255, 255, 0.1);
            cursor: pointer;
        }

        .wishlist-heart-btn:hover {
            background: white;
            transform: scale(1.1);
        }

        .wishlist-heart-btn.active {
            background: white;
            color: #ff4757;
        }

        .product-info {
            padding: 1rem;
        }

        .p-cat {
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            color: var(--primary-orange);
            letter-spacing: 1px;
            margin-bottom: 0.5rem;
        }

        .p-title {
            font-size: 0.98rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
            color: white;
            display: block;
        }

        .p-bottom {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 1rem;
        }

        .p-price {
            font-size: 1.05rem;
            font-weight: 800;
        }

        .p-mrp {
            font-size: 0.85rem;
            text-decoration: line-through;
            opacity: 0.4;
            display: block;
        }

        .p-discount-badge {
            font-size: 0.65rem;
            font-weight: 800;
            background: #ff4757;
            color: white;
            padding: 2px 6px;
            border-radius: 4px;
            margin-left: 6px;
            vertical-align: middle;
        }

        .add-cart-btn {
            width: 40px;
            height: 40px;
            background: var(--primary-orange);
            border-radius: 10px;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            transition: var(--transition);
            color: white;
        }

        .add-cart-btn:hover {
            transform: scale(1.1);
            background: var(--primary-orange-hover);
        }

        .search-container {
            flex: 1;
            max-width: 560px;
            display: flex;
            gap: 0.5rem;
            min-width: 0;
        }

        .shop-head {
            margin-bottom: 1.2rem;
        }

        .shop-title-block {
            display: flex;
            flex-direction: column;
            gap: 0.45rem;
        }

        .filter-toggle-btn {
            display: none;
            align-items: center;
            gap: 0.5rem;
            width: fit-content;
            padding: 0.55rem 0.8rem;
            border-radius: 10px;
            border: 1px solid rgba(255, 255, 255, 0.12);
            background: rgba(255, 255, 255, 0.04);
            color: #fff;
            font-size: 0.78rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            cursor: pointer;
        }

        .search-wrapper {
            position: relative;
            flex: 1;
        }

        .search-wrapper input {
            width: 100%;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            padding: 0.85rem 1.25rem 0.85rem 3rem;
            border-radius: 14px;
            color: white;
            font-size: 0.9rem;
            outline: none;
            transition: var(--transition);
            backdrop-filter: blur(10px);
        }

        .search-wrapper input:focus {
            border-color: var(--primary-orange);
            background: rgba(255, 255, 255, 0.08);
        }

        .search-wrapper i {
            position: absolute;
            left: 1.25rem;
            top: 50%;
            transform: translateY(-50%);
            color: rgba(255, 255, 255, 0.2);
            transition: var(--transition);
        }

        .search-wrapper input:focus~i {
            color: var(--primary-orange);
        }

        .btn-search-action {
            padding: 0.85rem 1.25rem;
            border-radius: 14px;
            font-weight: 700;
            font-size: 0.8rem;
            transition: var(--transition);
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            text-transform: uppercase;
        }

        .btn-search-submit {
            background: var(--primary-orange);
            color: white;
            border: none;
        }

        .btn-search-submit:hover {
            background: var(--primary-orange-hover);
            transform: translateY(-2px);
        }

        .btn-search-clear {
            background: rgba(255, 255, 255, 0.05);
            color: rgba(255, 255, 255, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .btn-search-clear:hover {
            background: rgba(255, 255, 255, 0.1);
            color: white;
        }

        .reveal {
            opacity: 0;
            transform: translateY(30px);
            transition: all 0.8s ease-out;
        }

        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }

        @media (max-width: 1280px) {
            .product-grid {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }
        }

        @media (max-width: 980px) {
            .shop-container {
                padding: 102px 0.9rem 60px;
            }

            .filters-sidebar {
                display: none;
                position: static;
                top: auto;
                padding: 1.1rem;
                border-radius: 16px;
                max-height: none;
            }

            .filters-sidebar.active {
                display: block;
            }

            .filter-toggle-btn {
                display: inline-flex;
            }

            .filter-section {
                margin-bottom: 1.2rem;
            }

            .filter-section h4 {
                font-size: 0.9rem;
                margin-bottom: 0.7rem;
            }

            .filter-item {
                margin-bottom: 0;
            }

            .filter-item label {
                font-size: 0.82rem;
            }

            .search-container {
                min-width: 100%;
                max-width: 100%;
            }

            .shop-head {
                flex-direction: column;
                align-items: stretch;
            }

            .product-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 0.8rem;
            }
        }

        @media (max-width: 767px) {
            .shop-content > .shop-head {
                margin-bottom: 1.2rem;
                gap: 0.9rem;
            }

            .shop-content h1 {
                font-size: 1.35rem;
            }

            .search-container {
                max-width: 100%;
                min-width: 100%;
                flex-wrap: wrap;
            }

            .search-wrapper {
                min-width: 100%;
            }

            .btn-search-action {
                font-size: 0.72rem;
                padding: 0.7rem 1rem;
                flex: 1;
                justify-content: center;
            }

            .product-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 0.65rem;
            }

            .product-card {
                border-radius: 14px;
            }

            .img-container {
                padding: 0.7rem;
            }

            .product-info {
                padding: 0.85rem;
            }

            .p-title {
                font-size: 0.9rem;
                min-height: 36px;
            }

            .p-price {
                font-size: 1rem;
            }

            .add-cart-btn {
                width: 34px;
                height: 34px;
                border-radius: 8px;
            }

            .wishlist-heart-btn {
                width: 30px;
                height: 30px;
                top: 0.6rem;
                right: 0.6rem;
                font-size: 0.75rem;
            }

            .filter-list {
                display: block;
            }
        }

        @media (max-width: 420px) {
            .product-grid {
                gap: 0.5rem;
            }

            .shop-container {
                padding-left: 0.55rem;
                padding-right: 0.55rem;
            }
        }
    </style>
</head>

<body>
    <% if (user) { %>
        <%- include('../partials/header') %>
            <% } else { %>
                <%- include('../partials/headerBeforeLogin') %>
                    <% } %>

                        <main class="shop-container">
                            <div class="shop-layout">
                                <!-- Sidebar -->
                                <aside class="filters-sidebar" id="filtersSidebar">
                                    <form id="filterForm">
                                        <div class="filter-section">
                                            <h4>Categories</h4>
                                            <ul class="filter-list">
                                                 <% categories.forEach(cat=> {
                                                    // Case-insensitive check to handle 'watch' vs 'Watch'
                                                    const selected = Array.isArray(selectedCategory) 
                                                        ? selectedCategory.some(c => String(c).toLowerCase() === String(cat.categoryName).toLowerCase())
                                                        : (String(selectedCategory).toLowerCase() === String(cat.categoryName).toLowerCase());
                                                    %>
                                                    <li class="filter-item">
                                                        <label style="text-transform: capitalize;">
                                                            <input type="checkbox" name="category"
                                                                value="<%= cat.categoryName %>" <%= selected ? 'checked' : '' %>
                                                                onchange="submitFilters()">
                                                            <%= cat.categoryName %>
                                                        </label>
                                                    </li>
                                                    <% }) %>
                                            </ul>
                                        </div>

                                        <div class="filter-section">
                                            <h4>Price Range</h4>
                                            <ul class="filter-list">
                                                <li class="filter-item">
                                                    <label><input type="radio" name="price" value="" <%=!selectedPrice
                                                            ? 'checked' : '' %> onchange="submitFilters()"> Any
                                                        Price</label>
                                                </li>
                                                <li class="filter-item">
                                                    <label><input type="radio" name="price" value="0-10000"
                                                            <%=selectedPrice==='0-10000' ? 'checked' : '' %>
                                                        onchange="submitFilters()"> Under ₹10,000</label>
                                                </li>
                                                <li class="filter-item">
                                                    <label><input type="radio" name="price" value="10000-50000"
                                                            <%=selectedPrice==='10000-50000' ? 'checked' : '' %>
                                                        onchange="submitFilters()"> ₹10,000 - ₹50,000</label>
                                                </li>
                                                <li class="filter-item">
                                                    <label><input type="radio" name="price" value="50000-100000"
                                                            <%=selectedPrice==='50000-100000' ? 'checked' : '' %>
                                                        onchange="submitFilters()"> ₹50,000 - ₹1,00,000</label>
                                                </li>
                                                <li class="filter-item">
                                                    <label><input type="radio" name="price" value="100000-plus"
                                                            <%=selectedPrice==='100000-plus' ? 'checked' : '' %>
                                                        onchange="submitFilters()"> Above ₹1,00,000</label>
                                                </li>
                                            </ul>
                                        </div>
                                    </form>
                                </aside>

                                <!-- Main Content -->
                                <div class="shop-content">
                                    <div class="shop-head flex justify-between items-center mb-12 flex-wrap gap-6">
                                        <div class="shop-title-block">
                                            <p class="text-orange-500 font-bold uppercase tracking-[4px] text-xs mb-1">
                                                Explore</p>
                                            <h1 class="text-3xl font-extrabold">ZiGo <span
                                                    class="text-orange-500">Premium Tech</span></h1>
                                            <button type="button" id="filterToggleBtn" class="filter-toggle-btn">
                                                <i class="fas fa-sliders-h"></i>
                                                Filters
                                            </button>
                                        </div>

                                        <div class="search-container">
                                            <div class="search-wrapper">
                                                <input type="text" placeholder="Search..." id="shopSearchInput"
                                                    value="<%= search %>">
                                                <i class="fas fa-search"></i>
                                            </div>
                                            <button onclick="handleSearch()"
                                                class="btn-search-action btn-search-submit">
                                                Search
                                            </button>
                                            <button onclick="clearSearch()" class="btn-search-action btn-search-clear">
                                                <i class="fas fa-redo"></i>
                                            </button>
                                        </div>
                                    </div>

                                    <% if (products && products.length> 0) { %>
                                        <div class="product-grid">
                                            <% products.forEach((product, index)=> { %>
                                                <div class="product-card group reveal active" data-id="<%=product._id%>"
                                                    data-variant-id="<%= (product.variants && product.variants[0]) ? product.variants[0]._id : '' %>">

                                                    <div
                                                        class="img-container relative aspect-square overflow-hidden bg-[#0F0F0F]">
                                                        <% const listedVariants=product.variants.filter(v=> v.isListed
                                                            !== false);
                                                            const displayVariant = listedVariants.length > 0 ?
                                                            listedVariants[0] : (product.variants[0] || {});
                                                            const firstVariantId = displayVariant._id ?
                                                            displayVariant._id.toString() : "";
                                                            const isWishlisted = userWishlist &&
                                                            userWishlist.includes(firstVariantId);
                                                            const prodImg = (displayVariant.images &&
                                                            displayVariant.images[0]) ? displayVariant.images[0] :
                                                            '/public/landing/no-image.png';
                                                            %>

                                                            <!-- Wishlist Button -->
                                                            <button
                                                                class="wishlist-heart-btn <%= isWishlisted ? 'active' : '' %>"
                                                                title="Add to Wishlist"
                                                                data-variant-id="<%= firstVariantId %>">
                                                                <i class="fas fa-heart"></i>
                                                            </button>

                                                            <!-- Offer Badge -->
                                                            <% if (product.offer && product.offerDiscount> 0 &&
                                                                displayVariant.price > 0) { %>
                                                                <% const percentage=Math.round(((displayVariant.price -
                                                                    product.finalPrice) / displayVariant.price) * 100);
                                                                    %>
                                                                    <% if (percentage> 0) { %>
                                                                        <div
                                                                            class="absolute top-4 left-4 bg-[#FF5A1F] text-white text-[10px] font-black px-2.5 py-1 rounded-lg shadow-lg z-10 uppercase tracking-widest">
                                                                            <%= percentage %>% OFF
                                                                        </div>
                                                                        <% } %>
                                                                            <% } %>

                                                                                <img src="<%= prodImg %>"
                                                                                    alt="<%= product.productName %>"
                                                                                    class="w-full h-full object-contain transition-transform duration-700 group-hover:scale-110">
                                                    </div>

                                                    <div class="product-info">
                                                        <span
                                                            class="p-cat text-[10px] text-[#FF5A1F] font-bold uppercase tracking-[3px] mb-2 block opacity-80">
                                                            <%= product.category ? product.category.categoryName
                                                                : 'Tech' %>
                                                        </span>
                                                        <a href="/productDetailse/<%= product._id %>"
                                                            class="p-title text-white font-bold text-sm leading-snug line-clamp-2 min-h-[40px] hover:text-[#FF5A1F] transition-colors mb-4">
                                                            <%= product.productName %>
                                                        </a>

                                                        <div class="flex items-center justify-between gap-4 mt-auto">
                                                            <div class="flex flex-col">
                                                                <div class="flex items-center gap-2 flex-wrap">
                                                                    <% if (product.offer && product.offerDiscount> 0 &&
                                                                        displayVariant.price > 0) { %>
                                                                        <span
                                                                            class="text-xs text-white/50 line-through mb-1">₹
                                                                            <%= displayVariant.price.toLocaleString() %>
                                                                                </span>
                                                                        <span class="text-lg font-black text-white">₹<%=
                                                                                product.finalPrice.toLocaleString() %>
                                                                                </span>
                                                                        <% } else { %>
                                                                            <span
                                                                                class="text-lg font-black text-white">₹
                                                                                <%= displayVariant.price.toLocaleString()
                                                                                    %></span>
                                                                            <% } %>
                                                                </div>
                                                                <% if (displayVariant.stock <=0) { %>
                                                                    <span
                                                                        class="text-red-500 font-bold text-[10px] uppercase tracking-wider mt-1">Out
                                                                        of Stock</span>
                                                                    <% } %>
                                                            </div>

                                                            <button
                                                                class="add-cart-btn w-10 h-10 rounded-xl bg-[#FF5A1F] flex items-center justify-center text-white hover:bg-[#E44D18] hover:scale-110 transition-all shadow-lg shadow-[#FF5A1F]/20"
                                                                data-variant-id="<%= firstVariantId %>"
                                                                <%=displayVariant.stock <=0
                                                                ? 'disabled style="opacity:0.5; cursor:not-allowed;"'
                                                                : '' %>>
                                                                <i class="fas fa-plus text-sm"></i>
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                                <% }) %>
                                        </div>

                                        <div class="mt-12">
                                            <%- include('../partials/admin/pagination') %>
                                        </div>
                                        <% } else { %>
                                            <div class="flex flex-col items-center justify-center py-20 opacity-40">
                                                <i class="fas fa-search fa-3x mb-4"></i>
                                                <p class="text-xl font-bold">No products found matching your criteria.
                                                </p>
                                                <button onclick="clearSearch()"
                                                    class="text-orange-500 font-bold mt-4 hover:underline">Clear all
                                                    filters</button>
                                            </div>
                                            <% } %>
                                </div>
                            </div>
                        </main>

                        <%- include('../partials/footer') %>

                            <script>
                                let productGrid = document.querySelector(".product-grid")
                                function submitFilters() {
                                    const form = document.getElementById('filterForm');
                                    const formData = new FormData(form);
                                    const params = new URLSearchParams(window.location.search);

                                    // Remove existing array-like params to prevent duplication
                                    params.delete('category');

                                    // Update params from form
                                    for (const [key, value] of formData.entries()) {
                                        if (value) {
                                            if (key === 'category') {
                                                params.append(key, value);
                                            } else {
                                                params.set(key, value);
                                            }
                                        } else {
                                            params.delete(key);
                                        }
                                    }

                                    params.set('page', '1'); // Reset to page 1 on filter
                                    window.location.href = `/shop?${params.toString()}`;
                                }

                                function handleSearch() {
                                    const query = document.getElementById('shopSearchInput').value.trim();
                                    const params = new URLSearchParams(window.location.search);
                                    if (query) params.set('search', query);
                                    else params.delete('search');

                                    params.set('page', '1');
                                    window.location.href = `/shop?${params.toString()}`;
                                }

                                function clearSearch() {
                                    window.location.href = '/shop';
                                }

                                document.getElementById('shopSearchInput').addEventListener('keypress', (e) => {
                                    if (e.key === 'Enter') handleSearch();
                                });

                                const filterToggleBtn = document.getElementById('filterToggleBtn');
                                const filtersSidebar = document.getElementById('filtersSidebar');

                                if (filterToggleBtn && filtersSidebar) {
                                    filterToggleBtn.addEventListener('click', () => {
                                        filtersSidebar.classList.toggle('active');
                                    });

                                    window.addEventListener('resize', () => {
                                        if (window.innerWidth > 980) {
                                            filtersSidebar.classList.remove('active');
                                        }
                                    });
                                }

                                //select product
                                if (productGrid) {
                                    productGrid.addEventListener("click", (event) => {
                                        const card = event.target.closest(".product-card");
                                        if (!card) return;
                                        const productId = card.dataset.id;
                                        const variantId = card.dataset.variantId;

                                        // Check IF they clicked the Wishlist Button
                                        const wishlistBtn = event.target.closest('.wishlist-heart-btn');
                                        if (wishlistBtn) {
                                            event.stopPropagation();
                                            const variantId = wishlistBtn.dataset.variantId;
                                            toggleWishlist(productId, variantId, wishlistBtn);
                                            return;
                                        }

                                        // Check IF they clicked the Cart Button
                                        const cartBtn = event.target.closest('.add-cart-btn');
                                        if (cartBtn) {
                                            event.stopPropagation();
                                            if (!cartBtn.hasAttribute('disabled')) {
                                                const variantId = cartBtn.dataset.variantId;
                                                addToCart(productId, variantId);
                                            }
                                            return;
                                        }

                                        // Otherwise redirect to product details
                                        window.location.href = `/productDetailse/${productId}`;
                                    });
                                }

                                async function toggleWishlist(productId, variantId, btnElement) {
                                    try {
                                        const update = await fetch(`/shop/wishlist/${productId}?variantId=${variantId}`, {
                                            method: "PATCH",
                                            headers: {
                                                "Content-Type": "application/json",
                                                "Accept": "application/json"
                                            }
                                        });

                                        if (update.status === 401) {
                                            Swal.fire({
                                                icon: 'warning',
                                                title: 'Login Required',
                                                text: 'You need to be logged in to manage your wishlist.',
                                                showCancelButton: true,
                                                confirmButtonColor: '#FF5A1F',
                                                confirmButtonText: 'Login Now'
                                            }).then((result) => {
                                                if (result.isConfirmed) {
                                                    window.location.href = '/login';
                                                }
                                            });
                                            return;
                                        }

                                        const result = await update.json();
                                        if (update.ok && result.success) {
                                            if (btnElement) {
                                                btnElement.classList.toggle('active');
                                            }
                                            if (result.wishlistCount !== undefined) {
                                                window.updateWishlistCount(result.wishlistCount);
                                            }
                                            Swal.fire({
                                                icon: "success",
                                                title: result.message,
                                                toast: true,
                                                position: "top",
                                                showConfirmButton: false,
                                                timer: 3000
                                            })

                                        } else {
                                            throw new Error(result.message || "Wishlist update failed");
                                        }
                                    } catch (error) {
                                        Swal.fire({
                                            icon: "error",
                                            title: "Action failed",
                                            text: error.message || "Could not change status",
                                            toast: true,
                                            position: 'top',
                                            showConfirmButton: false,
                                            timer: 3000
                                        });

                                    }

                                }

                                async function addToCart(productId, variantId) {
                                    try {
                                        console.log(productId)
                                        let update = await fetch(`/shop/cart/${productId}?variantId=${variantId}`, {
                                            method: "POST",
                                            headers: {
                                                "Content-Type": "application/json",
                                                "Accept": "application/json"
                                            }
                                        });

                                        if (update.status === 401) {
                                            Swal.fire({
                                                icon: 'warning',
                                                title: 'Login Required',
                                                text: 'You need to be logged in to manage your cart.',
                                                showCancelButton: true,
                                                confirmButtonColor: '#FF5A1F',
                                                confirmButtonText: 'Login Now'
                                            }).then((result) => {
                                                if (result.isConfirmed) {
                                                    window.location.href = '/login';
                                                }
                                            });
                                            return;
                                        }

                                        let result = await update.json();
                                        console.log("result", result);
                                        if (update.ok && result.success) {
                                            Swal.fire({
                                                icon: "success",
                                                title: result.message,
                                                toast: true,
                                                position: "top",
                                                showConfirmButton: false,
                                                timer: 3000
                                            });
                                            if (result.cartCount !== undefined) {
                                                window.updateCartCount(result.cartCount);
                                            }
                                        } else {
                                            throw new Error(result.message || "Could not add to cart");
                                        }
                                    } catch (error) {
                                        Swal.fire({
                                            icon: "error",
                                            title: "Action failed",
                                            text: error.message || "Could not add to cart",
                                            toast: true,
                                            position: 'top',
                                            showConfirmButton: false,
                                            timer: 3000
                                        });
                                    }
                                }

                                // Handle scroll reveal
                                window.addEventListener('scroll', () => {
                                    document.querySelectorAll('.reveal').forEach(el => {
                                        if (el.getBoundingClientRect().top < window.innerHeight - 50) el.classList.add('active');
                                    });
                                });
                            </script>
</body>

</html>

