<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ZiGo | Fast Tech. Smart Prices.</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="icon" type="image/png" href="/public/public/favicon.png">
    <style>
        :root {
            --primary-orange: #FF5A1F;
            --primary-orange-hover: #E44D18;
            --deep-black: #0F0F0F;
            --off-white: #F9F9F9;
            --dark-navy: #1E293B;
            --gray-light: #E2E8F0;
            --white: #FFFFFF;
            --transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }

        html, body {
            max-width: 100%;
            overflow-x: clip;
            background-color: var(--off-white);
            color: var(--dark-navy);
        }

        /* --- Hero Section --- */
        .hero {
            min-height: 100dvh;
            background-color: var(--deep-black);
            background-image:
                radial-gradient(circle at 80% 20%, rgba(255, 90, 31, 0.12) 0%, transparent 40%),
                radial-gradient(circle at 20% 80%, rgba(255, 90, 31, 0.04) 0%, transparent 40%),
                linear-gradient(to bottom, transparent, rgba(15, 15, 15, 0.9));
            color: var(--white);
            position: relative;
            overflow: hidden;
            display: flex;
            align-items: center;
        }

        .hero::after {
            content: '';
            position: absolute;
            inset: 0;
            background: url('https://www.transparenttextures.com/patterns/stardust.png');
            opacity: 0.1;
            pointer-events: none;
        }

        .hero-content h1 span {
            color: var(--primary-orange);
            display: block;
            text-shadow: 0 0 30px rgba(255, 90, 31, 0.3);
        }

        .btn {
            padding: 1.1rem 2.5rem;
            border-radius: 14px;
            text-decoration: none;
            font-weight: 700;
            font-size: 1rem;
            transition: var(--transition);
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .btn-primary {
            background-color: var(--primary-orange);
            color: white;
            box-shadow: 0 8px 30px rgba(255, 90, 31, 0.3);
        }

        .btn-primary:hover {
            background-color: var(--primary-orange-hover);
            transform: translateY(-4px);
            box-shadow: 0 12px 40px rgba(255, 90, 31, 0.5);
        }

        .btn-secondary {
            background-color: rgba(255, 255, 255, 0.05);
            color: white;
            border: 1px solid rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
        }

        .btn-secondary:hover {
            background-color: rgba(255, 255, 255, 0.1);
            border-color: white;
            transform: translateY(-4px);
        }

        .hero-visual img {
            max-width: 100%;
            height: auto;
            border-radius: 40px;
            box-shadow: 0 25px 80px rgba(255, 90, 31, 0.3), 0 0 40px rgba(255, 90, 31, 0.1);
            animation: float 6s ease-in-out infinite;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-25px); }
        }

        /* --- Category Showcase --- */
        .category-card {
            background: white;
            border-radius: 32px;
            padding: 2.5rem;
            transition: var(--transition);
            border: 1px solid var(--gray-light);
            text-align: center;
        }

        .category-card:hover {
            transform: translateY(-12px);
            border-color: var(--primary-orange);
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.06);
        }

        .category-image {
            height: 180px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1.5rem;
        }

        .category-image img {
            max-height: 100%;
            transition: var(--transition);
        }

        .category-card:hover .category-image img {
            transform: scale(1.15) rotate(3deg);
        }

        /* --- Featured Products --- */
        .product-card {
            background: white;
            border-radius: 32px;
            overflow: hidden;
            border: 1px solid var(--gray-light);
            transition: var(--transition);
        }

        .product-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.1);
            border-color: rgba(255, 90, 31, 0.2);
        }

        .product-img-wrapper {
            height: 320px;
            background: #FDFDFD;
            padding: 3rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .product-img-wrapper img {
            max-height: 100%;
            transition: var(--transition);
        }

        .product-card:hover .product-img-wrapper img {
            transform: scale(1.1);
        }

        .add-to-cart-btn {
            width: 52px;
            height: 52px;
            background: var(--deep-black);
            color: white;
            border-radius: 16px;
            transition: var(--transition);
        }

        .add-to-cart-btn:hover {
            background: var(--primary-orange);
            transform: rotate(90deg);
        }

        /* --- Why ZiGo --- */
        .why-zigo {
            background: var(--deep-black);
            padding: 10rem 0;
            color: white;
            position: relative;
            overflow: hidden;
        }

        .why-zigo::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 80%;
            height: 80%;
            background: radial-gradient(circle, rgba(255, 90, 31, 0.05) 0%, transparent 70%);
            pointer-events: none;
        }

        .why-icon {
            font-size: 3.5rem;
            margin-bottom: 2rem;
            filter: drop-shadow(0 0 20px rgba(255, 90, 31, 0.4));
        }

        /* --- Animations --- */
        .reveal {
            opacity: 0;
            transform: translateY(40px);
            transition: all 1s cubic-bezier(0.2, 0.8, 0.2, 1);
        }

        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }

        /* --- Responsive Refinements --- */
        @media (max-width: 1024px) {
            .hero { padding-top: 120px; min-height: auto; }
            .hero-content h1 { font-size: 4.5rem; }
        }

        @media (max-width: 768px) {
            .hero-content h1 { font-size: 3.5rem; }
            .hero-btns { flex-direction: column; width: 100%; }
            .btn { width: 100%; }
        }

        @media (max-width: 480px) {
            .hero-content h1 { font-size: 2.75rem; }
            .category-card { padding: 1.5rem; }
            .category-image { height: 140px; }
        }
    </style>
</head>

<body>

    <%- include('../partials/headerBeforeLogin') %>

    <main>
        <!-- Hero Section -->
        <section class="hero overflow-hidden">
            <div class="max-w-7xl mx-auto px-6 py-20 w-full flex flex-col lg:flex-row items-center gap-16">
                <div class="hero-content flex-1 text-center lg:text-left z-10">
                    <h1 class="text-5xl md:text-7xl xl:text-8xl font-black leading-[1] mb-8 tracking-tighter">
                        Next-Gen Tech. <span>Smart Prices.</span>
                    </h1>
                    <p class="text-lg md:text-xl text-white/60 mb-12 max-w-xl mx-auto lg:mx-0 font-light leading-relaxed">
                        The ultimate destination for premium gadgets. iPhones, smart watches & audio gear — curated for those who don't compromise.
                    </p>
                    <div class="hero-btns flex flex-wrap gap-5 justify-center lg:justify-start">
                        <a href="/shop" class="btn btn-primary">Shop Now</a>
                        <a href="/shop" class="btn btn-secondary">Explore Collections</a>
                    </div>
                </div>
                <div class="hero-visual flex-1 w-full max-w-2xl z-10">
                    <img src="<%= locals.activeBanner ? activeBanner.image : '/public/landing/hero_premium.png' %>" 
                         alt="<%= locals.activeBanner ? activeBanner.name : 'Premium Tech Showcase' %>"
                         class="w-full">
                </div>
            </div>
        </section>

        <!-- Brands Strip -->
        <section class="py-12 bg-white border-b border-gray-100">
            <div class="max-w-7xl mx-auto px-6">
                <div class="flex flex-wrap justify-center md:justify-between items-center gap-10 opacity-30 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-700">
                    <span class="text-2xl font-black">APPLE</span>
                    <span class="text-2xl font-black">SAMSUNG</span>
                    <span class="text-2xl font-black">SONY</span>
                    <span class="text-2xl font-black">BOSE</span>
                    <span class="text-2xl font-black">ONEPLUS</span>
                </div>
            </div>
        </section>

        <!-- Category Showcase -->
        <section class="py-32 reveal">
            <div class="max-w-7xl mx-auto px-6">
                <div class="text-center mb-20">
                    <h2 class="text-4xl md:text-6xl font-black mb-6 tracking-tight">Shop by Category</h2>
                    <p class="text-gray-500 text-lg max-w-2xl mx-auto">Precision engineered tech, organized for your discovery.</p>
                </div>
                
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
                    <a href="/shop?category=Smartphones" class="category-card group">
                        <div class="category-image">
                            <img src="/public/landing/smartphone.png" alt="Smartphones">
                        </div>
                        <h3 class="text-xl font-bold group-hover:text-[#FF5A1F] transition-colors">Smartphones</h3>
                    </a>
                    
                    <a href="/shop?category=Smart%20Watches" class="category-card group">
                        <div class="category-image">
                            <img src="/public/landing/watch.png" alt="Smart Watches">
                        </div>
                        <h3 class="text-xl font-bold group-hover:text-[#FF5A1F] transition-colors">Smart Watches</h3>
                    </a>
                    
                    <a href="/shop?category=Headsets" class="category-card group">
                        <div class="category-image">
                            <img src="/public/landing/headset.png" alt="Headsets">
                        </div>
                        <h3 class="text-xl font-bold group-hover:text-[#FF5A1F] transition-colors">Headsets</h3>
                    </a>
                    
                    <a href="/shop?category=AirPods" class="category-card group">
                        <div class="category-image">
                            <img src="/public/landing/airpods.png" alt="AirPods">
                        </div>
                        <h3 class="text-xl font-bold group-hover:text-[#FF5A1F] transition-colors">AirPods</h3>
                    </a>
                </div>
            </div>
        </section>

        <!-- Featured Products -->
        <section class="py-32 bg-gray-50 reveal">
            <div class="max-w-7xl mx-auto px-6">
                <div class="flex flex-col md:flex-row justify-between items-end mb-20 gap-8">
                    <div class="max-w-xl text-center md:text-left">
                        <h2 class="text-4xl md:text-6xl font-black mb-6 tracking-tight">Trending Now</h2>
                        <p class="text-gray-500 text-lg">Handpicked premium tech selected by our curators for the ultimate experience.</p>
                    </div>
                    <a href="/shop" class="text-[#FF5A1F] font-bold text-lg flex items-center gap-3 hover:translate-x-2 transition-transform">
                        View All Products <i class="fas fa-arrow-right"></i>
                    </a>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
                    <% if (locals.showProducts && showProducts.length > 0) { %>
                        <% showProducts.forEach(product => { %>
                            <% if (product) { %>
                                <div class="product-card group relative">
                                    <a href="/productDetailse/<%= product._id %>">
                                        <div class="product-img-wrapper">
                                            <% const displayImg = (product.variants && product.variants[0] && product.variants[0].images && product.variants[0].images[0]) ? product.variants[0].images[0] : '/public/landing/no-image.png' %>
                                            <img src="<%= displayImg %>" alt="<%= product.productName %>">
                                        </div>
                                    </a>
                                    <div class="p-8">
                                        <% let catName = product.category ? (product.category.categoryName || 'Tech') : 'Premium' %>
                                        <span class="text-xs font-black uppercase tracking-[3px] text-[#FF5A1F] mb-3 block opacity-80"><%= catName %></span>
                                        <h3 class="text-2xl font-black mb-6 line-clamp-1"><%= product.productName || 'ZiGo Premium' %></h3>
                                        
                                        <div class="flex justify-between items-center mt-auto">
                                            <% let displayPrice = (product.variants && product.variants[0] && product.variants[0].price != null) ? product.variants[0].price.toLocaleString('en-IN') : '0' %>
                                            <div class="flex flex-col">
                                                <span class="text-xs text-gray-400 font-bold uppercase tracking-wider mb-1">Starting from</span>
                                                <p class="text-2xl font-black tracking-tight">₹<%= displayPrice %></p>
                                            </div>
                                            <button class="add-to-cart-btn flex items-center justify-center">
                                                <i class="fas fa-plus"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            <% } %>
                        <% }) %>
                    <% } else { %>
                        <div class="col-span-full py-32 text-center">
                            <div class="animate-pulse flex flex-col items-center">
                                <div class="w-16 h-16 bg-gray-200 rounded-full mb-6"></div>
                                <p class="text-xl font-bold text-gray-300">Curating trending products...</p>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>
        </section>

        <!-- Why ZiGo -->
        <section class="why-zigo reveal">
            <div class="max-w-7xl mx-auto px-6">
                <div class="text-center mb-20">
                    <h2 class="text-4xl md:text-6xl font-black mb-6 tracking-tight">The ZiGo Difference</h2>
                    <p class="text-white/50 text-lg max-w-2xl mx-auto">Beyond the hardware, it's about a seamless tech lifestyle.</p>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-3 gap-20">
                    <div class="text-center">
                        <div class="why-icon">⚡</div>
                        <h3 class="text-2xl font-bold mb-4">Insane Delivery Speed</h3>
                        <p class="text-white/60 leading-relaxed">Our optimized logistics network means your new gear reaches you faster than you can find a charger.</p>
                    </div>
                    
                    <div class="text-center">
                        <div class="why-icon">🛡️</div>
                        <h3 class="text-2xl font-bold mb-4">Certified Quality</h3>
                        <p class="text-white/60 leading-relaxed">Every device undergoes a 50-point inspection in our warehouse before it gets the ZiGo seal of approval.</p>
                    </div>
                    
                    <div class="text-center">
                        <div class="why-icon">💎</div>
                        <h3 class="text-2xl font-bold mb-4">Curated Selection</h3>
                        <p class="text-white/60 leading-relaxed">We don't sell infinite clutter. We only stock the gear that we actually use and love ourselves.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Newsletter -->
        <section class="py-32 bg-[#FF5A1F]">
            <div class="max-w-4xl mx-auto px-6 text-center">
                <h2 class="text-4xl md:text-6xl font-black text-white mb-8 tracking-tight">Stay Ahead. Join the List.</h2>
                <p class="text-white/80 text-lg mb-12">Get first dibs on new drops and exclusive member-only pricing.</p>
                <div class="flex flex-col sm:flex-row gap-4">
                    <input type="email" placeholder="Enter your email" class="flex-1 px-8 py-5 rounded-2xl outline-none text-lg font-medium">
                    <button class="bg-black text-white px-10 py-5 rounded-2xl font-black text-lg hover:bg-gray-900 transition-colors">Subscribe</button>
                </div>
            </div>
        </section>
    </main>

    <%- include('../partials/footer') %>

    <script>
        // Scroll Reveal
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) entry.target.classList.add('active');
            });
        }, { threshold: 0.1 });

        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
    </script>
</body>

</html>
